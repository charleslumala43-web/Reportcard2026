}

async function renderTeacherList(){
  const teachers=await idbGetAll('teachers');
  const el=document.getElementById('teacherList');if(!el)return;
  if(!teachers.length){
    el.innerHTML='<div class="warn-note">⚠️ No teacher accounts yet. Add teacher accounts so they can log in from their phones and PCs.</div>';
    return;
  }
  el.innerHTML=teachers.map(t=>`
    <div class="teacher-card">
      <div class="teacher-info">
        <div class="teacher-name">👩‍🏫 ${t.name}</div>
        <div class="teacher-meta">Username: <strong>${t.username}</strong> · Subjects: ${t.subjects&&t.subjects.length?t.subjects.join(', '):'All'} · Classes: ${t.classes&&t.classes.length?t.classes.join(', '):'All'}</div>
      </div>
      <div style="display:flex;gap:6px;flex-shrink:0">
        <button class="btn btn-outline btn-xs" onclick="openEditTeacher('${t.username.replace(/'/g,"\\'")}')">✏️ Edit</button>
        <button class="btn btn-danger btn-xs" onclick="deleteTeacher('${t.username}')">🗑 Delete</button>
      </div>
    </div>`).join('');
}

