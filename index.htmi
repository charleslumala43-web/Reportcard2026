    .pr2-summarybar{background:#0f1f4b;color:#fff;display:flex;flex-wrap:wrap;justify-content:space-around;align-items:center;padding:4.5px 9px;font-size:7.2pt;font-weight:700;gap:4px;}
    .pr2-summarybar span{display:flex;align-items:center;gap:4px;white-space:nowrap;}
    .pr2-gradebox{border:1.5px solid #2e7d32;background:#f0fdf4;border-radius:7px;padding:6px 16px;margin:6px 0;}
    .pr2-gradebox-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px 18px;font-size:8pt;font-weight:700;color:#0f1f4b;}
    .pr2-comment{display:flex;align-items:center;gap:8px;background:#f4f7ff;border-radius:6px;padding:4.5px 10px;margin-bottom:4px;}
    .pr2-comment.head{background:#fef2f2;}
    .pr2-comment-chip{background:#0f1f4b;color:#fff;font-weight:800;font-size:7.5pt;padding:6px 12px;border-radius:5px;white-space:nowrap;text-transform:uppercase;letter-spacing:0.3px;}
    .pr2-comment.head .pr2-comment-chip{background:#b22222;}
    .pr2-comment-text{flex:1;font-style:italic;font-size:8pt;color:#333;line-height:1.25;}
    .pr2-comment-icon{font-size:13px;opacity:0.45;flex-shrink:0;}
    .pr2-footerrow{display:flex;justify-content:space-between;align-items:center;margin-top:6px;font-size:7.6pt;gap:10px;}
    .pr2-stampcircle{width:52px;height:52px;border:2px dashed #0f1f4b;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:6pt;font-weight:800;color:#0f1f4b;text-align:center;letter-spacing:0.2px;flex-shrink:0;}
    .pr2-requirements{font-size:7.6pt;font-weight:700;margin-top:5px;}
    .pr2-mottobar{background:#0f1f4b;color:#fff;display:flex;justify-content:space-between;align-items:center;padding:5px 12px;border-radius:5px;margin-top:5px;font-size:7.6pt;font-weight:700;}
    @media print{*{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;color-adjust:exact!important;}@page{size:A4 portrait;margin:0;}.a4-page{border:none;box-shadow:none;page-break-after:always;}}
  </style></head><body>${allHTML}<script>window.onload=()=>window.print();<\/script></body></html>`);
  win.document.close();
}

/* ════════ ROBUST A4 CAPTURE HELPER ════════
   Captures an .a4-page element reliably by cloning it into an isolated,
   fixed-size, untransformed container off-screen, rather than toggling the
   transform on the live preview element in place. The live preview uses
   `transform:scale(0.78)` so it fits on screen; capturing it in place can
   occasionally rasterize mid-layout-update (before the browser has settled
   on the full-size box), producing a cropped image with blank padding.
   Cloning into a fresh, fixed-position node sidesteps that entirely. */
async function captureA4Page(pageEl,scale){
  const clone=pageEl.cloneNode(true);
  clone.id='';
  clone.style.transform='none';
  clone.style.margin='0';
  clone.style.position='fixed';
  clone.style.top='0';
  clone.style.left='0';
  clone.style.zIndex='-1';
  clone.style.width='794px';
  clone.style.height='1123px';
  document.body.appendChild(clone);
  // Wait two animation frames so the browser fully applies layout/paint before rasterizing
  await new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));
  let canvas;
  try{
    canvas=await html2canvas(clone,{
      scale,useCORS:true,allowTaint:true,backgroundColor:'#ffffff',
      width:794,height:1123,windowWidth:794,windowHeight:1123,
      x:0,y:0,scrollX:0,scrollY:0
    });
  }finally{
    document.body.removeChild(clone);
  }
  return canvas;
}

/* ════════ DOWNLOAD PDF ════════ */
async function downloadPDF(){
  const page=document.querySelector('.a4-page');
  if(!page){alert('Please generate a report first.');return;}
  const btn=document.getElementById('downloadBtn');
  btn.textContent='⏳ Generating…';btn.disabled=true;
  try{
    const{jsPDF}=window.jspdf;
    const canvas=await captureA4Page(page,2);
    const imgData=canvas.toDataURL('image/jpeg',0.97);
    const pdf=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
    pdf.addImage(imgData,'JPEG',0,0,210,297);
    const sel=document.getElementById('reportStudent');
    const sName=sel.options[sel.selectedIndex]?.text.replace(/\s*\(.*\)/,'').trim()||'Report';
    const term=document.getElementById('reportTerm').value;
    const year=document.getElementById('reportYear').value||new Date().getFullYear();
    pdf.save(`${sName}_Term${term}_${year}_ReportCard.pdf`);
  }catch(err){
    alert('PDF failed: '+err.message);
  }
  btn.textContent='⬇️ Download PDF';btn.disabled=false;
}

async function downloadReportJPG(){
  const page=document.querySelector('.a4-page');
  if(!page){alert('Please generate a report first.');return;}
  const btn=document.getElementById('downloadJpgBtn');
  btn.textContent='⏳ Generating…';btn.disabled=true;
  try{
    const canvas=await captureA4Page(page,3);
    const imgData=canvas.toDataURL('image/jpeg',0.95);
    const sel=document.getElementById('reportStudent');
    const sName=sel.options[sel.selectedIndex]?.text.replace(/\s*\(.*\)/,'').trim()||'Report';
    const term=document.getElementById('reportTerm').value;
    const year=document.getElementById('reportYear').value||new Date().getFullYear();
    const a=document.createElement('a');
    a.href=imgData;
    a.download=`${sName}_Term${term}_${year}_ReportCard.jpg`;
    document.body.appendChild(a);a.click();document.body.removeChild(a);
  }catch(err){
    alert('JPG download failed: '+err.message);
  }
  btn.textContent='🖼️ Download JPG';btn.disabled=false;
}

/* ════════ ADMIN MARKS TABLE ════════ */
async function renderAdminMarks(){
  const search=(document.getElementById('marksSearch')?.value||'').toLowerCase();
  const classF=document.getElementById('marksClassFilter')?.value||'';
  const subjectF=document.getElementById('marksSubjectFilter')?.value||'';
  const termF=document.getElementById('marksTermFilter')?.value||'';
  const [students,allMarks]=await Promise.all([idbGetAll('students'),idbGetAll('marks')]);
  const studentMap=Object.fromEntries(students.map(s=>[s.id,s]));
  let filtered=allMarks.filter(mark=>{
    const learner=studentMap[mark.studentId];
    const t=(learner?.name||'').toLowerCase().includes(search)||mark.subject.toLowerCase().includes(search);
    const c=!classF||(learner?.className===classF);
    const sub=!subjectF||mark.subject===subjectF;
    const tr=!termF||String(mark.term)===String(termF);
    return t&&c&&sub&&tr;
  }).sort((a,b)=>{
    const na=studentMap[a.studentId]?.name||'';
    const nb=studentMap[b.studentId]?.name||'';
    return na.localeCompare(nb)||a.subject.localeCompare(b.subject);
  });
  const total=filtered.length;
  const totalPages=Math.max(1,Math.ceil(total/PER_PAGE));
  if(marksPage>totalPages)marksPage=totalPages;
  const slice=filtered.slice((marksPage-1)*PER_PAGE,marksPage*PER_PAGE);
  const body=document.querySelector('#adminMarksTable tbody');if(!body)return;
  body.innerHTML='';
  if(!slice.length){
    body.innerHTML='<tr class="empty-row"><td colspan="12">No marks found. Teachers must save marks from the Teacher Portal.</td></tr>';
  } else {
    slice.forEach(mark=>{
      const learner=studentMap[mark.studentId];
      const grade=getGrade(mark.total);
      const actS=markActScaled(mark).toFixed(1);
      body.innerHTML+=`<tr>
        <td><strong>${learner?learner.name:'—'}</strong></td>
        <td><span class="badge badge-navy">${learner?learner.className:'—'}</span></td>
        <td><span style="font-weight:700;color:var(--navy)">T${mark.term||'?'}</span></td>
        <td>${mark.subject}</td>
        <td>${mark.a1}</td>
        <td style="font-weight:600;color:var(--navy-mid)">${actS}</td>
        <td>${mark.exam}</td>
        <td style="font-weight:700">${mark.total}</td>
        <td><span class="badge ${gradeBadgeClass(grade)}">${grade}</span></td>
        <td style="font-size:11px;font-style:italic;color:${gradeColor(grade)}">${getComment(grade)}</td>
        <td style="font-size:11px;color:var(--muted)">${mark.teacher}</td>
        <td><button class="btn btn-danger btn-xs" onclick="deleteMark('${mark._key}')">🗑</button></td>
      </tr>`;
    });
  }
  renderPagination('marksPagination',marksPage,totalPages,total,'marksPage','renderAdminMarks');
}

async function deleteMark(key){
  if(!confirm('Delete this mark entry? This cannot be undone.'))return;
  await idbDelete('marks',key);
  await renderAdminMarks();await renderStats();
  showAlert('transferAlert','Mark entry deleted.','error');
}

/* ════════ DOWNLOAD PER-SUBJECT MARKSHEET (ADMIN) ════════ */
async function downloadAdminMarksheet(){
  const classF=document.getElementById('marksClassFilter')?.value||'';
  const subjectF=document.getElementById('marksSubjectFilter')?.value||'';
  const termF=document.getElementById('marksTermFilter')?.value||'';
  if(!subjectF){showAlert('adminMarksDownloadAlert','Please select a Subject above first — the marksheet is downloaded one subject at a time.','error');return;}
  const [students,allMarks]=await Promise.all([idbGetAll('students'),idbGetAll('marks')]);
  const studentMap=Object.fromEntries(students.map(s=>[s.id,s]));
  let rows=allMarks.filter(mark=>{
    const learner=studentMap[mark.studentId];
    const c=!classF||(learner?.className===classF);
    const tr=!termF||String(mark.term)===String(termF);
    return mark.subject===subjectF&&c&&tr;
  }).sort((a,b)=>{
    const na=studentMap[a.studentId]?.name||'',nb=studentMap[b.studentId]?.name||'';
    return na.localeCompare(nb);
  });
  if(!rows.length){showAlert('adminMarksDownloadAlert','No marks found for that Subject/Class/Term selection.','error');return;}
  const sheetRows=rows.map(mark=>{
    const learner=studentMap[mark.studentId];
    const grade=getGrade(mark.total);
    const actS=markActScaled(mark).toFixed(1);
    return{'Learner ID':learner?learner.id:mark.studentId,'Full Name':learner?learner.name:'—','Class':learner?learner.className:'—','Term':mark.term,'Subject':mark.subject,'A1 /3':mark.a1,'Activities /20':actS,'End Term /80':mark.exam,'Total /100':mark.total,'Grade':grade,'Comment':getComment(grade),'Teacher':mark.teacher};
  });
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.json_to_sheet(sheetRows);
  ws['!cols']=[{wch:12},{wch:28},{wch:14},{wch:7},{wch:28},{wch:7},{wch:7},{wch:7},{wch:13},{wch:13},{wch:11},{wch:7},{wch:14},{wch:22}];
  XLSX.utils.book_append_sheet(wb,ws,'Marksheet');
  const meta=[{'System':'LUMA@ Pro School Manager','Type':'Marksheet','Subject':subjectF,'Class':classF||'All Classes','Term':termF?`Term ${termF}`:'All Terms','Exported':new Date().toLocaleString(),'Version':'4.0'}];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(meta),'_meta');
  const safeSubject=subjectF.replace(/[^a-z0-9]/gi,'_').substring(0,24);
  const safeClass=(classF||'AllClasses').replace(/[^a-z0-9]/gi,'_');
  const termLabel=termF?`T${termF}`:'AllTerms';
  const date=new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb,`Marksheet_${safeSubject}_${safeClass}_${termLabel}_${date}.xlsx`);
  showAlert('adminMarksDownloadAlert',`✅ Downloaded ${subjectF} marksheet${classF?' — '+classF:' — all classes'}${termF?' — Term '+termF:' — all terms'} (${rows.length} entr${rows.length===1?'y':'ies'}).`);
}

/* ════════ ANALYTICS ════════ */
async function renderAnalytics(){
  const classF=document.getElementById('analyticsClass')?.value||'';
  const termF=document.getElementById('analyticsTerm')?.value||'';
  const [allMarks,allStudents]=await Promise.all([idbGetAll('marks'),idbGetAll('students')]);
  const studentMap=Object.fromEntries(allStudents.map(s=>[s.id,s]));
  let marks=allMarks.filter(m=>{
    const s=studentMap[m.studentId];
    const c=!classF||(s?.className===classF);
    const t=!termF||String(m.term)===String(termF);
    return c&&t;
  });
  if(!marks.length){document.getElementById('analyticsOutput').innerHTML='<div class="warn-note">No marks found for the selected filters.</div>';return;}

  // Grade distribution
  const gradeCounts={A:0,B:0,C:0,D:0,E:0};
  marks.forEach(m=>gradeCounts[getGrade(m.total)]++);
  const totalM=marks.length;

  // Subject averages
  const subjectMap={};
  marks.forEach(m=>{
    if(!subjectMap[m.subject])subjectMap[m.subject]={sum:0,count:0};
    subjectMap[m.subject].sum+=Number(m.total);
    subjectMap[m.subject].count++;
  });
  const subjectAvgs=Object.entries(subjectMap).map(([s,v])=>({subject:s,avg:(v.sum/v.count).toFixed(1),count:v.count})).sort((a,b)=>b.avg-a.avg);

  // Pass rate
  const passCount=marks.filter(m=>Number(m.total)>=45).length;
  const passRate=Math.round(passCount/totalM*100);

  // Overall avg
  const overallAvg=(marks.reduce((a,m)=>a+Number(m.total),0)/totalM).toFixed(1);

  const gradeColors={A:'#16a34a',B:'#1d4ed8',C:'#d97706',D:'#ea580c',E:'#dc2626'};

  document.getElementById('analyticsOutput').innerHTML=`
    <div class="grid-4" style="margin-bottom:20px">
      <div class="stat-card"><div class="stat-icon blue">📝</div><div><div class="stat-val">${totalM}</div><div class="stat-lbl">Total Mark Entries</div></div></div>
      <div class="stat-card"><div class="stat-icon green">📊</div><div><div class="stat-val">${overallAvg}</div><div class="stat-lbl">Overall Average</div></div></div>
      <div class="stat-card"><div class="stat-icon ${passRate>=50?'green':'red'}">✅</div><div><div class="stat-val">${passRate}%</div><div class="stat-lbl">Pass Rate (≥45)</div></div></div>
      <div class="stat-card"><div class="stat-icon gold">🏆</div><div><div class="stat-val">${gradeCounts.A}</div><div class="stat-lbl">Grade A (Accomplished)</div></div></div>
    </div>
    <div class="grid-2">
      <div>
        <div style="font-weight:700;color:var(--navy);margin-bottom:12px;font-size:14px">📊 Grade Distribution</div>
        <div class="chart-bar-wrap">
          ${Object.entries(gradeCounts).map(([g,n])=>`
            <div class="chart-bar-row">
              <div class="chart-bar-label"><span class="badge badge-${g.toLowerCase()}">${g}</span> ${getComment(g)}</div>
              <div class="chart-bar-track"><div class="chart-bar-fill" style="width:${totalM?Math.round(n/totalM*100):0}%;background:${gradeColors[g]}">${totalM&&n?Math.round(n/totalM*100)+'%':''}</div></div>
              <div class="chart-bar-count">${n}</div>
            </div>`).join('')}
        </div>
      </div>
      <div>
        <div style="font-weight:700;color:var(--navy);margin-bottom:12px;font-size:14px">📚 Subject Averages (Top 10)</div>
        <div class="chart-bar-wrap">
          ${subjectAvgs.slice(0,10).map(s=>`
            <div class="chart-bar-row">
              <div class="chart-bar-label" style="font-size:11px;min-width:130px" title="${s.subject}">${s.subject.length>18?s.subject.substring(0,17)+'…':s.subject}</div>
              <div class="chart-bar-track"><div class="chart-bar-fill" style="width:${s.avg}%;background:${gradeColors[getGrade(s.avg)]}">${s.avg}</div></div>
              <div class="chart-bar-count" style="font-size:11px">${s.count}</div>
            </div>`).join('')}
        </div>
      </div>
    </div>`;
}

/* ════════ PRINT MARKSHEET ════════ */
function printMarksheet(){
  document.body.classList.add('printing-marksheet');
  window.print();
  setTimeout(()=>document.body.classList.remove('printing-marksheet'),1000);
}

async function downloadMarksheet(){
  const allBtns=document.querySelectorAll('#teacher-sheet .btn');
  const gradeKey=document.querySelector('#teacher-sheet .grade-key');
  const infoNote=document.querySelector('#teacher-sheet .info-note');
  const marksAlert=document.getElementById('marksAlert');
  const transferAlert=document.getElementById('marksheetTransferAlert');
  allBtns.forEach(b=>b.style.visibility='hidden');
  if(gradeKey)gradeKey.style.display='none';
  if(infoNote)infoNote.style.display='none';
  marksAlert.classList.remove('show');
  transferAlert.classList.remove('show');
  try{
    const card=document.querySelector('#teacher-sheet .card');
    const{jsPDF}=window.jspdf;
    const canvas=await html2canvas(card,{scale:2,useCORS:true,backgroundColor:'#ffffff',width:card.scrollWidth,height:card.scrollHeight});
    const imgData=canvas.toDataURL('image/jpeg',0.95);
    const pdf=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});
    const pw=pdf.internal.pageSize.getWidth();
    const ph=pdf.internal.pageSize.getHeight();
    const imgW=pw;
    const imgH=(canvas.height*pw)/canvas.width;
    const finalW=imgH>ph?(canvas.width*ph)/canvas.height:imgW;
    const finalH=imgH>ph?ph:imgH;
    const offsetX=(pw-finalW)/2;
    const offsetY=(ph-finalH)/2;
    pdf.addImage(imgData,'JPEG',offsetX,offsetY,finalW,finalH);
    pdf.save(`Marksheet_${currentSubject}_${currentClass}_Term${currentTerm}.pdf`);
  }catch(err){alert('Download failed: '+err.message);}
  allBtns.forEach(b=>b.style.visibility='');
  if(gradeKey)gradeKey.style.display='';
  if(infoNote)infoNote.style.display='';
}

/* ════════ EXPORT TO EXCEL ════════ */
/* ════════ FULL SYSTEM BACKUP (all stores, for cross-device migration) ════════
   Excel export below only covers learners & marks. This saves every store —
   teachers, parents, bursars, fees, attendance, circulars, messages, school
   settings, photos and logo — as one self-contained .json file, since this
   app has no cloud backend and data lives only in this browser. */
async function downloadFullBackup(){
  try{
    const stores={};
    for(const store of STORES){
      stores[store]=await idbGetAll(store);
    }
    const backup={system:'LUMA@ Pro School Manager',backupVersion:1,dbVersion:DB_VERSION,exportedAt:new Date().toISOString(),stores};
    const blob=new Blob([JSON.stringify(backup)],{type:'application/json'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    const date=new Date().toISOString().slice(0,10);
    a.href=url;a.download=`LUMA_Pro_FULL_BACKUP_${date}.json`;
    document.body.appendChild(a);a.click();a.remove();
    URL.revokeObjectURL(url);
    await idbPut('school',new Date().toISOString(),'lastBackupAt');
    await updateBackupStatusLine();
    showAlert('fullBackupAlert','✅ Full backup downloaded. Keep this file somewhere safe — it contains everything.');
  }catch(err){
    showAlert('fullBackupAlert','❌ Backup failed: '+err.message,'error');
  }
}

async function restoreFullBackup(){
  const file=document.getElementById('restoreFile').files[0];
  if(!file){showAlert('fullBackupAlert','Please select a backup .json file first.','error');return;}
  const mode=document.getElementById('restoreMode').value;
  const warnExtra=mode==='replace'?' This will ERASE all current data on this device first — this cannot be undone.':' Existing records with the same ID will be overwritten by the backup version; everything else stays.';
  if(!confirm(`Restore from "${file.name}"?${warnExtra}`))return;
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const backup=JSON.parse(e.target.result);
      if(!backup||!backup.stores||typeof backup.stores!=='object')throw new Error('This file is not a valid LUMA@ Pro backup.');
      for(const store of STORES){
        const records=backup.stores[store];
        if(!Array.isArray(records))continue;
        if(mode==='replace')await idbClear(store);
        if(records.length)await idbPutMany(store,records);
      }
      await idbPut('school',new Date().toISOString(),'lastBackupAt');
      showAlert('fullBackupAlert','✅ Backup restored successfully. Reloading…');
      setTimeout(()=>location.reload(),1500);
    }catch(err){
      showAlert('fullBackupAlert','❌ Restore failed: '+err.message,'error');
    }
  };
  reader.readAsText(file);
}

async function updateBackupStatusLine(){
  const last=await idbGet('school','lastBackupAt');
  const line=document.getElementById('backupStatusLine');
  const banner=document.getElementById('backupReminderBanner');
  if(!last){
    if(line)line.innerHTML='⚠️ No full backup has been taken yet on this device.';
    if(banner){banner.style.display='block';banner.innerHTML='⚠️ <strong>No backup yet.</strong> This app only stores data on this device — take a Full Backup to protect against data loss. Tap here to back up now →';}
    return;
  }
  const days=Math.floor((Date.now()-new Date(last).getTime())/86400000);
  const when=new Date(last).toLocaleString();
  if(line)line.innerHTML=`🗄️ Last full backup: <strong>${when}</strong> (${days===0?'today':days+' day'+(days===1?'':'s')+' ago'})`;
  if(banner){
    if(days>=14){
      banner.style.display='block';
      banner.innerHTML=`⚠️ <strong>It's been ${days} days since your last full backup.</strong> Since data lives only on this device, back up regularly to avoid losing everything. Tap here to back up now →`;
    } else {
      banner.style.display='none';
    }
  }
}

async function exportExcel(mode='all'){
  if(typeof XLSX==='undefined'){showAlert('transferAlert','⚠️ Excel export isn\'t available — the xlsx library failed to load. Check that "libs/xlsx.full.min.js" is present next to this app, or that you have internet on first run.','error');return;}
  try{
  const [students,marks]=await Promise.all([idbGetAll('students'),idbGetAll('marks')]);
  const wb=XLSX.utils.book_new();
  if(mode==='all'||mode==='students'){
    const sRows=students.map(s=>({'Learner ID':s.id,'Full Name':s.name,'Class':s.className,'Religion':s.religion||'','Has Photo':s.photo?'Yes':'No','_photo':s.photo||''}));
    const ws=XLSX.utils.json_to_sheet(sRows);
    ws['!cols']=[{wch:12},{wch:30},{wch:14},{wch:10},{wch:10},{wch:0}];
    XLSX.utils.book_append_sheet(wb,ws,'Learners');
  }
  if(mode==='all'||mode==='marks'){
    const studentMap=Object.fromEntries(students.map(s=>[s.id,s]));
    const mRows=marks.map(m=>({
      'Learner ID':m.studentId,'Learner Name':studentMap[m.studentId]?.name||'',
      'Class':studentMap[m.studentId]?.className||'','Term':m.term||1,'Year':m.year||'','Subject':m.subject,
      'A1 /3':m.a1,
      'Activities /20':Number(markActScaled(m).toFixed(1)),
      'End Term /80':m.exam,'Total /100':m.total,
      'Grade':getGrade(m.total),'Comment':getComment(getGrade(m.total)),'Teacher':m.teacher
    }));
    const ws2=XLSX.utils.json_to_sheet(mRows);
    ws2['!cols']=[{wch:12},{wch:28},{wch:14},{wch:7},{wch:7},{wch:28},{wch:7},{wch:7},{wch:7},{wch:13},{wch:13},{wch:11},{wch:7},{wch:14},{wch:22}];
    XLSX.utils.book_append_sheet(wb,ws2,'Marks');
  }
  const meta=[{'System':'LUMA@ Pro School Manager','Version':'4.0','Exported':new Date().toLocaleString()}];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(meta),'_meta');
  const label=mode==='students'?'Learners':mode==='marks'?'Marks':'All_Data';
  const date=new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb,`LUMA_Pro_${label}_${date}.xlsx`);
  showAlert('transferAlert',`✅ Export complete — LUMA_Pro_${label}_${date}.xlsx downloaded.`);
  }catch(err){
    console.error('exportExcel failed:',err);
    showAlert('transferAlert','❌ Excel export failed: '+err.message,'error');
  }
}

/* ════════ IMPORT FROM EXCEL ════════ */
async function importExcel(){
  if(xlsxMissing('transferAlert'))return;
  const file=document.getElementById('importFile').files[0];
  if(!file){showAlert('transferAlert','Please select an Excel file to import.','error');return;}
  const progress=document.getElementById('importProgress');
  const bar=document.getElementById('importBar');
  const status=document.getElementById('importStatus');
  progress.style.display='block';bar.style.width='0%';
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      if(!wb.SheetNames.includes('_meta')){
        showAlert('transferAlert','This file was not exported from LUMA@ Pro School Manager.','error');
        progress.style.display='none';return;
      }
      const CHUNK=450;
      let addedStudents=0,skippedStudents=0,addedMarks=0,skippedMarks=0,updatedStudents=0;

      // ── Learners ── fetch existing once, batch-commit writes, instead of
      // one Firestore round-trip per row (that's what used to stall the bar
      // around 20% on anything but tiny files).
      let studentLookup=null;
      if(wb.SheetNames.includes('Learners')){
        status.textContent='Reading learners…';bar.style.width='10%';
        const rows=XLSX.utils.sheet_to_json(wb.Sheets['Learners']);
        const existingStudents=await idbGetAll('students');
        const existingIds=new Set(existingStudents.map(s=>s.id));
        studentLookup=new Map(existingStudents.map(s=>[s.id,s]));
        const toAdd=[];const toUpdate=[];
        for(const row of rows){
          const id=(row['Learner ID']||'').toString().trim().toUpperCase();
          const name=(row['Full Name']||'').toString().trim();
          const cls=(row['Class']||'').toString().trim();
          if(!id||!name)continue;
          const reRaw=(row['Religion']||row['RE']||'').toString().trim().toUpperCase();
          const re=(reRaw==='CRE'||reRaw==='IRE')?reRaw:'';
          if(existingIds.has(id)){
            // Existing S.1/S.2 learner with no CRE/IRE choice yet: fill it in from the file
            const exS=studentLookup.get(id);
            if(re&&exS&&isS1orS2(exS.className)&&!exS.religion){exS.religion=re;toUpdate.push(exS);}
            skippedStudents++;continue;
          }
          const s={id,name,className:cls,photo:row['_photo']||'',religion:isS1orS2(cls)?re:''};
          existingIds.add(id);
          studentLookup.set(id,s);
          toAdd.push(s);
        }
        status.textContent=`Importing ${toAdd.length} learner(s)…`;bar.style.width='25%';
        for(let i=0;i<toAdd.length;i+=CHUNK){
          await idbPutMany('students', toAdd.slice(i,i+CHUNK));
          addedStudents+=Math.min(CHUNK,toAdd.length-i);
          bar.style.width=(25+((i+CHUNK)/Math.max(1,toAdd.length))*25)+'%';
        }
        if(toUpdate.length)await idbPutMany('students',toUpdate);
        updatedStudents=toUpdate.length;
        bar.style.width='50%';
      }

      // ── Marks ── same fix: one bulk read of existing marks + student
      // lookups, then batched writes instead of per-row awaits.
      if(wb.SheetNames.includes('Marks')){
        status.textContent='Reading marks…';bar.style.width='55%';
        const rows=XLSX.utils.sheet_to_json(wb.Sheets['Marks']);
        const existingMarks=await idbGetAll('marks');
        const existingKeys=new Set(existingMarks.map(m=>m._key));
        if(!studentLookup){
          const allStudents=await idbGetAll('students');
          studentLookup=new Map(allStudents.map(s=>[s.id,s]));
        }
        const toAdd=[];
        for(const row of rows){
          const studentId=(row['Learner ID']||'').toString().trim().toUpperCase();
          const subject=(row['Subject']||'').toString().trim();
          const term=Number(row['Term']||1);
          const year=row['Year']?Number(row['Year']):new Date().getFullYear();
          if(!studentId||!subject)continue;
          const key=`${studentId}:${subject}:${term}:${year}`;
          if(existingKeys.has(key)){skippedMarks++;continue;}
          const student=studentLookup.get(studentId);
          const a1=Number(row['A1 /3']||0);
          const exam=Number(row['End Term /80']||0);
          // Keep the exported Activities /20 as-is (older files used 3 activities, now 1);
          // only calculate it from A1 when the file doesn't have it.
          const actRaw=row['Activities /20'];
          const hasAct=actRaw!==undefined&&actRaw!==''&&!isNaN(Number(actRaw));
          const actScaled=hasAct?Number(Number(actRaw).toFixed(1)):Number((a1/3*20).toFixed(1));
          const totRaw=row['Total /100'];
          const hasTot=totRaw!==undefined&&totRaw!==''&&!isNaN(Number(totRaw));
          const total=hasTot?String(totRaw):String((actScaled+exam).toFixed(1));
          existingKeys.add(key);
          toAdd.push({
            _key:key,studentId,subject,
            className:student?.className||(row['Class']||''),
            teacher:(row['Teacher']||'').toString(),
            term,year,a1,exam,actScaled,total
          });
        }
        status.textContent=`Importing ${toAdd.length} mark record(s)…`;bar.style.width='60%';
        for(let i=0;i<toAdd.length;i+=CHUNK){
          await idbPutMany('marks', toAdd.slice(i,i+CHUNK));
          addedMarks+=Math.min(CHUNK,toAdd.length-i);
          bar.style.width=(60+((i+CHUNK)/Math.max(1,toAdd.length))*30)+'%';
        }
      }
      bar.style.width='100%';status.textContent='Done!';
      setTimeout(()=>progress.style.display='none',2000);
      await renderStats();await renderLearnerTable();await renderAdminMarks();await loadReportStudents();await populateClassFilters();
      document.getElementById('importFile').value='';
      showAlert('transferAlert',`✅ Import complete — Added ${addedStudents} learner(s), ${addedMarks} mark record(s). Skipped ${skippedStudents+skippedMarks} existing.${updatedStudents?' CRE/IRE set for '+updatedStudents+' existing learner(s).':''}`);
    }catch(err){
      progress.style.display='none';
      showAlert('transferAlert','Import failed: '+err.message,'error');
    }
  };
  reader.readAsArrayBuffer(file);
}

/* ════════ EXPORT MARKSHEET TO EXCEL ════════ */
async function exportMarksheetExcel(){
  if(!currentTeacherObj){showAlert('marksheetTransferAlert','Please log in as a teacher first.','error');return;}
  if(typeof XLSX==='undefined'){showAlert('marksheetTransferAlert','⚠️ Excel export isn\'t available — the xlsx library failed to load. Check that "libs/xlsx.full.min.js" is present next to this app, or that you have internet on first run.','error');return;}
  try{
  if(isPrimaryTier(currentClassLevel)){await exportPrimaryMarksheetExcel();return;}
  let students=await idbGetByIndex('students','className',currentClass);
  students=filterByReligion(students,currentClass,currentSubject);
  students.sort((a,b)=>a.name.localeCompare(b.name));
  const allMarks=await idbGetAll('marks');
  const rows=students.map(student=>{
    const ex=allMarks.find(m=>m._key===`${student.id}:${currentSubject}:${currentTerm}:${currentYear}`)
      ||allMarks.find(m=>m._key===`${student.id}:${currentSubject}:${currentTerm}`&&!m.year);
    const a1=ex?ex.a1:'',exam=ex?ex.exam:'';
    const actS=ex?markActScaled(ex):'',total=ex?ex.total:'';
    const grade=ex?getGrade(ex.total):'';
    return{'Learner ID':student.id,'Full Name':student.name,'Class':student.className,'Term':currentTerm,'Subject':currentSubject,'A1 /3':a1,'Activities /20':actS,'End Term /80':exam,'Total /100':total,'Grade':grade,'Comment':grade?getComment(grade):'','Teacher':currentTeacherObj.name};
  });
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.json_to_sheet(rows);
  ws['!cols']=[{wch:12},{wch:28},{wch:14},{wch:7},{wch:28},{wch:7},{wch:7},{wch:7},{wch:13},{wch:13},{wch:11},{wch:7},{wch:14},{wch:22}];
  XLSX.utils.book_append_sheet(wb,ws,'Marksheet');
  const meta=[{'System':'LUMA@ Pro School Manager','Type':'Marksheet','Subject':currentSubject,'Class':currentClass,'Term':currentTerm,'Year':currentYear,'Teacher':currentTeacherObj.name,'Exported':new Date().toLocaleString(),'Version':'4.0'}];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(meta),'_meta');
  const safeSubject=currentSubject.replace(/[^a-z0-9]/gi,'_').substring(0,24);
  const safeClass=currentClass.replace(/[^a-z0-9]/gi,'_');
  const date=new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb,`Marksheet_${safeClass}_${safeSubject}_T${currentTerm}_${date}.xlsx`);
  showAlert('marksheetTransferAlert',`✅ Exported marksheet for ${currentClass} — ${currentSubject} — Term ${currentTerm}.`);
  }catch(err){
    console.error('exportMarksheetExcel failed:',err);
    showAlert('marksheetTransferAlert','❌ Excel export failed: '+err.message,'error');
  }
}

async function exportPrimaryMarksheetExcel(){
  if(typeof XLSX==='undefined'){showAlert('marksheetTransferAlert','⚠️ Excel export isn\'t available — the xlsx library failed to load. Check that "libs/xlsx.full.min.js" is present next to this app.','error');return;}
  try{
  const students=await idbGetByIndex('students','className',currentClass);
  students.sort((a,b)=>a.name.localeCompare(b.name));
  const allMarks=await idbGetAll('primaryMarks');
  const rows=students.map(student=>{
    const ex=allMarks.find(m=>m._key===`${student.id}:${currentSubject}:${currentTerm}:${currentYear}`);
    const endTerm=ex?ex.endTerm:'',mid1=ex?ex.mid1:'',mid2=ex?ex.mid2:'';
    const grade=(ex&&ex.endTerm!=='')?getPrimaryGrade(ex.endTerm):'';
    return{'Learner ID':student.id,'Full Name':student.name,'Class':student.className,'Term':currentTerm,'Subject':currentSubject,'End Term /100':endTerm,'Mid-Term Set 1 /100':mid1,'Mid-Term Set 2 /100':mid2,'Grade':grade,'Remark':grade?getPrimaryComment(grade):'','Teacher':currentTeacherObj.name};
  });
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.json_to_sheet(rows);
  ws['!cols']=[{wch:12},{wch:28},{wch:10},{wch:7},{wch:20},{wch:13},{wch:17},{wch:17},{wch:7},{wch:16},{wch:22}];
  XLSX.utils.book_append_sheet(wb,ws,'Marksheet');
  const meta=[{'System':'LUMA@ Pro School Manager','Type':'PrimaryMarksheet','Subject':currentSubject,'Class':currentClass,'Term':currentTerm,'Year':currentYear,'Teacher':currentTeacherObj.name,'Exported':new Date().toLocaleString(),'Version':'4.0'}];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(meta),'_meta');
  const safeSubject=currentSubject.replace(/[^a-z0-9]/gi,'_').substring(0,24);
  const safeClass=currentClass.replace(/[^a-z0-9]/gi,'_');
  const date=new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb,`Marksheet_${safeClass}_${safeSubject}_T${currentTerm}_${date}.xlsx`);
  showAlert('marksheetTransferAlert',`✅ Exported marksheet for ${currentClass} — ${currentSubject} — Term ${currentTerm}.`);
  }catch(err){
    console.error('exportPrimaryMarksheetExcel failed:',err);
    showAlert('marksheetTransferAlert','❌ Excel export failed: '+err.message,'error');
  }
}

/* ════════ IMPORT MARKSHEET FROM EXCEL ════════ */
async function importMarksheetExcel(input){
  if(xlsxMissing('marksheetTransferAlert')){input.value='';return;}
  if(isPrimaryTier(currentClassLevel)){await importPrimaryMarksheetExcel(input);return;}
  const file=input.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      if(!wb.SheetNames.includes('_meta')){showAlert('marksheetTransferAlert','Not a LUMA@ Pro export file.','error');input.value='';return;}
      if(wb.SheetNames.includes('_meta')){
        const metaRows=XLSX.utils.sheet_to_json(wb.Sheets['_meta']);
        if(metaRows.length){
          const m=metaRows[0];
          if(m.Subject&&m.Subject!==currentSubject){if(!confirm(`⚠️ File is for "${m.Subject}" but you're logged in for "${currentSubject}".\n\nImport anyway?`)){input.value='';return;}}
          if(m.Class&&m.Class!==currentClass){if(!confirm(`⚠️ File is for class "${m.Class}" but you're logged in for "${currentClass}".\n\nImport anyway?`)){input.value='';return;}}
          if(m.Term&&Number(m.Term)!==currentTerm){if(!confirm(`⚠️ File is for Term ${m.Term} but you're viewing Term ${currentTerm}.\n\nImport anyway?`)){input.value='';return;}}
          if(m.Year&&String(m.Year)!==String(currentYear)){if(!confirm(`⚠️ File is for year ${m.Year} but current year is ${currentYear}.\n\nImport anyway?`)){input.value='';return;}}
        }
      }
      if(!wb.SheetNames.includes('Marksheet')){showAlert('marksheetTransferAlert','No Marksheet sheet found.','error');input.value='';return;}
      const rows=XLSX.utils.sheet_to_json(wb.Sheets['Marksheet']);
      const tableRows=document.querySelectorAll('#classTable tbody tr');
      const rowMap={};
      tableRows.forEach(row=>{const idEl=row.querySelector('.studentId');if(idEl)rowMap[idEl.value]=row;});
      let filled=0,skipped=0;
      for(const dataRow of rows){
        const id=(dataRow['Learner ID']||'').toString().trim().toUpperCase();
        const tr=rowMap[id];
        if(!tr){skipped++;continue;}
        const a1=dataRow['A1 /3']!==undefined?Number(dataRow['A1 /3']):null;
        const exam=dataRow['End Term /80']!==undefined?Number(dataRow['End Term /80']):null;
        if(a1!==null){const inp=tr.querySelector('.a1');if(inp)inp.value=Math.min(3,Math.max(0,a1));}
        if(exam!==null){const inp=tr.querySelector('.exam');if(inp)inp.value=Math.min(80,Math.max(0,exam));}
        liveRow(tr);
        filled++;
      }
      input.value='';
      showAlert('marksheetTransferAlert',`✅ Imported ${filled} row(s)${skipped?' ('+skipped+' not in this class)':''}. Click 💾 Save Marks to commit.`);
    }catch(err){input.value='';showAlert('marksheetTransferAlert','Import failed: '+err.message,'error');}
  };
  reader.readAsArrayBuffer(file);
}

async function importPrimaryMarksheetExcel(input){
  const file=input.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      if(!wb.SheetNames.includes('Marksheet')){showAlert('marksheetTransferAlert','No Marksheet sheet found.','error');input.value='';return;}
      const rows=XLSX.utils.sheet_to_json(wb.Sheets['Marksheet']);
      const tableRows=document.querySelectorAll('#classTable tbody tr');
      const rowMap={};
      tableRows.forEach(row=>{const idEl=row.querySelector('.studentId');if(idEl)rowMap[idEl.value]=row;});
      let filled=0,skipped=0;
      for(const dataRow of rows){
        const id=(dataRow['Learner ID']||'').toString().trim().toUpperCase();
        const tr=rowMap[id];
        if(!tr){skipped++;continue;}
        const endTerm=dataRow['End Term /100']!==undefined?Number(dataRow['End Term /100']):null;
        const mid1=dataRow['Mid-Term Set 1 /100']!==undefined?Number(dataRow['Mid-Term Set 1 /100']):null;
        const mid2=dataRow['Mid-Term Set 2 /100']!==undefined?Number(dataRow['Mid-Term Set 2 /100']):null;
        if(endTerm!==null){const inp=tr.querySelector('.pEnd');if(inp)inp.value=Math.min(100,Math.max(0,endTerm));}
        if(mid1!==null){const inp=tr.querySelector('.pMid1');if(inp)inp.value=Math.min(100,Math.max(0,mid1));}
        if(mid2!==null){const inp=tr.querySelector('.pMid2');if(inp)inp.value=Math.min(100,Math.max(0,mid2));}
        livePrimaryRow(tr);
        filled++;
      }
      input.value='';
      showAlert('marksheetTransferAlert',`✅ Imported ${filled} row(s)${skipped?' ('+skipped+' not in this class)':''}. Click 💾 Save Marks to commit.`);
    }catch(err){input.value='';showAlert('marksheetTransferAlert','Import failed: '+err.message,'error');}
  };
  reader.readAsArrayBuffer(file);
}

/* ════════ UNSAVED MARKS GUARD ════════ */
function backFromMarksheet(){
  if(marksUnsaved){
    if(!confirm('⚠️ You have unsaved marks. Go back without saving?\n\nClick Cancel to stay and save first.'))return;
  }
  marksUnsaved=false;
  switchPage('teacher-dashboard');
}

/* ════════ TEACHER CONDUCT MODAL ════════ */
async function openTeacherConductModal(){
  // Teachers enter conduct for all learners in their current class
  const students=await idbGetByIndex('students','className',currentClass);
  if(!students.length){alert('No learners in this class yet.');return;}
  students.sort((a,b)=>a.name.localeCompare(b.name));

  // Build a mini-modal dynamically
  let rows=students.map(s=>`
    <tr style="border-bottom:1px solid var(--border)">
      <td style="padding:7px 8px;font-weight:600;font-size:13px;min-width:140px">${s.name}</td>
      <td style="padding:4px 5px"><select class="tc-punctuality" data-id="${s.id}" style="width:100%;padding:4px 6px;font-size:12px;border:1px solid var(--border);border-radius:6px">
        <option value="">—</option><option>Excellent</option><option>Very Good</option><option>Good</option><option>Fair</option><option>Poor</option>
      </select></td>
      <td style="padding:4px 5px"><select class="tc-discipline" data-id="${s.id}" style="width:100%;padding:4px 6px;font-size:12px;border:1px solid var(--border);border-radius:6px">
        <option value="">—</option><option>Excellent</option><option>Very Good</option><option>Good</option><option>Fair</option><option>Poor</option>
      </select></td>
      <td style="padding:4px 5px"><input class="tc-present" data-id="${s.id}" type="number" min="0" placeholder="Days" style="width:62px;padding:4px 6px;font-size:12px;border:1px solid var(--border);border-radius:6px"></td>
      <td style="padding:4px 5px"><input class="tc-total" data-id="${s.id}" type="number" min="0" placeholder="Total" style="width:62px;padding:4px 6px;font-size:12px;border:1px solid var(--border);border-radius:6px"></td>
      <td style="padding:4px 5px"><input class="tc-remark" data-id="${s.id}" type="text" placeholder="Teacher remark…" style="width:100%;min-width:160px;padding:4px 6px;font-size:12px;border:1px solid var(--border);border-radius:6px"></td>
    </tr>`).join('');

  // Pre-fill saved values
  for(const s of students){
    const c=await idbGet('conduct',`${s.id}:${currentTerm}:${currentYear}`)||await idbGet('conduct',`${s.id}:${currentTerm}`)||{};
    document.querySelectorAll(`[data-id="${s.id}"]`);
    // Store for after DOM insertion
    s._conduct=c;
  }

  const overlay=document.createElement('div');
  overlay.style.cssText='position:fixed;inset:0;background:rgba(15,31,75,0.6);z-index:600;display:flex;align-items:center;justify-content:center;padding:16px';
  overlay.innerHTML=`
    <div style="background:#fff;border-radius:18px;padding:24px;max-width:900px;width:100%;max-height:88vh;overflow-y:auto;box-shadow:0 8px 40px rgba(15,31,75,0.2)">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:17px;color:var(--navy);font-weight:700">📝 Conduct & Attendance — ${currentClass} · Term ${currentTerm} (${currentYear})</div>
        <button onclick="this.closest('[style]').remove()" style="background:none;border:none;font-size:22px;cursor:pointer;color:var(--muted)">✕</button>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
          <thead><tr style="background:var(--navy)">
            <th style="color:#fff;padding:9px 8px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase">Learner</th>
            <th style="color:#fff;padding:9px 8px;font-size:11px;font-weight:700;text-transform:uppercase">Punctuality</th>
            <th style="color:#fff;padding:9px 8px;font-size:11px;font-weight:700;text-transform:uppercase">Discipline</th>
            <th style="color:#fff;padding:9px 8px;font-size:11px;font-weight:700;text-transform:uppercase">Present</th>
            <th style="color:#fff;padding:9px 8px;font-size:11px;font-weight:700;text-transform:uppercase">Total Days</th>
            <th style="color:#fff;padding:9px 8px;font-size:11px;font-weight:700;text-transform:uppercase">Teacher Remark</th>
          </tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
      <div style="display:flex;gap:9px;margin-top:16px;justify-content:flex-end">
        <button onclick="this.closest('[style]').remove()" style="padding:9px 18px;border:1.5px solid var(--border);border-radius:9px;background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
        <button id="saveTeacherConductBtn" style="padding:9px 22px;background:var(--navy);color:#fff;border:none;border-radius:9px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;cursor:pointer">💾 Save All Conduct</button>
      </div>
      <div id="teacherConductAlert" style="margin-top:10px;display:none;padding:10px 14px;border-radius:8px;font-size:13px"></div>
    </div>`;
  document.body.appendChild(overlay);

  // Pre-fill after DOM insertion
  for(const s of students){
    const c=s._conduct||{};
    const pEl=overlay.querySelector(`.tc-punctuality[data-id="${s.id}"]`);
    const dEl=overlay.querySelector(`.tc-discipline[data-id="${s.id}"]`);
    const prEl=overlay.querySelector(`.tc-present[data-id="${s.id}"]`);
    const tEl=overlay.querySelector(`.tc-total[data-id="${s.id}"]`);
    const rEl=overlay.querySelector(`.tc-remark[data-id="${s.id}"]`);
    if(pEl&&c.punctuality)pEl.value=c.punctuality;
    if(dEl&&c.discipline)dEl.value=c.discipline;
    if(prEl&&c.daysPresent)prEl.value=c.daysPresent;
    if(tEl&&c.daysTotal)tEl.value=c.daysTotal;
    if(rEl&&c.teacherRemark)rEl.value=c.teacherRemark;
  }

  overlay.querySelector('#saveTeacherConductBtn').onclick=async()=>{
    let saved=0;
    for(const s of students){
      const pEl=overlay.querySelector(`.tc-punctuality[data-id="${s.id}"]`);
      const dEl=overlay.querySelector(`.tc-discipline[data-id="${s.id}"]`);
      const prEl=overlay.querySelector(`.tc-present[data-id="${s.id}"]`);
      const tEl=overlay.querySelector(`.tc-total[data-id="${s.id}"]`);
      const rEl=overlay.querySelector(`.tc-remark[data-id="${s.id}"]`);
      const existing=await idbGet('conduct',`${s.id}:${currentTerm}:${currentYear}`)||{};
      await idbPut('conduct',{
        _key:`${s.id}:${currentTerm}:${currentYear}`,
        studentId:s.id,term:currentTerm,year:currentYear,
        punctuality:pEl?pEl.value:existing.punctuality||'',
        discipline:dEl?dEl.value:existing.discipline||'',
        daysPresent:prEl?prEl.value:existing.daysPresent||'',
        daysTotal:tEl?tEl.value:existing.daysTotal||'',
        teacherRemark:rEl?rEl.value.trim():existing.teacherRemark||'',
        htRemark:existing.htRemark||''
      });
      saved++;
    }
    const al=overlay.querySelector('#teacherConductAlert');
    al.style.display='block';al.style.background='#f0fdf4';al.style.color='#166534';al.style.border='1px solid #bbf7d0';
    al.textContent=`✅ Conduct saved for ${saved} learner(s).`;
    setTimeout(()=>overlay.remove(),1800);
  };
}

/* ════════ PARENT ACCOUNTS — ADMIN CRUD ════════ */
let currentParentObj = null;
let parentTerm = 1;

function openAddParentModal(){
  document.getElementById('newParentName').value='';
  document.getElementById('newParentUsername').value='';
  document.getElementById('newParentPw').value='';
  document.getElementById('newParentChildIds').value='';
  document.getElementById('parentChildPreview').style.display='none';
  document.getElementById('parentChildPreviewList').innerHTML='';
  openModal('addParentModal');
}

async function previewParentChildren(){
  const raw=document.getElementById('newParentChildIds').value;
  const ids=raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);
  const wrap=document.getElementById('parentChildPreview');
  const list=document.getElementById('parentChildPreviewList');
  if(!ids.length){list.innerHTML='';wrap.style.display='none';return;}
  let html='';
  for(const id of ids){
    const s=await idbGet('students',id);
    if(s) html+=`<div style="display:flex;align-items:center;gap:8px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:7px;padding:6px 11px;margin-bottom:5px;font-size:13px">
      ${s.photo?`<img src="${s.photo}" style="width:28px;height:34px;object-fit:cover;border-radius:4px;border:1.5px solid var(--navy)">`:'<span style="font-size:18px">🧑</span>'}
      <div><strong style="color:var(--navy)">${s.name}</strong> <span style="color:var(--muted);font-size:12px">(${s.id} · ${s.className})</span></div>
      <span style="margin-left:auto;color:#166534;font-weight:700;font-size:11px">✅ Found</span></div>`;
    else html+=`<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:7px;padding:6px 11px;margin-bottom:5px;font-size:13px;color:var(--red)">❌ ID <strong>${id}</strong> — not found</div>`;
  }
  list.innerHTML=html;
  wrap.style.display='block';
}

async function saveNewParent(){
  const name=document.getElementById('newParentName').value.trim();
  const username=document.getElementById('newParentUsername').value.trim().toLowerCase().replace(/\s+/g,'.');
  const pw=document.getElementById('newParentPw').value;
  const raw=document.getElementById('newParentChildIds').value;
  const childIds=raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);
  if(!name||!username||!pw){showAlert('addParentAlert','Please fill in name, username and password.','error');return;}
  if(pw.length<6){showAlert('addParentAlert','Password must be at least 6 characters.','error');return;}
  if(!childIds.length){showAlert('addParentAlert','Please enter at least one Learner ID.','error');return;}
  const existing=await idbGet('parents',username);
  if(existing){showAlert('addParentAlert','A parent with that username already exists.','error');return;}
  // Validate at least one child exists
  let foundCount=0;
  for(const id of childIds){const s=await idbGet('students',id);if(s)foundCount++;}
  if(!foundCount){showAlert('addParentAlert','None of the Learner IDs were found. Please check and try again.','error');return;}
  const pwHash=await hashPw(pw);
  await idbPut('parents',{username,name,pwHash,childIds});
  closeModal('addParentModal');
  await renderParentList();
  showAlert('transferAlert',`✅ Parent account "${name}" (${username}) created for ${foundCount} learner(s).`);
}

async function openEditParent(username){
  const parent=await idbGet('parents',username);if(!parent)return;
  document.getElementById('editParentOrigUsername').value=username;
  document.getElementById('editParentName').value=parent.name;
  document.getElementById('editParentPw').value='';
  document.getElementById('editParentChildIds').value=(parent.childIds||[]).join(', ');
  openModal('editParentModal');
}

async function saveEditParent(){
  const origUsername=document.getElementById('editParentOrigUsername').value;
  const newName=document.getElementById('editParentName').value.trim();
  const newPw=document.getElementById('editParentPw').value;
  const raw=document.getElementById('editParentChildIds').value;
  const childIds=raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);
  if(!newName){showAlert('editParentAlert','Name is required.','error');return;}
  if(!childIds.length){showAlert('editParentAlert','At least one Learner ID is required.','error');return;}
  const parent=await idbGet('parents',origUsername);
  if(!parent){showAlert('editParentAlert','Account not found.','error');return;}
  if(newPw&&newPw.length<6){showAlert('editParentAlert','New password must be at least 6 characters.','error');return;}
  const updatedParent={...parent,name:newName,childIds};
  if(newPw)updatedParent.pwHash=await hashPw(newPw);
  await idbPut('parents',updatedParent);
  closeModal('editParentModal');
  await renderParentList();
  showAlert('transferAlert',`✅ Parent account "${newName}" updated.`);
}

async function deleteParent(username){
  if(!confirm(`Delete parent account "${username}"? This cannot be undone.`))return;
  await idbDelete('parents',username);
  await renderParentList();
}

async function renderParentList(){
  const parents=await idbGetAll('parents');
  const el=document.getElementById('parentList');if(!el)return;
  if(!parents.length){
    el.innerHTML='<div class="warn-note">⚠️ No parent accounts yet. Create accounts so parents can log in and view their children\'s report cards.</div>';
    return;
  }
  // Load student names for display
  const allStudents=await idbGetAll('students');
  const studentMap=Object.fromEntries(allStudents.map(s=>[s.id,s]));
  el.innerHTML=parents.map(p=>{
    const childNames=(p.childIds||[]).map(id=>{
      const s=studentMap[id];
      return s?`<span style="display:inline-flex;align-items:center;gap:4px;background:#e8effe;border-radius:6px;padding:2px 8px;font-size:11px;font-weight:600;color:var(--navy);margin:2px">${s.name} <span style="color:var(--muted)">(${s.id})</span></span>`
               :`<span style="background:#fef2f2;color:var(--red);border-radius:6px;padding:2px 8px;font-size:11px;font-weight:600;margin:2px">${id} — not found</span>`;
    }).join('');
    return `<div class="teacher-card" style="flex-direction:column;align-items:flex-start;gap:8px">
      <div style="display:flex;width:100%;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <div class="teacher-info">
          <div class="teacher-name">👨‍👩‍👧 ${p.name}</div>
          <div class="teacher-meta">Username: <strong>${p.username}</strong></div>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn btn-outline btn-xs" onclick="openEditParent('${p.username}')">✏️ Edit</button>
          <button class="btn btn-danger btn-xs" onclick="deleteParent('${p.username}')">🗑 Delete</button>
        </div>
      </div>
      <div style="width:100%"><div style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px">Linked Children</div>
      <div style="flex-wrap:wrap;display:flex">${childNames||'<span style="color:var(--muted);font-size:12px">No children linked</span>'}</div></div>
    </div>`;
  }).join('');
}

/* ════════ PARENT LOGIN ════════ */
async function parentLogin(){
  const username=document.getElementById('parentUsername').value.trim().toLowerCase();
  const pw=document.getElementById('parentLoginPw').value;
  if(!username||!pw){showAlert('parentLoginAlert','Please enter your username and password.','error');return;}
  const parent=await idbGet('parents',username);
  if(!parent){showAlert('parentLoginAlert','Incorrect username or password. Please contact the school admin.','error');return;}
  const ok=(await hashPw(pw))===parent.pwHash;
  if(!ok){showAlert('parentLoginAlert','Incorrect username or password.','error');return;}
  saveSession({role:'parent',username:parent.username});
  await openParentDashboard(parent);
}

/* Renders the parent dashboard. Called after password login, or automatically
   on page load when a valid parent session was saved (see restoreSession). */
async function openParentDashboard(parent){
  currentParentObj=parent;
  parentTerm=1;
  // Set academic year from school info
  const info=await idbGet('school','info')||{};
  const yearEl=document.getElementById('parentReportYear');
  yearEl.value=info.academicYear||String(new Date().getFullYear());
  // Reset term pills
  document.querySelectorAll('#parentTermPills .term-pill').forEach((p,i)=>{
    p.classList.toggle('active',i===0);
  });
  // Welcome message
  const allStudents=await idbGetAll('students');
  const studentMap=Object.fromEntries(allStudents.map(s=>[s.id,s]));
  const childNames=(parent.childIds||[]).map(id=>studentMap[id]?.name||id).join(', ');
  document.getElementById('parentWelcome').textContent=`Welcome, ${parent.name}`;
  document.getElementById('parentChildInfo').textContent=`Viewing progress for: ${childNames||'No children linked'}`;
  document.getElementById('parentReportOutput').innerHTML='';
  document.getElementById('parentDownloadWrap').style.display='none';
  switchPage('parent-dashboard');
  renderCircularReadList('parentCircularList');
}

function parentLogout(){
  currentParentObj=null;
  clearSession();
  document.getElementById('parentUsername').value='';
  document.getElementById('parentLoginPw').value='';
  document.getElementById('parentReportOutput').innerHTML='';
  switchPage('parent-gate');
}

function selectParentTermPill(term,btn){
  parentTerm=term;
  document.querySelectorAll('#parentTermPills .term-pill').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
}

/* ════════ PARENT REPORT VIEW ════════ */
async function loadParentReport(){
  if(!currentParentObj){switchPage('parent-gate');return;}
  const year=document.getElementById('parentReportYear').value.trim()||String(new Date().getFullYear());
  const childIds=currentParentObj.childIds||[];
  if(!childIds.length){showAlert('parentReportAlert','No children are linked to your account. Please contact the school admin.','error');return;}

  const [allStudents,allMarks,allPrimaryMarks,info,allConducts]=await Promise.all([
    idbGetAll('students'),idbGetAll('marks'),idbGetAll('primaryMarks'),
    idbGet('school','info'),idbGetAll('conduct')
  ]);
  const school=info||{};
  const studentMap=Object.fromEntries(allStudents.map(s=>[s.id,s]));

  let allHTML='';
  let found=0;

  for(const childId of childIds){
    const student=studentMap[childId];
    if(!student){
      allHTML+=`<div class="card" style="text-align:center;padding:24px;color:var(--muted)">⚠️ Learner ID <strong>${childId}</strong> was not found in the system. Please contact admin.</div>`;
      continue;
    }
    found++;
    const c=allConducts.find(cd=>cd.studentId===childId&&Number(cd.term)===parentTerm&&String(cd.year||'')===String(year))
           ||allConducts.find(cd=>cd.studentId===childId&&Number(cd.term)===parentTerm)||{};
    if(isPrimaryTier(await getClassLevel(student.className))){
      const classStudents=allStudents.filter(s=>s.className===student.className);
      allHTML+=buildPrimaryReportForStudent(student,parentTerm,year,school,classStudents,allPrimaryMarks,c);
      continue;
    }
    const sMarks=allMarks.filter(m=>m.studentId===childId&&Number(m.term)===parentTerm&&inYear(m,year));
    let totalSum=0,rows='';
    sMarks.sort((a,b)=>a.subject.localeCompare(b.subject));
    sMarks.forEach(mark=>{
      totalSum+=Number(mark.total);
      const grade=getGrade(mark.total);
      const actS=markActScaled(mark).toFixed(1);
      rows+=`<tr>
        <td>${mark.subject}</td><td>${mark.a1}</td>
        <td style="font-weight:700;color:#1a3270">${actS}</td>
        <td>${mark.exam}</td>
        <td style="font-weight:800">${mark.total}</td>
        <td style="font-weight:800;color:${gradeColor(getGrade(mark.total))}">${getGrade(mark.total)}</td>
        <td style="font-style:italic;color:${gradeColor(getGrade(mark.total))}">${getComment(getGrade(mark.total))}</td>
        <td style="font-size:7pt;color:#666">${mark.teacher||''}</td>
      </tr>`;
    });
    if(!rows)rows=`<tr><td colspan="10" style="text-align:center;padding:12px;color:#888;font-style:italic">No marks submitted for Term ${parentTerm} yet.</td></tr>`;
    const finalAvg=sMarks.length?(totalSum/sMarks.length).toFixed(1):'0.0';
    const finalGrade=getGrade(finalAvg);
    // Class rank
    const classStudents=allStudents.filter(s=>s.className===student.className);
    const ranked=classStudents.map(s=>{
      const sm=allMarks.filter(m=>m.studentId===s.id&&Number(m.term)===parentTerm&&inYear(m,year));
      return{id:s.id,has:sm.length>0,avg:sm.length?(sm.reduce((a,m)=>a+Number(m.total),0)/sm.length):0};
    }).sort((a,b)=>b.avg-a.avg);
    const _rk=competitionRank(ranked,childId);const rank=_rk.rank;
    const rankStr=rank?`${rank} / ${_rk.total}`:'—';
    const autoTeacher=Number(finalAvg)>=80?'Excellent academic performance this term. Keep up the outstanding work!'
      :Number(finalAvg)>=70?'Good academic progress. Continue working hard to achieve even better results.'
      :Number(finalAvg)>=55?'Satisfactory performance. More effort and dedication is needed next term.'
      :'Needs significant improvement. Please seek extra help and study harder next term.';
    const autoHt=Number(finalAvg)>=70?'Well done! Continue striving for excellence in all subjects.'
      :'More commitment to academics is required. Please work closely with your teachers.';
    const teacherRemark=c.teacherRemark||autoTeacher;
    const htRemark=c.htRemark||autoHt;
    const termOrdinal=['','1st','2nd','3rd'][parentTerm]||`${parentTerm}th`;
    const logoHtml=school.logo?`<img class="rc-logo" src="${school.logo}" alt="Badge">`:`<div class="rc-logo-placeholder">🏫</div>`;
    const photoHtml=student.photo?`<img class="rc-passport" src="${student.photo}" alt="Photo">`:`<div class="rc-passport-placeholder"><span>🧑</span><span style="font-size:7px;color:#aaa">No Photo</span></div>`;
    allHTML+=buildReportHTML(school,student,sMarks,rows,finalAvg,finalGrade,rankStr,classStudents.length,parentTerm,termOrdinal,year,logoHtml,photoHtml,teacherRemark,htRemark,c,totalSum,sMarks.length*100);
  }

  if(!found){showAlert('parentReportAlert','No linked learners found. Please contact the school admin.','error');return;}
  document.getElementById('parentReportOutput').innerHTML=allHTML;
  document.getElementById('parentDownloadWrap').style.display='flex';
  document.getElementById('parentDownloadWrap').style.gap='8px';
}

async function downloadParentPDF(){
  const pages=document.querySelectorAll('#parentReportOutput .a4-page');
  if(!pages.length){showAlert('parentReportAlert','Please generate a report first.','error');return;}
  const btn=document.querySelector('#parentDownloadWrap button');
  const origText=btn.textContent;btn.textContent='⏳ Generating…';btn.disabled=true;
  try{
    const{jsPDF}=window.jspdf;
    const pdf=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
    for(let i=0;i<pages.length;i++){
      const canvas=await captureA4Page(pages[i],2);
      const imgData=canvas.toDataURL('image/jpeg',0.97);
      if(i>0)pdf.addPage();
      pdf.addImage(imgData,'JPEG',0,0,pdf.internal.pageSize.getWidth(),pdf.internal.pageSize.getHeight());
    }
    const childIds=currentParentObj.childIds||[];
    pdf.save(`ReportCard_Term${parentTerm}_${document.getElementById('parentReportYear').value||new Date().getFullYear()}.pdf`);
  }catch(err){alert('PDF failed: '+err.message);}
  btn.textContent=origText;btn.disabled=false;
}

/* ════════ CIRCULARS ════════ */
async function publishCircular(){
  const title=document.getElementById('circularTitle').value.trim();
  const term=Number(document.getElementById('circularTerm').value);
  const year=document.getElementById('circularYear').value.trim()||String(new Date().getFullYear());
  const notes=document.getElementById('circularNotes').value.trim();
  const fileInput=document.getElementById('circularFile');
  const file=fileInput.files[0];
  if(!title){showAlert('circularAlert','Please enter a title for the circular.','error');return;}
  if(!file){showAlert('circularAlert','Please attach a file (PDF or image).','error');return;}

  // Show loading state
  const btn=document.querySelector('[onclick="publishCircular()"]');
  const origText=btn.textContent;btn.textContent='⏳ Uploading…';btn.disabled=true;

  try{
    const fileData=await new Promise((res,rej)=>{
      const reader=new FileReader();
      reader.onload=e=>res(e.target.result);
      reader.onerror=()=>rej(new Error('Could not read file'));
      reader.readAsDataURL(file);
    });
    const circular={
      title,term,year,notes,
      fileName:file.name,
      fileType:file.type,
      fileData,
      publishedAt:new Date().toISOString(),
      publishedBy:'Admin'
    };
    await idbPutCircular(circular);
    document.getElementById('circularTitle').value='';
    document.getElementById('circularNotes').value='';
    fileInput.value='';
    showAlert('circularAlert',`✅ Circular "${title}" published successfully.`);
    await renderCircularAdminList();
  }catch(err){
    showAlert('circularAlert','Failed to publish circular: '+err.message,'error');
  }
  btn.textContent=origText;btn.disabled=false;
}

async function deleteCircular(id){
  if(!confirm('Delete this circular? This cannot be undone.'))return;
  await idbDelete('circulars',id);
  await renderCircularAdminList();
  showAlert('circularAlert','Circular deleted.','error');
}

function circularTermLabel(t){return['','Term 1','Term 2','Term 3'][t]||`Term ${t}`;}

function circularFileIcon(type){
  if(type==='application/pdf')return'📄';
  if(type.startsWith('image/'))return'🖼️';
  return'📎';
}

function openCircularFile(dataUrl,fileName,fileType){
  // Open in new tab
  const win=window.open('','_blank');
  if(fileType==='application/pdf'){
    win.document.write(`<!DOCTYPE html><html><head><title>${fileName}</title></head><body style="margin:0;padding:0;background:#222">
      <embed src="${dataUrl}" type="application/pdf" width="100%" height="100%" style="position:fixed;inset:0">
      </body></html>`);
  } else {
    win.document.write(`<!DOCTYPE html><html><head><title>${fileName}</title></head><body style="margin:0;background:#111;display:flex;align-items:center;justify-content:center;min-height:100vh">
      <img src="${dataUrl}" style="max-width:100%;max-height:100vh;object-fit:contain">
      </body></html>`);
  }
  win.document.close();
}

function downloadCircularFile(dataUrl,fileName){
  const a=document.createElement('a');
  a.href=dataUrl;a.download=fileName;
  document.body.appendChild(a);a.click();document.body.removeChild(a);
}

async function renderCircularAdminList(){
  const circulars=await idbGetAll('circulars');
  const el=document.getElementById('circularAdminList');if(!el)return;
  if(!circulars.length){el.innerHTML='<div class="warn-note">No circulars published yet.</div>';return;}
  // Sort newest first
  circulars.sort((a,b)=>new Date(b.publishedAt)-new Date(a.publishedAt));
  el.innerHTML=circulars.map(c=>{
    const date=new Date(c.publishedAt).toLocaleDateString('en-UG',{day:'numeric',month:'short',year:'numeric'});
    const icon=circularFileIcon(c.fileType);
    return`<div style="display:flex;align-items:flex-start;gap:14px;background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:16px 18px;margin-bottom:10px">
      <div style="font-size:28px;flex-shrink:0">${icon}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;color:var(--navy);font-size:14px">${c.title}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:5px">
          <span class="badge badge-navy">${circularTermLabel(c.term)}</span>
          <span style="font-size:12px;color:var(--muted)">📅 ${date}</span>
          <span style="font-size:12px;color:var(--muted)">🎓 ${c.year}</span>
        </div>
        ${c.notes?`<div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.5">${c.notes}</div>`:''}
        <div style="font-size:11px;color:var(--muted);margin-top:4px">📎 ${c.fileName}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:5px;flex-shrink:0">
        <button class="btn btn-outline btn-xs" onclick="openCircularFile('${c.fileData.replace(/'/g,'\\\'').substring(0,0)}'+circulars_cache[${c.id}],'${c.fileName}','${c.fileType}')">👁 View</button>
        <button class="btn btn-green btn-xs" onclick="downloadCircularFile('${c.fileData.replace(/'/g,'\\\'').substring(0,0)}'+circulars_cache[${c.id}],'${c.fileName}')">⬇️ Download</button>
        <button class="btn btn-danger btn-xs" onclick="deleteCircular(${c.id})">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
  // Store file data in a cache object so inline onclick can access it without huge inline strings
  window.circulars_cache=Object.fromEntries(circulars.map(c=>[c.id,c.fileData]));
  // Re-render with proper onclick using the cache
  el.innerHTML=circulars.map(c=>{
    const date=new Date(c.publishedAt).toLocaleDateString('en-UG',{day:'numeric',month:'short',year:'numeric'});
    const icon=circularFileIcon(c.fileType);
    return`<div style="display:flex;align-items:flex-start;gap:14px;background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:16px 18px;margin-bottom:10px">
      <div style="font-size:28px;flex-shrink:0">${icon}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;color:var(--navy);font-size:14px">${c.title}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:5px">
          <span class="badge badge-navy">${circularTermLabel(c.term)}</span>
          <span style="font-size:12px;color:var(--muted)">📅 ${date}</span>
          <span style="font-size:12px;color:var(--muted)">🎓 ${c.year}</span>
        </div>
        ${c.notes?`<div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.5">${c.notes}</div>`:''}
        <div style="font-size:11px;color:var(--muted);margin-top:4px">📎 ${c.fileName}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:5px;flex-shrink:0">
        <button class="btn btn-outline btn-xs" onclick="openCircularFile(circulars_cache[${c.id}],'${c.fileName.replace(/'/g,"\\'")}','${c.fileType}')">👁 View</button>
        <button class="btn btn-green btn-xs" onclick="downloadCircularFile(circulars_cache[${c.id}],'${c.fileName.replace(/'/g,"\\'")}')">⬇️ Download</button>
        <button class="btn btn-danger btn-xs" onclick="deleteCircular(${c.id})">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}

async function renderCircularReadList(containerId){
  const el=document.getElementById(containerId);if(!el)return;
  const circulars=await idbGetAll('circulars');
  if(!circulars.length){el.innerHTML='<div class="warn-note">No circulars have been published yet. Check back after each term.</div>';return;}
  circulars.sort((a,b)=>new Date(b.publishedAt)-new Date(a.publishedAt));
  window.circulars_cache=Object.fromEntries(circulars.map(c=>[c.id,c.fileData]));
  el.innerHTML=circulars.map(c=>{
    const date=new Date(c.publishedAt).toLocaleDateString('en-UG',{day:'numeric',month:'short',year:'numeric'});
    const icon=circularFileIcon(c.fileType);
    return`<div style="display:flex;align-items:flex-start;gap:14px;background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:16px 18px;margin-bottom:10px">
      <div style="font-size:32px;flex-shrink:0">${icon}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;color:var(--navy);font-size:14px">${c.title}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:5px">
          <span class="badge badge-navy">${circularTermLabel(c.term)}</span>
          <span style="font-size:12px;color:var(--muted)">📅 ${date}</span>
          <span style="font-size:12px;color:var(--muted)">🎓 ${c.year}</span>
        </div>
        ${c.notes?`<div style="margin-top:7px;font-size:13px;color:var(--text);background:#fff;border-left:4px solid var(--gold);border-radius:0 7px 7px 0;padding:8px 12px;line-height:1.6">${c.notes}</div>`:''}
        <div style="font-size:11px;color:var(--muted);margin-top:5px">📎 ${c.fileName}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0">
        <button class="btn btn-primary btn-sm" onclick="openCircularFile(circulars_cache[${c.id}],'${c.fileName.replace(/'/g,"\\'")}','${c.fileType}')">👁 View</button>
        <button class="btn btn-outline btn-sm" onclick="downloadCircularFile(circulars_cache[${c.id}],'${c.fileName.replace(/'/g,"\\'")}')">⬇️ Download</button>
      </div>
    </div>`;
  }).join('');
}

/* ════════ MESSAGES: ADMIN ⇄ TEACHERS ════════ */
let currentAdminMsgTeacher=null;

function renderMsgBubble(m,viewerRole){
  const mine=m.sender===viewerRole;
  const date=new Date(m.timestamp).toLocaleString('en-UG',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});
  const label=m.sender==='admin'?'Admin':(m.senderName||'Teacher');
  return `<div style="align-self:${mine?'flex-end':'flex-start'};max-width:78%">
    <div style="background:${mine?'var(--navy)':'#fff'};color:${mine?'#fff':'var(--text)'};border:1px solid var(--border);border-radius:${mine?'12px 12px 3px 12px':'12px 12px 12px 3px'};padding:9px 13px;font-size:13px;line-height:1.5;white-space:pre-wrap;word-break:break-word">${escapeHtml(m.body)}</div>
    <div style="font-size:10px;color:var(--muted);margin-top:3px;text-align:${mine?'right':'left'}">${label} · ${date}</div>
  </div>`;
}

async function updateAdminMsgBadge(){
  const btn=document.getElementById('adminMsgTabBtn');if(!btn)return;
  const allMsgs=await idbGetAll('messages');
  const unread=allMsgs.filter(m=>m.sender==='teacher'&&!m.readByAdmin).length;
  const existing=btn.querySelector('.msg-unread-badge');
  if(existing)existing.remove();
  if(unread){
    const span=document.createElement('span');
    span.className='msg-unread-badge';
    span.style.cssText='background:#c0392b;color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;margin-left:5px;font-weight:700';
    span.textContent=unread;
    btn.appendChild(span);
  }
}

async function renderAdminMessageTeacherList(){
  const search=(document.getElementById('msgTeacherSearch')?.value||'').toLowerCase();
  const teachers=await idbGetAll('teachers');
  const allMsgs=await idbGetAll('messages');
  const unreadByTeacher={};
  const lastByTeacher={};
  allMsgs.forEach(m=>{
    if(m.sender==='teacher'&&!m.readByAdmin) unreadByTeacher[m.teacherUsername]=(unreadByTeacher[m.teacherUsername]||0)+1;
    if(!lastByTeacher[m.teacherUsername]||new Date(m.timestamp)>new Date(lastByTeacher[m.teacherUsername])) lastByTeacher[m.teacherUsername]=m.timestamp;
  });
  const filtered=teachers.filter(t=>t.name.toLowerCase().includes(search)||t.username.toLowerCase().includes(search))
    .sort((a,b)=>{
      const la=lastByTeacher[a.username],lb=lastByTeacher[b.username];
      if(la&&lb)return new Date(lb)-new Date(la);
      if(la)return -1; if(lb)return 1;
      return a.name.localeCompare(b.name);
    });
  const el=document.getElementById('adminMsgTeacherList');if(!el)return;
  if(!filtered.length){el.innerHTML='<div class="warn-note">No teachers found. Add teachers under the 👩‍🏫 Teachers tab first.</div>';return;}
  el.innerHTML=filtered.map(t=>{
    const unread=unreadByTeacher[t.username]||0;
    const active=currentAdminMsgTeacher===t.username;
    return `<div onclick="openAdminMsgThread('${t.username.replace(/'/g,"\\'")}')" style="cursor:pointer;padding:9px 12px;border-radius:9px;border:1px solid var(--border);background:${active?'var(--navy)':'#fff'};color:${active?'#fff':'var(--text)'};display:flex;justify-content:space-between;align-items:center;gap:8px">
      <div style="min-width:0">
        <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.name}</div>
        <div style="font-size:11px;opacity:0.75">${t.username}</div>
      </div>
      ${unread?`<span class="badge badge-danger" style="flex-shrink:0">${unread}</span>`:''}
    </div>`;
  }).join('');
}

async function openAdminMsgThread(username){
  currentAdminMsgTeacher=username;
  const teacher=await idbGet('teachers',username);
  document.getElementById('adminMsgThreadTitle').textContent=teacher?`💬 ${teacher.name} (${username})`:username;
  document.getElementById('adminMsgComposeWrap').style.display='flex';
  const msgs=await idbGetByIndex('messages','teacherUsername',username);
  let changed=false;
  for(const m of msgs){
    if(m.sender==='teacher'&&!m.readByAdmin){m.readByAdmin=true;await idbPut('messages',m);changed=true;}
  }
  await renderAdminMsgThreadMessages();
  await renderAdminMessageTeacherList();
  if(changed) await updateAdminMsgBadge();
}

async function renderAdminMsgThreadMessages(){
  const el=document.getElementById('adminMsgThread');if(!el||!currentAdminMsgTeacher)return;
  const msgs=(await idbGetByIndex('messages','teacherUsername',currentAdminMsgTeacher)).sort((a,b)=>new Date(a.timestamp)-new Date(b.timestamp));
  el.innerHTML=msgs.length?msgs.map(m=>renderMsgBubble(m,'admin')).join(''):'<div class="warn-note">No messages yet. Say hello 👋</div>';
  el.scrollTop=el.scrollHeight;
}

async function sendAdminMessage(){
  if(!currentAdminMsgTeacher)return;
  const input=document.getElementById('adminMsgInput');
  const body=input.value.trim();
  if(!body)return;
  await idbPutMessage({teacherUsername:currentAdminMsgTeacher,sender:'admin',senderName:'Admin',body,timestamp:new Date().toISOString(),readByAdmin:true,readByTeacher:false});
  input.value='';
  await renderAdminMsgThreadMessages();
  await renderAdminMessageTeacherList();
}

async function renderTeacherMessages(){
  if(!currentTeacherObj)return;
  const el=document.getElementById('teacherMsgThread');if(!el)return;
  const msgs=(await idbGetByIndex('messages','teacherUsername',currentTeacherObj.username)).sort((a,b)=>new Date(a.timestamp)-new Date(b.timestamp));
  el.innerHTML=msgs.length?msgs.map(m=>renderMsgBubble(m,'teacher')).join(''):'<div class="warn-note">No messages yet. Send the admin a note 👋</div>';
  el.scrollTop=el.scrollHeight;
  for(const m of msgs){
    if(m.sender==='admin'&&!m.readByTeacher){m.readByTeacher=true;await idbPut('messages',m);}
  }
}

async function sendTeacherMessage(){
  if(!currentTeacherObj)return;
  const input=document.getElementById('teacherMsgInput');
  const body=input.value.trim();
  if(!body)return;
  await idbPutMessage({teacherUsername:currentTeacherObj.username,sender:'teacher',senderName:currentTeacherObj.name,body,timestamp:new Date().toISOString(),readByAdmin:false,readByTeacher:true});
  input.value='';
  await renderTeacherMessages();
}

/* ════════ MARKS ENTRY: faster, safer typing (works for both secondary and primary sheets) ════════ */
(function(){
  const table=document.getElementById('classTable');if(!table)return;
  const st=document.createElement('style');
  st.textContent='#classTable input.over{border-color:#dc2626!important;background:#fef2f2!important;}';
  document.head.appendChild(st);
  // Capture phase: runs BEFORE the live total is recalculated, so a typo like 85 out of 80
  // is corrected instantly and never produces a wrong total/grade.
  table.addEventListener('input',e=>{
    const inp=e.target;
    if(!inp.matches||!inp.matches('input[type=number]'))return;
    const mx=inp.max!==''?Number(inp.max):null;
    if(inp.value===''){inp.classList.remove('over');return;}
    let v=Number(inp.value);
    if(mx!==null&&v>mx){inp.value=mx;inp.classList.add('over');setTimeout(()=>inp.classList.remove('over'),900);}
    else if(v<0){inp.value=0;}
  },true);
  // Enter jumps to the same column on the next learner (Shift+Enter goes up)
  table.addEventListener('keydown',e=>{
    if(e.key!=='Enter'||!e.target.matches||!e.target.matches('input[type=number]'))return;
    e.preventDefault();
    const row=e.target.closest('tr');
    const next=e.shiftKey?row.previousElementSibling:row.nextElementSibling;
    const cls=[...e.target.classList].find(c=>c!=='over');
    const target=next&&cls&&next.querySelector('.'+cls);
    if(target){target.focus();target.select();}
  });
  // Warn before the browser tab/app is closed or refreshed with unsaved marks
  window.addEventListener('beforeunload',e=>{
    if(typeof marksUnsaved!=='undefined'&&marksUnsaved){e.preventDefault();e.returnValue='';}
  });
})();

/* ════════ PWA INSTALL ════════ */
let _pwaInstallEvent=null;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault();_pwaInstallEvent=e;
  const btn=document.getElementById('installBtn');if(btn)btn.style.display='inline-block';
});
window.addEventListener('appinstalled',()=>{
  _pwaInstallEvent=null;
  const btn=document.getElementById('installBtn');if(btn)btn.style.display='none';
});
async function installPWA(){
  if(!_pwaInstallEvent){
    alert('To install:\n\n📱 Android: tap the 3-dot menu → "Add to Home screen"\n🍎 iPhone: tap Share → "Add to Home Screen"');return;
  }
  _pwaInstallEvent.prompt();
  const{outcome}=await _pwaInstallEvent.userChoice;
  if(outcome==='accepted')_pwaInstallEvent=null;
}

/* ════════ BOOT ════════ */
(async () => {
  try {
    await _openDB();
    // Ask the browser to treat this site's data as permanent (not evictable under storage pressure)
    try{ if(navigator.storage&&navigator.storage.persist) navigator.storage.persist(); }catch(e){}
    document.getElementById('dbOverlay').style.display = 'none';
    const hasHash = await idbGet('school', 'adminPwHash').catch(() => null);
    if (hasHash) document.getElementById('defaultPwHint').style.display = 'none';
    await restoreSession();
  } catch(err) {
    document.getElementById('dbOverlay').querySelector('p').textContent =
      'Database error: ' + err.message + '. Please refresh the page.';
  }
})();

// All functions are already global in a regular script — no exports needed.

</script>
</body>
</html>
