/* ════════ TEACHER ACCOUNTS ════════ */
async function saveNewTeacher(){
  const name=document.getElementById('newTeacherName').value.trim();
  const username=document.getElementById('newTeacherUsername').value.trim().toLowerCase().replace(/\s+/g,'.');
  const pw=document.getElementById('newTeacherPw').value;
  const subjectSel=document.getElementById('newTeacherSubjects');
  const subjects=[...subjectSel.selectedOptions].map(o=>o.value);
  const classSel=document.getElementById('newTeacherClasses');
  const classes=[...classSel.selectedOptions].map(o=>o.value);
  if(!name||!username||!pw){showAlert('addTeacherAlert','Please fill in name, username and password.','error');return;}
  if(pw.length<6){showAlert('addTeacherAlert','Password must be at least 6 characters.','error');return;}
  const existing=await idbGet('teachers',username);
  if(existing){showAlert('addTeacherAlert','A teacher with that username already exists.','error');return;}
  const pwHash=await hashPw(pw);
  await idbPut('teachers',{username,name,pwHash,subjects,classes});
  closeModal('addTeacherModal');
  await renderTeacherList();
  await renderStats();
  showAlert('transferAlert',`✅ Teacher account "${name}" (${username}) created.`);
}

async function deleteTeacher(username){
  if(!confirm(`Delete teacher account "${username}"? This cannot be undone.`))return;
  await idbDelete('teachers',username);
  await renderTeacherList();
  await renderStats();
}

async function openEditTeacher(username){
  const teacher=await idbGet('teachers',username);if(!teacher)return;
  document.getElementById('editTeacherUsername').value=teacher.username;
  document.getElementById('editTeacherName').value=teacher.name;
  await populateSubjectSelects();
  await populateClassSelects();
  const subjSel=document.getElementById('editTeacherSubjects');
  [...subjSel.options].forEach(o=>{o.selected=(teacher.subjects||[]).includes(o.value);});
  const classSel=document.getElementById('editTeacherClasses');
  [...classSel.options].forEach(o=>{o.selected=(teacher.classes||[]).includes(o.value);});
  openModal('editTeacherModal');
}

async function saveEditTeacher(){
  const username=document.getElementById('editTeacherUsername').value;
  const teacher=await idbGet('teachers',username);if(!teacher)return;
  const name=document.getElementById('editTeacherName').value.trim();
  if(!name){showAlert('editTeacherAlert','Please enter a name.','error');return;}
  const subjects=[...document.getElementById('editTeacherSubjects').selectedOptions].map(o=>o.value);
  const classes=[...document.getElementById('editTeacherClasses').selectedOptions].map(o=>o.value);
  teacher.name=name;teacher.subjects=subjects;teacher.classes=classes;
  await idbPut('teachers',teacher);
  closeModal('editTeacherModal');
