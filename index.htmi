    .pr2-tag.green{background:#2e7d32;}
    .pr2-table{width:100%;border-collapse:collapse;font-size:7.8pt;border:1px solid #dde3f0;}
    .pr2-table thead th{background:#0f1f4b;color:#fff;padding:4px 6px;font-size:6.9pt;text-transform:uppercase;letter-spacing:0.2px;text-align:left;}
    .pr2-table thead th:not(:first-child){text-align:center;}
