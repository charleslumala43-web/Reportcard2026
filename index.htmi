    <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Official communications from the school, updated each term.</p>
    <div id="parentCircularList"><div class="warn-note">No circulars have been published yet.</div></div>
  </div>
</div>

</div><!-- container -->

<script>
'use strict';

/* ════════ INDEXEDDB LAYER (fully offline, stored on this device) ════════
   Every function below keeps the exact same name and signature as the
   Firestore version it replaces, so nothing else in this app had to
   change — only WHERE the data lives changed. Data now lives in this
   browser's IndexedDB storage, which works with no internet connection
   at all. The trade-off: it's local to this device/browser only — it
   won't automatically sync between different computers or phones the
   way the cloud version did. Use the app's Excel export/import to move
   data between devices if you need that. */
const DB_NAME = 'schoolpro_v4';
const DB_VERSION = 6;
const STORES = ['school','students','marks','teachers','parents','classes','subjects','conduct','circulars','messages','primaryMarks','attendance','feeStructure','feePayments','bursars'];
// Which field on each record acts as its unique key/document ID, when idbPut is called without an explicit key
const _KEY_FIELD = {students:'id',teachers:'username',parents:'username',classes:'name',subjects:'name',marks:'_key',conduct:'_key',messages:'id',primaryMarks:'_key',attendance:'_key',feeStructure:'_key',feePayments:'id',bursars:'username'};

let _dbInstance = null;

function _openDB() {
  if (_dbInstance) return Promise.resolve(_dbInstance);
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    let settled=false;
    // If another tab/window has this app open on an older database version, the
    // browser blocks this upgrade indefinitely with NO error and NO event —
    // it just silently hangs forever, which looks exactly like "nothing happens"
    // when saving marks or generating a report. This timeout turns that silent
    // hang into a clear, actionable error instead.
    const timeout=setTimeout(()=>{
      if(settled)return;settled=true;
      reject(new Error('Database did not open in time. This usually means another browser tab or window has this app open on an older version. Please close every other tab of this app, then reload this page.'));
    },6000);
    req.onupgradeneeded = (e) => {
      const db = e.target.result;
      STORES.forEach(store => {
        if (!db.objectStoreNames.contains(store)) {
          const keyPath = store === 'school' ? 'k' : (_KEY_FIELD[store] || 'id');
          db.createObjectStore(store, { keyPath });
        }
      });
    };
    req.onblocked = () => {
      console.warn('IndexedDB upgrade blocked by another open tab/window running an older version of this app.');
    };
    req.onsuccess = (e) => {
      if(settled){ // opened after the timeout fired: keep it so it doesn't block later attempts
        if(!_dbInstance){_dbInstance=e.target.result;_dbInstance.onversionchange=()=>{_dbInstance.close();_dbInstance=null;};_dbInstance.onclose=()=>{_dbInstance=null;};}
        else e.target.result.close();
        return;
      }
      settled=true;clearTimeout(timeout);
      _dbInstance = e.target.result;
      _dbInstance.onclose = () => { _dbInstance = null; }; // browser dropped the connection (common on phones under memory pressure)
      // If a newer tab later needs to upgrade the schema further, let this
      // connection close cleanly instead of blocking that future upgrade.
      _dbInstance.onversionchange = () => { _dbInstance.close(); _dbInstance=null; };
      resolve(_dbInstance);
    };
    req.onerror = (e) => { if(settled)return;settled=true;clearTimeout(timeout);reject(e.target.error); };
  });
}

async function idbGet(store, key) {
  const db = await _openDB();
  return new Promise((resolve, reject) => {
    const req = db.transaction(store, 'readonly').objectStore(store).get(String(key));
    req.onsuccess = () => resolve(!req.result ? undefined : (store === 'school' ? req.result.v : req.result));
    req.onerror = () => reject(req.error);
  });
}

async function idbGetAll(store) {
  const db = await _openDB();
  return new Promise((resolve, reject) => {
    const req = db.transaction(store, 'readonly').objectStore(store).getAll();
    req.onsuccess = () => resolve(req.result || []);
    req.onerror = () => reject(req.error);
  });
}

// Runs a write and only resolves once the browser has COMMITTED the transaction
// (tx.oncomplete). The old version resolved on the request's success event, which
// fires before commit — so a failed commit (storage full, connection dropped) still
// looked like a successful save. Also retries once if the connection was closed.
async function _writeTx(store, fn) {
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      const db = await _openDB();
      return await new Promise((resolve, reject) => {
        let result;
        const tx = db.transaction(store, 'readwrite');
        tx.oncomplete = () => resolve(result);
        tx.onerror = () => reject(tx.error || new Error('Database write failed'));
        tx.onabort = () => reject(tx.error || new Error('Database write was cancelled — the device storage may be full'));
        result = fn(tx.objectStore(store));
      });
    } catch (e) {
      if (attempt === 0 && e && (e.name === 'InvalidStateError' || e.name === 'TransactionInactiveError')) { _dbInstance = null; continue; }
      throw e;
    }
  }
}

async function idbPut(store, value, key) {
  let record, docId;
  if (store === 'school') {
    docId = String(key);
    record = { k: docId, v: value };
  } else {
    docId = String(key !== undefined ? key : value[_KEY_FIELD[store]]);
    record = value;
  }
  await _writeTx(store, os => { os.put(record); });
  return docId;
}

async function idbDelete(store, key) {
  await _writeTx(store, os => { os.delete(String(key)); });
}

async function idbGetByIndex(store, indexName, value) {
  // These stores stay small enough (thousands of rows, not millions) that
  // filtering the full set in memory is effectively instant, so no
  // secondary IndexedDB indexes are needed.
  const all = await idbGetAll(store);
  return all.filter(r => r[indexName] === value);
}

async function idbCount(store) {
  const db = await _openDB();
  return new Promise((resolve, reject) => {
    const req = db.transaction(store, 'readonly').objectStore(store).count();
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

async function idbClear(store) {
  await _writeTx(store, os => { os.clear(); });
}

// Bulk-write many records into one store in a single transaction (fast, and all-or-nothing)
async function idbPutMany(store, records) {
  await _writeTx(store, os => { records.forEach(r => os.put(r)); });
}

// Circulars use an incrementing-style id — generated here since IndexedDB has no built-in autoIncrement for this keyPath
async function idbPutCircular(circular) {
  if (!circular.id) circular.id = Date.now();
  await idbPut('circulars', circular);
  return circular.id;
}

// Messages use an incrementing-style id — generated here since IndexedDB has no built-in autoIncrement for this keyPath
async function idbPutMessage(msg) {
  if (!msg.id) msg.id = Date.now();
  await idbPut('messages', msg);
  return msg.id;
}

function escapeHtml(str){
  const div=document.createElement('div');
  div.textContent=str==null?'':String(str);
  return div.innerHTML;
}

/* ════════ STATE ════════ */
let currentTeacherObj = null;

/* ════════ SESSION PERSISTENCE (survives page refresh) ════════
   Only a role + username is stored — never a password — in sessionStorage,
   so the session clears itself when the browser tab is closed but survives
   a plain refresh (F5). */
const SESSION_KEY='schoolpro_session';
function saveSession(obj){ try{ sessionStorage.setItem(SESSION_KEY, JSON.stringify(obj)); }catch(e){} }
function clearSession(){ try{ sessionStorage.removeItem(SESSION_KEY); }catch(e){} }
function loadSession(){ try{ const raw=sessionStorage.getItem(SESSION_KEY); return raw?JSON.parse(raw):null; }catch(e){ return null; } }
async function restoreSession(){
  const session=loadSession();
  if(!session)return;
  try{
    if(session.role==='admin'){
      await openAdminDashboard();
    } else if(session.role==='teacher'){
      const teacher=await idbGet('teachers',session.username);
      if(teacher) await openTeacherDashboard(teacher);
      else clearSession();
    } else if(session.role==='parent'){
      const parent=await idbGet('parents',session.username);
      if(parent) await openParentDashboard(parent);
      else clearSession();
    } else if(session.role==='bursar'){
      const bursar=await idbGet('bursars',session.username);
      if(bursar) await openBursarDashboard(bursar);
      else clearSession();
    }
  }catch(e){
    // If restoring fails for any reason, fall back to the login screens
    clearSession();
  }
}
let currentSubject = '', currentClass = '', currentTerm = 1, currentYear = '', currentClassLevel = 'secondary';
let learnerPage = 1, marksPage = 1;
let marksUnsaved = false;
const PER_PAGE = 50;

/* ════════ CRYPTO HASH ════════ */
function _sha256Fallback(str){
  const K=[0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
  const bytes=Array.from(new TextEncoder().encode(str));
  const bitLen=bytes.length*8;
  bytes.push(0x80);
  while(bytes.length%64!==56)bytes.push(0);
  const hi=Math.floor(bitLen/0x100000000),lo=bitLen>>>0;
  for(let i=3;i>=0;i--)bytes.push((hi>>>(i*8))&255);
  for(let i=3;i>=0;i--)bytes.push((lo>>>(i*8))&255);
  let H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
  const rr=(x,n)=>(x>>>n)|(x<<(32-n));
  for(let off=0;off<bytes.length;off+=64){
    const w=new Array(64);
    for(let i=0;i<16;i++)w[i]=((bytes[off+i*4]<<24)|(bytes[off+i*4+1]<<16)|(bytes[off+i*4+2]<<8)|bytes[off+i*4+3])>>>0;
    for(let i=16;i<64;i++){
      const s0=rr(w[i-15],7)^rr(w[i-15],18)^(w[i-15]>>>3);
      const s1=rr(w[i-2],17)^rr(w[i-2],19)^(w[i-2]>>>10);
      w[i]=(w[i-16]+s0+w[i-7]+s1)>>>0;
    }
    let [a,b,c,d,e,f,g,h]=H;
    for(let i=0;i<64;i++){
      const S1=rr(e,6)^rr(e,11)^rr(e,25),ch=(e&f)^(~e&g);
      const t1=(h+S1+ch+K[i]+w[i])>>>0;
      const S0=rr(a,2)^rr(a,13)^rr(a,22),mj=(a&b)^(a&c)^(b&c);
      const t2=(S0+mj)>>>0;
      h=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b;b=a;a=(t1+t2)>>>0;
    }
    H=[H[0]+a,H[1]+b,H[2]+c,H[3]+d,H[4]+e,H[5]+f,H[6]+g,H[7]+h].map(x=>x>>>0);
  }
  return H.map(x=>x.toString(16).padStart(8,'0')).join('');
}
async function hashPw(pw) {
  // crypto.subtle only exists on https:// or localhost; on plain http:// (e.g. a school LAN address) every login would fail.
  if(window.crypto&&crypto.subtle){
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }
  return _sha256Fallback(pw);
}

/* ════════ CLASS HELPERS ════════ */
const DEFAULT_CLASSES=['S.1 East','S.1 West','S.2 East','S.2 West','S.3 East','S.3 West','S.4 East','S.4 West','S.5 Arts','S.5 Sciences','S.6 Arts','S.6 Sciences'];
const DEFAULT_UPPER_PRIMARY_CLASSES=['P.4','P.5','P.6','P.7'];
const DEFAULT_LOWER_PRIMARY_CLASSES=['P.1','P.2','P.3'];
const DEFAULT_NURSERY_CLASSES=['Baby Class','Middle Class','Top Class'];

// Uganda's primary curriculum is examined on a fixed subject list per tier — schools
// don't pick-and-choose these the way S.3/S.4 electives work. Upper Primary (P.4-P.7)
// is exactly the 4 PLE subjects. Lower Primary (P.1-P.3) and Nursery follow the
// commonly-used subject sets for those levels.
const PRIMARY_UPPER_SUBJECTS=['Mathematics','English','Science','Social Studies'];
const PRIMARY_LOWER_SUBJECTS=['English','Mathematics','Literacy','Religious Education','Music Dance & Drama','Physical Education'];
const NURSERY_SUBJECTS=['Numeracy','Literacy','Reading','Writing','Creative Activities','Environmental Activities'];
const PRIMARY_TIER_SUBJECTS={primary_upper:PRIMARY_UPPER_SUBJECTS,primary_lower:PRIMARY_LOWER_SUBJECTS,nursery:NURSERY_SUBJECTS};
const PRIMARY_TIER_LABELS={primary_upper:'Primary Upper (P.4–P.7)',primary_lower:'Primary Lower (P.1–P.3)',nursery:'Nursery/Baby Class'};

function isPrimaryTier(level){return level==='primary_upper'||level==='primary_lower'||level==='nursery';}

// The subject list for a specific class: the admin's custom per-class list if one has
// been set (via Class Management → 📚 Subjects), otherwise the old defaults — the fixed
// tier list for primary/lower-primary/nursery, or the full master subject list for
// secondary. This lets the admin add whichever subjects he wants to any class, primary
// or secondary, instead of being stuck with the fixed tier sets.
async function getClassSubjects(name){
  const c=await idbGet('classes',name);
  if(c&&c.subjects&&c.subjects.length)return c.subjects;
  const level=await getClassLevel(name);
  if(isPrimaryTier(level))return PRIMARY_TIER_SUBJECTS[level]||[];
  return await getSubjects();
}

async function getClasses(){
  const stored=await idbGetAll('classes');
  if(stored.length) return stored.map(c=>c.name).sort();
  // Seed defaults on first run — secondary, then each primary tier
  for(const name of DEFAULT_CLASSES) await idbPut('classes',{name,level:'secondary'});
  for(const name of DEFAULT_UPPER_PRIMARY_CLASSES) await idbPut('classes',{name,level:'primary_upper'});
  for(const name of DEFAULT_LOWER_PRIMARY_CLASSES) await idbPut('classes',{name,level:'primary_lower'});
  for(const name of DEFAULT_NURSERY_CLASSES) await idbPut('classes',{name,level:'nursery'});
  return [...DEFAULT_CLASSES,...DEFAULT_UPPER_PRIMARY_CLASSES,...DEFAULT_LOWER_PRIMARY_CLASSES,...DEFAULT_NURSERY_CLASSES];
}

// One of: 'secondary' (competency-based A-E), 'primary_upper' (P.4-P.7, D1-F9, 4 core
// subjects), 'primary_lower' (P.1-P.3, D1-F9, lower-primary subjects), or 'nursery'
// (Baby/Middle/Top Class, D1-F9, nursery subjects). Classes saved before this feature
// existed (or with the older single 'primary' value) are treated as 'primary_upper'
// for compatibility, since that was this feature's original scope.
async function getClassLevel(name){
  const c=await idbGet('classes',name);
  if(!c||!c.level)return'secondary';
  if(c.level==='primary')return'primary_upper';
  return c.level;
}

async function populateClassSelects(){
  const classes=await getClasses();
  const opts=classes.map(c=>`<option value="${c}">${c}</option>`).join('');
  ['studentClass','editStudentClass','classSelect'].forEach(id=>{
    const el=document.getElementById(id);
    if(el){const prev=el.value;el.innerHTML=opts;if(prev)el.value=prev;}
  });
  ['newTeacherClasses','editTeacherClasses'].forEach(id=>{
    const multi=document.getElementById(id);
    if(multi){const prevSel=[...multi.selectedOptions].map(o=>o.value);multi.innerHTML=opts;[...multi.options].forEach(o=>{if(prevSel.includes(o.value))o.selected=true;});}
  });
}

async function renderClassManager(){
  const classes=await idbGetAll('classes');
  classes.sort((a,b)=>a.name.localeCompare(b.name));
  const el=document.getElementById('classManagerList');
  if(!el)return;
  const badgeStyle={secondary:'badge-navy',primary_upper:'badge-gold',primary_lower:'badge-green',nursery:'badge-rose'};
  const badgeLabel={secondary:'SECONDARY',primary_upper:'PRIMARY UPPER',primary_lower:'PRIMARY LOWER',nursery:'NURSERY'};
  el.innerHTML=classes.map(c=>{
    const lvl=(c.level==='primary')?'primary_upper':(c.level||'secondary');
    const customCount=(c.subjects&&c.subjects.length)?c.subjects.length:0;
    const subjTag=customCount?`<span class="badge badge-navy" style="font-size:9px;margin-left:6px">${customCount} SUBJECT${customCount===1?'':'S'}</span>`:'';
    const nameEsc=c.name.replace(/'/g,"\\'");
    return `
    <div style="display:flex;align-items:center;justify-content:space-between;background:var(--soft);border:1px solid var(--border);border-radius:9px;padding:9px 14px;margin-bottom:7px;gap:8px;flex-wrap:wrap">
      <span style="font-weight:600;color:var(--navy)">${c.name} <span class="badge ${badgeStyle[lvl]||'badge-navy'}" style="font-size:9px;margin-left:6px">${badgeLabel[lvl]||'SECONDARY'}</span>${subjTag}</span>
      <div style="display:flex;gap:6px">
        <button class="btn btn-outline btn-xs" onclick="openClassSubjectsModal('${nameEsc}')">📚 Subjects</button>
        <button class="btn btn-danger btn-xs" onclick="deleteClass('${nameEsc}')">🗑 Remove</button>
      </div>
    </div>`;
  }).join('');
}

async function addClass(){
  const input=document.getElementById('newClassName');
  const name=input.value.trim();
  const level=document.getElementById('newClassLevel')?document.getElementById('newClassLevel').value:'secondary';
  if(!name){showAlert('classAlert','Please enter a class name.','error');return;}
  const existing=await idbGet('classes',name);
  if(existing){showAlert('classAlert','That class already exists.','error');return;}
  await idbPut('classes',{name,level});
  input.value='';
  await renderClassManager();
  await populateClassSelects();
  await populatePromoteClasses();
  const label=level==='secondary'?'Secondary':(PRIMARY_TIER_LABELS[level]||level);
  showAlert('classAlert',`✅ Class "${name}" added (${label}).`);
}

async function deleteClass(name){
  const students=await idbGetByIndex('students','className',name);
  if(students.length){
    if(!confirm(`"${name}" has ${students.length} learner(s). Remove class anyway? Learners will not be deleted.`))return;
  }
  await idbDelete('classes',name);
  await renderClassManager();
  await populateClassSelects();
  await populatePromoteClasses();
  showAlert('classAlert',`Class "${name}" removed.`,'error');
}

// Opens the per-class subject picker: every master subject as a checkbox, pre-ticked
// with whatever this class already has saved (falling back to the level's standard
// defaults so the admin has a sensible starting point, not a blank list).
async function openClassSubjectsModal(className){
  const c=await idbGet('classes',className);
  if(!c){showAlert('classAlert','That class could not be found.','error');return;}
  document.getElementById('classSubjectsModalClassKey').value=className;
  document.getElementById('classSubjectsModalClassName').textContent=className;
  document.getElementById('classSubjectsNewName').value='';
  await renderClassSubjectsCheckboxes(c.subjects&&c.subjects.length?c.subjects:await getClassSubjects(className));
  document.getElementById('classSubjectsAlert').innerHTML='';
  openModal('classSubjectsModal');
}

async function renderClassSubjectsCheckboxes(ticked){
  const allSubjects=await getSubjects();
  const tickedSet=new Set(ticked||[]);
  const box=document.getElementById('classSubjectsCheckboxes');
  box.innerHTML=allSubjects.map(s=>`
    <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:500;color:var(--text);cursor:pointer">
      <input type="checkbox" value="${s.replace(/"/g,'&quot;')}" ${tickedSet.has(s)?'checked':''} style="width:auto;margin:0">${s}
    </label>`).join('');
}

// Quick-add lets the admin invent a brand-new subject right from the class modal,
// instead of having to leave and use the separate Subject Management card first.
async function addSubjectFromClassModal(){
  const input=document.getElementById('classSubjectsNewName');
  const name=input.value.trim();
  if(!name){showAlert('classSubjectsAlert','Please enter a subject name.','error');return;}
  const existing=await idbGet('subjects',name);
  if(!existing)await idbPut('subjects',{name});
  input.value='';
  const currentlyChecked=[...document.querySelectorAll('#classSubjectsCheckboxes input[type=checkbox]:checked')].map(b=>b.value);
  await renderClassSubjectsCheckboxes([...currentlyChecked,name]);
  await populateSubjectSelects();
  showAlert('classSubjectsAlert',`✅ "${name}" added and ticked.`);
}

async function saveClassSubjects(){
  const className=document.getElementById('classSubjectsModalClassKey').value;
  const c=await idbGet('classes',className);
  if(!c){showAlert('classSubjectsAlert','That class could not be found.','error');return;}
  const chosen=[...document.querySelectorAll('#classSubjectsCheckboxes input[type=checkbox]:checked')].map(b=>b.value);
  c.subjects=chosen; // empty array = fall back to the level's standard defaults
  await idbPut('classes',c);
  closeModal('classSubjectsModal');
  await renderClassManager();
  showAlert('classAlert',`✅ Subjects updated for "${className}".`);
}

/* ════════ SUBJECT HELPERS ════════ */
const DEFAULT_SUBJECTS=[
  'Mathematics','English Language','Literature in English',
  'Luganda','Kiswahili','Arabic','French',
  'Physics','Chemistry','Biology',
  'Agriculture','Sub-Mathematics',
  'History','Geography',
  'Christian Religious Education (CRE)','Islamic Religious Education (IRE)',
  'Divinity','Economics','Commerce',
  'Accounting','Entrepreneurship',
  'Computer Studies','Fine Art','Music',
  'Physical Education (PE)','Design & Technology (DIT)',
  'Technical Drawing','Food & Nutrition','Home Economics',
  'Projects',
  // Uganda primary-tier subjects (Upper Primary, Lower Primary, Nursery)
  'English','Science','Social Studies','Literacy','Religious Education',
  'Music Dance & Drama','Numeracy','Reading','Writing',
  'Creative Activities','Environmental Activities'
];

async function getSubjects(){
  const stored=await idbGetAll('subjects');
  if(stored.length) return stored.map(s=>s.name).sort();
  // Seed defaults on first run
  for(const name of DEFAULT_SUBJECTS) await idbPut('subjects',{name});
  return [...DEFAULT_SUBJECTS].sort();
}

async function populateSubjectSelects(){
  const subjects=await getSubjects();
  const opts=subjects.map(s=>`<option value="${s}">${s}</option>`).join('');
  ['newTeacherSubjects','editTeacherSubjects'].forEach(id=>{
    const multi=document.getElementById(id);
    if(multi){const prevSel=[...multi.selectedOptions].map(o=>o.value);multi.innerHTML=opts;[...multi.options].forEach(o=>{if(prevSel.includes(o.value))o.selected=true;});}
  });
}

async function renderSubjectManager(){
  const subjects=await getSubjects();
  const el=document.getElementById('subjectManagerList');
  if(!el)return;
  el.innerHTML=subjects.map(s=>`
    <div style="display:flex;align-items:center;justify-content:space-between;background:var(--soft);border:1px solid var(--border);border-radius:9px;padding:9px 14px;margin-bottom:7px">
      <span style="font-weight:600;color:var(--navy)">${s}</span>
      <button class="btn btn-danger btn-xs" onclick="deleteSubject('${s.replace(/'/g,"\\'")}')">🗑 Remove</button>
    </div>`).join('');
}

async function addSubject(){
  const input=document.getElementById('newSubjectName');
  const name=input.value.trim();
  if(!name){showAlert('subjectAlert','Please enter a subject name.','error');return;}
  const existing=await idbGet('subjects',name);
  if(existing){showAlert('subjectAlert','That subject already exists.','error');return;}
  await idbPut('subjects',{name});
  input.value='';
  await renderSubjectManager();
  await populateSubjectSelects();
  showAlert('subjectAlert',`✅ Subject "${name}" added.`);
}

async function deleteSubject(name){
  const teachers=await idbGetAll('teachers');
  const inUse=teachers.filter(t=>t.subjects&&t.subjects.includes(name));
  if(inUse.length){
    if(!confirm(`"${name}" is assigned to ${inUse.length} teacher(s). Remove subject anyway? Teacher assignments will not be changed.`))return;
  }
  await idbDelete('subjects',name);
  // Also drop it from any class's custom subject list, so classes never keep a
  // subject the admin no longer wants to exist anywhere.
  const classes=await idbGetAll('classes');
  for(const c of classes){
    if(c.subjects&&c.subjects.includes(name)){
      c.subjects=c.subjects.filter(s=>s!==name);
      await idbPut('classes',c);
    }
  }
  await renderSubjectManager();
  await populateSubjectSelects();
  await renderClassManager();
  showAlert('subjectAlert',`Subject "${name}" removed.`,'error');
}

/* ════════ S.3 / S.4 SUBJECT COMBINATION RULES ════════ */
// S.3 and S.4 learners take 7 compulsory subjects + exactly 2 chosen electives = 9 total.
const S3S4_COMPULSORY_SUBJECTS=['Mathematics','English Language','Physics','Chemistry','Biology','History','Geography'];
const S3S4_ELECTIVE_COUNT=2;

function isS3orS4(className){
  return /^S\.?3\b|^S\.?4\b/.test((className||'').trim());
}

async function getElectiveOptions(){
  const all=await getSubjects();
  return all.filter(s=>!S3S4_COMPULSORY_SUBJECTS.includes(s));
}

/* S.1 / S.2: CRE and IRE are alternatives — each learner takes ONE of them. */
const RE_CRE='Christian Religious Education (CRE)';
const RE_IRE='Islamic Religious Education (IRE)';
function isS1orS2(className){
  return /^S\.?\s*[12](?!\d)/i.test((className||'').trim());   // matches "S.1 North", "S.1North", "S1 East"
}
// Keeps only the learners who actually take this subject (S.1/S.2 CRE/IRE). Other subjects/classes are untouched.
function filterByReligion(students,className,subject){
  if(!isS1orS2(className))return students;
  if(subject===RE_CRE)return students.filter(s=>s.religion==='CRE');
  if(subject===RE_IRE)return students.filter(s=>s.religion==='IRE');
  return students;
}
// True if this is an S.1/S.2 learner who hasn't chosen CRE or IRE yet.
function studentNeedsReligion(student){
  return isS1orS2(student.className)&&student.religion!=='CRE'&&student.religion!=='IRE';
}
// True if this is an S.3/S.4 learner who hasn't had their exactly-2 electives set yet (or an S.1/S.2 learner who hasn't picked CRE/IRE).
function studentNeedsElectives(student){
  if(studentNeedsReligion(student))return true;
  if(!isS3orS4(student.className))return false;
  const electives=(student.registeredSubjects||[]).filter(s=>!S3S4_COMPULSORY_SUBJECTS.includes(s));
  return electives.length!==S3S4_ELECTIVE_COUNT;
}

// A student's full effective subject list: compulsories + electives if S.3/S.4, otherwise whatever was registered (or all, if none set — for non-S.3/S.4 classes).
function effectiveSubjects(student){
  if(isS3orS4(student.className)){
    const electives=(student.registeredSubjects||[]).filter(s=>!S3S4_COMPULSORY_SUBJECTS.includes(s));
    return [...S3S4_COMPULSORY_SUBJECTS,...electives];
  }
  return student.registeredSubjects&&student.registeredSubjects.length?student.registeredSubjects:null; // null = no restriction
}

// Renders the compulsory/elective subject picker into wrapId, based on the class currently selected in classSelectId.
// If preselect is true, pulls existing electives from the student being edited (via window._editingElectives).
async function renderSubjectCombo(classSelectId,wrapId,preselect){
  const cls=document.getElementById(classSelectId).value;
  const wrap=document.getElementById(wrapId);
  if(isS1orS2(cls)){
    const cur=(preselect&&window._editingReligion)?window._editingReligion:'';
    wrap.style.display='block';
    wrap.innerHTML=`
    <div class="info-note" style="margin-top:0">🙏 In S.1/S.2 a learner takes <strong>either CRE or IRE</strong> — not both.</div>
    <div class="form-group">
      <label>Religious Education</label>
      <select id="${wrapId}_religion">
        <option value="">— Select CRE or IRE —</option>
        <option value="CRE" ${cur==='CRE'?'selected':''}>Christian Religious Education (CRE)</option>
        <option value="IRE" ${cur==='IRE'?'selected':''}>Islamic Religious Education (IRE)</option>
      </select>
    </div>`;
    return;
  }
  if(!isS3orS4(cls)){wrap.style.display='none';wrap.innerHTML='';return;}
  const electiveOptions=await getElectiveOptions();
  const existing=(preselect&&window._editingElectives)?window._editingElectives:[];
  wrap.style.display='block';
  wrap.innerHTML=`
    <div class="info-note" style="margin-top:0">📘 S.3/S.4 take <strong>${S3S4_COMPULSORY_SUBJECTS.length} compulsory subjects</strong> plus exactly <strong>${S3S4_ELECTIVE_COUNT} chosen electives</strong> (9 total).</div>
    <div class="form-group">
      <label>Compulsory Subjects</label>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        ${S3S4_COMPULSORY_SUBJECTS.map(s=>`<span class="badge badge-navy" style="font-size:11px">${s}</span>`).join('')}
      </div>
    </div>
    <div class="form-group">
      <label>Choose exactly ${S3S4_ELECTIVE_COUNT} Electives</label>
      <div id="${wrapId}_electives" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;max-height:160px;overflow-y:auto;border:1.5px solid var(--border);border-radius:9px;padding:10px;background:var(--soft)">
        ${electiveOptions.map(s=>`<label style="display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:500;color:var(--text);cursor:pointer">
          <input type="checkbox" value="${s.replace(/"/g,'&quot;')}" ${existing.includes(s)?'checked':''} onchange="enforceElectiveLimit('${wrapId}_electives')" style="width:auto;margin:0">${s}
        </label>`).join('')}
      </div>
      <div id="${wrapId}_electiveCount" style="font-size:11px;color:var(--muted);margin-top:5px"></div>
    </div>`;
  enforceElectiveLimit(`${wrapId}_electives`);
}

// Disables remaining checkboxes once S3S4_ELECTIVE_COUNT are checked; shows a running count.
function enforceElectiveLimit(containerId){
  const container=document.getElementById(containerId);if(!container)return;
  const boxes=[...container.querySelectorAll('input[type=checkbox]')];
  const checked=boxes.filter(b=>b.checked);
  boxes.forEach(b=>{if(!b.checked)b.disabled=checked.length>=S3S4_ELECTIVE_COUNT;});
  const countEl=document.getElementById(containerId.replace('_electives','_electiveCount'));
  if(countEl)countEl.textContent=`${checked.length} of ${S3S4_ELECTIVE_COUNT} selected`+(checked.length<S3S4_ELECTIVE_COUNT?' — pick '+(S3S4_ELECTIVE_COUNT-checked.length)+' more':'');
}

// Reads the CRE/IRE choice from a combo wrap ('' if none / not S.1-S.2).
function readReligion(wrapId){
  const el=document.getElementById(`${wrapId}_religion`);
  return el?el.value:'';
}

// Reads the checked electives from a combo wrap; returns null if the class isn't S.3/S.4 (no restriction applies).
function readElectives(wrapId){
  const container=document.getElementById(`${wrapId}_electives`);
  if(!container)return null;
  return [...container.querySelectorAll('input[type=checkbox]:checked')].map(b=>b.value);
}

/* ════════ PAGE / TAB SWITCHING ════════ */
function switchPage(id){
  document.querySelectorAll('.page').forEach(p=>{p.classList.remove('active');});
  const el=document.getElementById(id);
  if(el){el.classList.remove('hidden');el.classList.add('active');}
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  if(id.startsWith('admin'))document.querySelectorAll('.tab-btn')[0].classList.add('active');
  if(id.startsWith('teacher'))document.querySelectorAll('.tab-btn')[1].classList.add('active');
  if(id.startsWith('parent'))document.querySelectorAll('.tab-btn')[2].classList.add('active');
  if(id.startsWith('bursar'))document.querySelectorAll('.tab-btn')[3].classList.add('active');
  document.getElementById('logoutBtn').style.display=id==='admin-dashboard'?'inline-block':'none';
}

function switchAdminTab(tabId){
  document.querySelectorAll('.admin-section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.admin-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById(tabId).classList.add('active');
  event.target.classList.add('active');
  if(tabId==='tab-students')renderPromotePanel();
  if(tabId==='tab-analytics')renderAnalytics();
  if(tabId==='tab-attendance')renderAttendanceTab();
  if(tabId==='tab-bursars')renderBursarList();
  if(tabId==='tab-parents')renderParentList();
  if(tabId==='tab-circulars'){renderCircularAdminList();}
  if(tabId==='tab-messages'){renderAdminMessageTeacherList();}
}

function logoutAdmin(){clearSession();switchPage('admin-gate');document.getElementById('adminPassword').value='';}

function selectTermPill(term,btn){
  currentTerm=term;
  document.querySelectorAll('#teacherTermPills .term-pill').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
}

/* ════════ MODALS ════════ */
function openModal(id){document.getElementById(id).classList.add('open');}
function closeModal(id){document.getElementById(id).classList.remove('open');}
document.querySelectorAll('.modal-overlay').forEach(o=>{o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('open');});});

/* ════════ GRADING ════════ */
// A mark belongs to a report if it is for that year (older marks saved before years existed still count)
function inYear(m,year){return !m.year||String(m.year)===String(year);}

function getGrade(avg){
  avg=Number(avg);
  if(avg>=80)return'A';if(avg>=70)return'B';
  if(avg>=55)return'C';if(avg>=45)return'D';return'E';
}
function gradeColor(g){return{A:'#16a34a',B:'#1d4ed8',C:'#d97706',D:'#ea580c',E:'#dc2626'}[g]||'#dc2626';}
function gradeBadgeClass(g){return{A:'badge-a',B:'badge-b',C:'badge-c',D:'badge-d',E:'badge-e'}[g]||'badge-e';}
function getComment(g){return{A:'Accomplished',B:'Outstanding',C:'Moderate',D:'Basic',E:'Elementary'}[g]||'—';}

function calcActivitiesScaled(a1){return(Number(a1)/3)*20;}
function calcTotal(a1,exam){return(calcActivitiesScaled(a1)+Number(exam)).toFixed(1);}
// Uses the stored /20 value (keeps older records intact); otherwise scales the single activity A1 (/3) to /20
function xlsxMissing(alertId){
  if(typeof XLSX!=='undefined')return false;
  showAlert(alertId,'⚠️ Excel support did not load. Put the "libs" folder (with xlsx.full.min.js) next to this app file, or open the app once with internet, then try again.','error');
  return true;
}
function markActScaled(m){return(m.actScaled!==undefined&&m.actScaled!==null&&m.actScaled!=='')?Number(m.actScaled):(Number(m.a1||0)/3)*20;}

/* ════════ PRIMARY (UGANDA PLE-STYLE) GRADING ════════
   Used for classes marked level:'primary' in Class Management. Distinct from
   the A-E competency-based scale above, this mirrors the D1-F9 scale used on
   Uganda primary school report cards, with aggregates and division bands. */
function getPrimaryGrade(score){
  score=Number(score);
  if(score>=80)return'D1';if(score>=75)return'D2';
  if(score>=65)return'C3';if(score>=60)return'C4';
  if(score>=55)return'C5';if(score>=50)return'C6';
  if(score>=40)return'P7';if(score>=30)return'P8';
  return'F9';
}
const PRIMARY_GRADE_POINTS={D1:1,D2:2,C3:3,C4:4,C5:5,C6:6,P7:7,P8:8,F9:9};
function primaryGradeColor(g){
  const pts=PRIMARY_GRADE_POINTS[g]||9;
  if(pts<=2)return'#166534';if(pts<=4)return'#1d4ed8';
  if(pts<=6)return'#b45309';return'#b91c1c';
}
function getPrimaryComment(g){
  return{D1:'Excellent!',D2:'Very Good.',C3:'Good Work.',C4:'Fairly Good.',C5:'Satisfactory.',C6:'Fair, work harder.',P7:'Needs Improvement.',P8:'Below Average.',F9:'Poor, needs urgent attention.'}[g]||'—';
}
// Standard Uganda PLE division bands, based on the aggregate of the 4 core subjects.
function getPrimaryDivision(aggregate){
  if(aggregate<=12)return'I';if(aggregate<=23)return'II';
  if(aggregate<=29)return'III';if(aggregate<=34)return'IV';
  return'U';
}
// The 4 subjects PLE aggregate is officially based on. If a learner has more
// subjects than this, only these 4 (or, if any are missing, the learner's best
// 4 by grade) count toward the aggregate/division — extra subjects still show
// on the report but don't affect it, same as the real PLE.
const PLE_CORE_SUBJECTS=['Mathematics','English','Science','Social Studies'];
function computePrimaryAggregate(subjectGrades){
  // subjectGrades: [{subject, grade}]
  let core=subjectGrades.filter(sg=>PLE_CORE_SUBJECTS.includes(sg.subject));
  const chosen=core.length>=4?core.slice(0,4):[...subjectGrades].sort((a,b)=>PRIMARY_GRADE_POINTS[a.grade]-PRIMARY_GRADE_POINTS[b.grade]).slice(0,4);
  const aggregate=chosen.reduce((sum,sg)=>sum+(PRIMARY_GRADE_POINTS[sg.grade]||9),0);
  return{aggregate,division:getPrimaryDivision(aggregate)};
}

/* Competition ranking: equal averages (to 1 d.p., as printed) share a rank; learners with no marks are not ranked or counted. */
function competitionRank(ranked,id){
  const r1=v=>Math.round(v*10)/10;
  const scored=ranked.filter(x=>x.has);
  const me=scored.find(x=>x.id===id);
  if(!me)return{rank:0,total:scored.length};
  return{rank:1+scored.filter(x=>r1(x.avg)>r1(me.avg)).length,total:scored.length};
}

/* ════════ ALERTS ════════ */
function showAlert(id,msg,type='success'){
  const el=document.getElementById(id);if(!el)return;
  el.className=`alert alert-${type} show`;
  el.innerHTML=(type==='success'?'✅ ':type==='info'?'ℹ️ ':'❌ ')+msg;
  setTimeout(()=>el.classList.remove('show'),5000);
}

/* ════════ IMAGE HELPERS ════════ */
function compressImage(file,maxW,maxH,quality=0.82){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onerror=()=>reject(new Error('Could not read file.'));
    reader.onload=e=>{
      const img=new Image();
      img.onerror=()=>reject(new Error('Could not load image.'));
      img.onload=()=>{
        let w=img.width,h=img.height;
        if(w>maxW||h>maxH){const r=Math.min(maxW/w,maxH/h);w=Math.round(w*r);h=Math.round(h*r);}
        const canvas=document.createElement('canvas');
        canvas.width=w;canvas.height=h;
        canvas.getContext('2d').drawImage(img,0,0,w,h);
        resolve(canvas.toDataURL('image/jpeg',quality));
      };
      img.src=e.target.result;
    };
    reader.readAsDataURL(file);
  });
}
function kb(dataUrl){return Math.round(dataUrl.length*0.75/1024);}

function previewImage(input,wrapId,imgId,sizeId,maxW,maxH){
  const file=input.files[0];
  const wrap=document.getElementById(wrapId);
  if(!file){wrap.style.display='none';return;}
  compressImage(file,maxW,maxH,0.85).then(dataUrl=>{
    document.getElementById(imgId).src=dataUrl;
    const sz=kb(dataUrl);
    const sizeEl=document.getElementById(sizeId);
    sizeEl.innerHTML=`✅ Ready — ~${sz} KB`;
    sizeEl.style.color=sz>300?'var(--red)':'var(--green)';
    wrap.style.display='flex';
    input._compressed=dataUrl;
  }).catch(err=>{wrap.style.display='none';input._compressed=null;alert('Image error: '+err.message);});
}
function removeLogo(){
  const inp=document.getElementById('schoolLogo');
  inp.value='';inp._compressed=null;
  document.getElementById('logoPreview').style.display='none';
  idbGet('school','info').then(info=>{if(info){info.logo='';idbPut('school',info,'info');}});
  showAlert('schoolAlert','School logo removed.','error');
}

/* ════════ ADMIN LOGIN ════════ */
async function loginAdmin(){
  const pw=document.getElementById('adminPassword').value;
  const storedHash=await idbGet('school','adminPwHash');
  // Legacy plain-text upgrade path
  const storedPlain=await idbGet('school','adminPw');
  let ok=false;
  if(storedHash){
    ok=(await hashPw(pw))===storedHash;
  } else if(storedPlain){
    ok=pw===storedPlain;
    if(ok){await idbPut('school',await hashPw(pw),'adminPwHash');await idbDelete('school','adminPw');}
  } else {
    ok=pw==='admin123';
    if(ok) await idbPut('school',await hashPw('admin123'),'adminPwHash');
  }
  if(!ok){showAlert('adminAlert','Incorrect password.','error');return;}
  saveSession({role:'admin'});
  await openAdminDashboard();
}

/* Renders the admin dashboard. Called after password login, or automatically
   on page load when a valid admin session was saved (see restoreSession). */
async function openAdminDashboard(){
  const info=await idbGet('school','info')||{};
  if(info.name)document.getElementById('schoolName').value=info.name;
  if(info.motto)document.getElementById('schoolMotto').value=info.motto;
  if(info.contact)document.getElementById('schoolContact').value=info.contact;
  if(info.nextTermOpens)document.getElementById('nextTermOpens').value=info.nextTermOpens;
  if(info.nextTermFees)document.getElementById('nextTermFees').value=info.nextTermFees;
  if(info.logo){
    document.getElementById('logoPreviewImg').src=info.logo;
    document.getElementById('logoPreviewSize').innerHTML=`✅ Saved — ~${kb(info.logo)} KB`;
    document.getElementById('logoPreviewSize').style.color='var(--green)';
    document.getElementById('logoPreview').style.display='flex';
  }
  document.getElementById('reportYear').value=new Date().getFullYear();
  document.getElementById('currentAcademicYear').value=info.academicYear||new Date().getFullYear();
  await populateClassSelects();
  await renderClassManager();
  await populatePromoteClasses();
  await populateSubjectSelects();
  await renderSubjectManager();
  await renderStats();
  await renderLearnerTable();
  await renderAdminMarks();
  await loadReportStudents();
  await populateClassFilters();
  await renderTeacherList();
  await renderParentList();
  await updateAdminMsgBadge();
  await updateBackupStatusLine();
  autoGenerateStudentId();
  switchPage('admin-dashboard');
}

/* ════════ CHANGE PASSWORD ════════ */
async function changePassword(){
  const current=document.getElementById('currentPw').value;
  const newPw=document.getElementById('newPw').value;
  const confirm=document.getElementById('confirmPw').value;
  const storedHash=await idbGet('school','adminPwHash');
  const storedPlain=await idbGet('school','adminPw');
  let ok=false;
  if(storedHash) ok=(await hashPw(current))===storedHash;
  else if(storedPlain) ok=current===storedPlain;
  else ok=current==='admin123';
  if(!current||!newPw||!confirm){showAlert('pwAlert','Please fill in all three fields.','error');return;}
  if(!ok){showAlert('pwAlert','Current password is incorrect.','error');return;}
  if(newPw.length<6){showAlert('pwAlert','New password must be at least 6 characters.','error');return;}
  if(newPw!==confirm){showAlert('pwAlert','New passwords do not match.','error');return;}
  await idbPut('school',await hashPw(newPw),'adminPwHash');
  if(storedPlain) await idbDelete('school','adminPw');
  document.getElementById('currentPw').value='';
  document.getElementById('newPw').value='';
  document.getElementById('confirmPw').value='';
  showAlert('pwAlert','Password updated successfully.');
}

/* ════════ STATS ════════ */
async function renderStats(){
  const [sCount,mCount,tCount,marks,classes]=await Promise.all([
    idbCount('students'),idbCount('marks'),idbCount('teachers'),
    idbGetAll('marks'),getClasses()
  ]);
  const cls=classes.length;
  const subjs=new Set(marks.map(m=>m.subject)).size;
  const passCount=marks.filter(m=>Number(m.total)>=45).length;
  const passRate=mCount?Math.round(passCount/mCount*100):0;
  document.getElementById('statCards').innerHTML=`
    <div class="stat-card"><div class="stat-icon blue">👤</div><div><div class="stat-val">${sCount}</div><div class="stat-lbl">Registered Learners</div></div></div>
    <div class="stat-card"><div class="stat-icon gold">📚</div><div><div class="stat-val">${cls}</div><div class="stat-lbl">Active Classes</div></div></div>
    <div class="stat-card"><div class="stat-icon green">📝</div><div><div class="stat-val">${mCount}</div><div class="stat-lbl">Mark Entries</div></div></div>
    <div class="stat-card"><div class="stat-icon purple">🎓</div><div><div class="stat-val">${subjs}</div><div class="stat-lbl">Subjects Assessed</div></div></div>
    <div class="stat-card"><div class="stat-icon teal">👩‍🏫</div><div><div class="stat-val">${tCount}</div><div class="stat-lbl">Teacher Accounts</div></div></div>
    <div class="stat-card"><div class="stat-icon ${passRate>=50?'green':'red'}">✅</div><div><div class="stat-val">${passRate}%</div><div class="stat-lbl">Overall Pass Rate</div></div></div>`;
}

