<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>LUMA@ Pro School Manager — Uganda v4.0</title>
<script>
(function(){
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="100" fill="#0f1f4b"/><rect x="60" y="60" width="392" height="392" rx="70" fill="#1a3270"/><text x="256" y="310" font-size="220" text-anchor="middle" font-family="serif" fill="#c9952a">S</text><rect x="80" y="380" width="352" height="30" rx="8" fill="#c9952a" opacity="0.7"/></svg>`;
  const svgUrl='data:image/svg+xml,'+encodeURIComponent(svg);
  const manifest={name:'LUMA@ Pro School Manager',short_name:'LUMA@ Pro',description:'Uganda school marks & report card manager',start_url:location.href,display:'standalone',orientation:'portrait-primary',background_color:'#0f1f4b',theme_color:'#0f1f4b',icons:[{src:svgUrl,sizes:'192x192',type:'image/svg+xml',purpose:'any maskable'},{src:svgUrl,sizes:'512x512',type:'image/svg+xml',purpose:'any maskable'}]};
  const manifestBlob=new Blob([JSON.stringify(manifest)],{type:'application/manifest+json'});
  const mLink=document.createElement('link');mLink.rel='manifest';mLink.href=URL.createObjectURL(manifestBlob);
  document.currentScript.parentNode.appendChild(mLink);
  const aLink=document.createElement('link');aLink.rel='apple-touch-icon';aLink.href=svgUrl;
  document.currentScript.parentNode.appendChild(aLink);
  if('serviceWorker' in navigator){
    const swCode=`const CACHE_NAME='schoolpro-v5-0-firebase';const CORE=[self.location.href,'libs/html2canvas.min.js','libs/jspdf.umd.min.js','libs/xlsx.full.min.js'];self.addEventListener('install',e=>{e.waitUntil(caches.open(CACHE_NAME).then(c=>c.addAll(CORE.map(u=>new Request(u,{cache:'reload'}))).catch(()=>c.add(self.location.href))));self.skipWaiting();});self.addEventListener('activate',e=>{e.waitUntil(caches.keys().then(ks=>Promise.all(ks.filter(k=>k!==CACHE_NAME).map(k=>caches.delete(k)))));self.clients.claim();});self.addEventListener('fetch',e=>{if(e.request.method!=='GET')return;e.respondWith(caches.match(e.request).then(cached=>{if(cached)return cached;return fetch(e.request).then(r=>{if(!r||r.status!==200||r.type==='opaque')return r;caches.open(CACHE_NAME).then(c=>c.put(e.request,r.clone()));return r;}).catch(()=>cached);}));});`;
    const swBlob=new Blob([swCode],{type:'text/javascript'});
    navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(()=>{});
  }
})();
</script>
<meta name="theme-color" content="#0f1f4b">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="LUMA@ Pro">
<script src="libs/html2canvas.min.js" onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';"></script>
<script src="libs/jspdf.umd.min.js" onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';"></script>
<script src="libs/xlsx.full.min.js" onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';"></script>
<script src="libs/tesseract.min.js" onerror="this.onerror=null;this.src='https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/4.1.1/tesseract.min.js';"></script>
<style>
:root{
  --navy:#0f1f4b;--navy-mid:#1a3270;--gold:#c9952a;--gold-light:#f0c96a;
  --soft:#f4f7ff;--border:#dde3f0;--red:#b22222;--green:#2e7d32;
  --text:#1a1a2e;--muted:#6b7497;--white:#ffffff;
  --shadow:0 4px 24px rgba(15,31,75,0.10);--shadow-lg:0 8px 40px rgba(15,31,75,0.16);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:var(--soft);color:var(--text);min-height:100vh;}
header{background:var(--navy);padding:0 28px;display:flex;align-items:center;justify-content:space-between;height:64px;box-shadow:0 2px 20px rgba(15,31,75,0.25);position:sticky;top:0;z-index:100;}
.header-brand{display:flex;align-items:center;gap:10px;}
.header-icon{width:34px;height:34px;background:var(--gold);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;}
.header-title{font-family:Georgia,'Times New Roman',serif;font-size:18px;color:var(--white);}
.header-title span{color:var(--gold-light);}
.header-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.header-tabs{display:flex;gap:3px;background:rgba(255,255,255,0.07);padding:3px;border-radius:9px;}
.tab-btn{padding:7px 16px;border:none;border-radius:6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all 0.2s;background:transparent;color:rgba(255,255,255,0.6);}
.tab-btn.active,.tab-btn:hover{background:var(--gold);color:var(--navy);font-weight:600;}
#logoutBtn{display:none;padding:6px 14px;border:1.5px solid rgba(255,255,255,0.25);border-radius:7px;background:transparent;color:rgba(255,255,255,0.7);font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;cursor:pointer;transition:all 0.2s;}
#logoutBtn:hover{background:rgba(255,255,255,0.1);color:#fff;}
.container{max-width:1280px;margin:0 auto;padding:28px 20px;}
.page{display:none;animation:fadeUp 0.3s ease;}
.page.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
#dbOverlay{position:fixed;inset:0;background:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;gap:14px;}
#dbOverlay .spin{width:44px;height:44px;border:4px solid rgba(255,255,255,0.2);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite;}
#dbOverlay p{color:rgba(255,255,255,0.8);font-size:14px;}
@keyframes spin{to{transform:rotate(360deg);}}
.card{background:var(--white);border-radius:16px;padding:24px 28px;margin-bottom:20px;box-shadow:var(--shadow);border:1px solid var(--border);}
.card-title{font-family:Georgia,'Times New Roman',serif;font-size:18px;color:var(--navy);margin-bottom:18px;display:flex;align-items:center;gap:9px;}
.card-title::before{content:'';display:inline-block;width:4px;height:20px;background:var(--gold);border-radius:2px;}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.form-group{margin-bottom:14px;}
label{display:block;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.7px;color:var(--muted);margin-bottom:5px;}
input[type=text],input[type=password],input[type=number],select,textarea{width:100%;padding:10px 13px;border:1.5px solid var(--border);border-radius:9px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;color:var(--text);background:var(--soft);transition:border 0.2s,box-shadow 0.2s;outline:none;}
textarea{resize:vertical;min-height:68px;}
input:focus,select:focus,textarea:focus{border-color:var(--navy-mid);box-shadow:0 0 0 3px rgba(26,50,112,0.10);background:var(--white);}
input[type=file]{width:100%;padding:8px 13px;border:1.5px dashed var(--border);border-radius:9px;font-size:13px;color:var(--muted);background:var(--soft);cursor:pointer;}
.btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border:none;border-radius:9px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.18s;}
.btn-primary{background:var(--navy);color:var(--white);}
.btn-primary:hover{background:var(--navy-mid);transform:translateY(-1px);box-shadow:0 4px 14px rgba(15,31,75,0.22);}
.btn-gold{background:var(--gold);color:var(--navy);}
.btn-gold:hover{background:var(--gold-light);transform:translateY(-1px);}
.btn-danger{background:#fee2e2;color:var(--red);}
.btn-danger:hover{background:#fecaca;}
.btn-outline{background:transparent;color:var(--navy);border:1.5px solid var(--border);}
.btn-outline:hover{border-color:var(--navy);background:var(--soft);}
.btn-green{background:#dcfce7;color:#166534;}
.btn-green:hover{background:#bbf7d0;}
.btn-sm{padding:6px 13px;font-size:12px;border-radius:7px;}
.btn-xs{padding:4px 9px;font-size:11px;border-radius:6px;}
.alert{padding:11px 15px;border-radius:9px;font-size:13px;margin-top:10px;display:none;}
.alert.show{display:flex;align-items:center;gap:7px;}
.alert-success{background:#f0fdf4;color:var(--green);border:1px solid #bbf7d0;}
.alert-error{background:#fef2f2;color:var(--red);border:1px solid #fecaca;}
.alert-info{background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe;}
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;}
.badge-navy{background:var(--navy);color:white;}
.badge-gold{background:var(--gold);color:var(--navy);}
.badge-green{background:#166534;color:white;}
.badge-rose{background:#b45309;color:white;}
.badge-danger{background:#fdecea;color:#c0392b;border:1px solid #f3c1ba;}
.badge-a{background:#dcfce7;color:#166534;}
.badge-b{background:#dbeafe;color:#1e40af;}
.badge-c{background:#fef9c3;color:#854d0e;}
.badge-d{background:#ffedd5;color:#9a3412;}
.badge-e{background:#fee2e2;color:#991b1b;}
.login-card{max-width:420px;margin:50px auto;}
.login-icon{width:60px;height:60px;background:linear-gradient(135deg,var(--navy),var(--navy-mid));border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 18px;box-shadow:0 8px 24px rgba(15,31,75,0.22);}
.login-card h2{font-family:Georgia,'Times New Roman',serif;font-size:22px;text-align:center;margin-bottom:5px;}
.login-card p{text-align:center;color:var(--muted);font-size:13px;margin-bottom:22px;}
.table-wrap{overflow-x:auto;border-radius:11px;border:1px solid var(--border);}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead{background:var(--navy);}
th{color:var(--white);font-weight:600;padding:12px 13px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;}
td{padding:10px 13px;border-bottom:1px solid var(--border);color:var(--text);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:#f9fafb;}
.empty-row td{text-align:center;padding:36px;color:var(--muted);font-size:13px;}
#classTable input[type=number]{width:58px;padding:5px 7px;text-align:center;font-size:13px;margin:0;}
.stat-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
.stat-card{background:var(--white);border:1px solid var(--border);border-radius:13px;padding:18px 20px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow);}
.stat-icon{width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;}
.stat-icon.blue{background:#e8effe;}.stat-icon.gold{background:#fef9ec;}.stat-icon.green{background:#f0fdf4;}.stat-icon.purple{background:#f3e8ff;}.stat-icon.red{background:#fef2f2;}.stat-icon.teal{background:#f0fdfa;}
.stat-val{font-family:Georgia,'Times New Roman',serif;font-size:24px;font-weight:700;color:var(--navy);}
.stat-lbl{font-size:11px;color:var(--muted);font-weight:500;margin-top:1px;}
.search-bar{display:flex;gap:8px;margin-bottom:13px;align-items:center;flex-wrap:wrap;}
.search-bar input{max-width:240px;margin:0;}
.search-bar select{max-width:170px;margin:0;}
.pagination{display:flex;align-items:center;gap:7px;margin-top:13px;flex-wrap:wrap;}
.pagination button{padding:5px 13px;border:1.5px solid var(--border);border-radius:7px;background:var(--white);color:var(--navy);font-size:12px;font-weight:600;cursor:pointer;transition:all 0.15s;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;}
.pagination button:hover{border-color:var(--navy);background:var(--soft);}
.pagination button.active{background:var(--navy);color:var(--white);border-color:var(--navy);}
.pagination button:disabled{opacity:0.35;cursor:not-allowed;}
.pagination .page-info{font-size:12px;color:var(--muted);}
.grade-key{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px;}
.grade-key-item{display:flex;align-items:center;gap:5px;background:var(--soft);border:1px solid var(--border);border-radius:7px;padding:5px 10px;font-size:12px;}
.grade-key-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.photo-preview-wrap{margin-top:9px;display:none;align-items:center;gap:11px;}
.info-note{background:#eff6ff;border:1px solid #bfdbfe;border-radius:9px;padding:11px 15px;font-size:13px;color:#1e40af;margin-bottom:14px;}
.warn-note{background:#fffbeb;border:1px solid #fde68a;border-radius:9px;padding:11px 15px;font-size:13px;color:#92400e;margin-bottom:14px;}
/* TERM PILLS */
.term-pill-wrap{display:flex;gap:5px;flex-wrap:wrap;}
.term-pill{padding:6px 15px;border:1.5px solid var(--border);border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;background:var(--soft);color:var(--muted);transition:all 0.15s;}
.term-pill.active{background:var(--navy);color:white;border-color:var(--navy);}
/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(15,31,75,0.55);z-index:500;display:none;align-items:center;justify-content:center;padding:20px;}
.modal-overlay.open{display:flex;}
.modal{background:var(--white);border-radius:18px;padding:28px;max-width:560px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg);}
.modal-title{font-family:Georgia,'Times New Roman',serif;font-size:19px;color:var(--navy);margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;}
.modal-close{background:none;border:none;font-size:22px;cursor:pointer;color:var(--muted);line-height:1;}
/* TABS inside admin */
.admin-tabs{display:flex;gap:3px;background:var(--soft);padding:4px;border-radius:10px;margin-bottom:20px;flex-wrap:wrap;}
.admin-tab{padding:8px 16px;border:none;border-radius:7px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:500;cursor:pointer;background:transparent;color:var(--muted);transition:all 0.2s;}
.admin-tab.active{background:var(--white);color:var(--navy);font-weight:700;box-shadow:var(--shadow);}
.admin-section{display:none;}
.admin-section.active{display:block;}
/* CHARTS */
.chart-bar-wrap{display:flex;flex-direction:column;gap:7px;}
.chart-bar-row{display:flex;align-items:center;gap:10px;font-size:12px;}
.chart-bar-label{min-width:100px;color:var(--navy);font-weight:600;}
.chart-bar-track{flex:1;background:var(--border);border-radius:20px;height:18px;overflow:hidden;}
.chart-bar-fill{height:100%;border-radius:20px;transition:width 0.7s ease;display:flex;align-items:center;padding-left:8px;font-size:11px;font-weight:700;color:white;}
.chart-bar-count{min-width:28px;text-align:right;color:var(--muted);font-weight:600;}
/* LAST SAVED */
.last-saved{font-size:11px;color:var(--muted);margin-top:6px;font-style:italic;}
/* TEACHER CARD in list */
.teacher-card{background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;}
.teacher-info{flex:1;}
.teacher-name{font-weight:700;color:var(--navy);font-size:14px;}
.teacher-meta{font-size:12px;color:var(--muted);margin-top:2px;}
/* CONDUCT GRID */
.conduct-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
/* ══ A4 REPORT CARD — exact 794×1123px (A4 at 96dpi) ══ */
.a4-preview-wrap{display:flex;justify-content:center;margin-top:24px;padding-bottom:40px;}
.a4-page{
  width:794px;height:1123px;background:#fff;border:1px solid #bbb;
  box-shadow:0 8px 40px rgba(15,31,75,0.18);
  padding:0;position:relative;overflow:hidden;
  font-size:8.5pt;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111;
  display:flex;flex-direction:column;box-sizing:border-box;
  flex-shrink:0;
  /* Scale down for screen preview so it fits without scrolling */
  transform:scale(0.78);transform-origin:top center;
  margin-bottom:-248px;/* compensate for scale shrinkage */
}
/* top navy bar */
.rc-topbar{height:8px;background:var(--navy);flex-shrink:0;}
/* header */
.rc-header{display:flex;align-items:center;gap:12px;padding:8px 16px 7px;flex-shrink:0;border-bottom:2.5px solid var(--navy);}
.rc-logo{width:68px;height:68px;border-radius:50%;border:3px solid var(--navy);object-fit:cover;flex-shrink:0;}
.rc-logo-placeholder{width:68px;height:68px;border-radius:50%;border:2.5px solid var(--navy);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;background:#f0f4ff;}
.rc-school-block{flex:1;text-align:center;}
.rc-school-name{font-family:Georgia,'Times New Roman',serif;font-size:16pt;font-weight:800;color:#8b0000;letter-spacing:0.3px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.rc-school-motto{font-size:8pt;color:#555;font-style:italic;margin:2px 0 1px;}
.rc-school-contact{font-size:7pt;color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.rc-report-badge{display:inline-block;background:var(--navy);color:#fff;padding:4px 18px;font-size:7pt;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-top:5px;white-space:normal;max-width:100%;box-sizing:border-box;}
.rc-passport{width:68px;height:82px;border:2px solid var(--navy);border-radius:4px;object-fit:cover;flex-shrink:0;}
.rc-passport-placeholder{width:68px;height:82px;border:2px dashed #aab;border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#f8f9ff;flex-direction:column;gap:2px;font-size:20px;color:#aab;}
.rc-passport-placeholder span{font-size:6.5pt;color:#aab;}
/* student strip */
.rc-student-strip{display:flex;border-top:1.5px solid #222;border-bottom:1.5px solid #222;flex-shrink:0;}
.rc-sfield{flex:1;padding:4px 8px;border-right:1px solid #ccc;}
.rc-sfield:last-child{border-right:none;}
.rc-sfield-label{font-size:5.5pt;color:#888;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;}
.rc-sfield-value{font-weight:700;color:#111;margin-top:1px;font-size:8pt;}
/* body */
.rc-body{padding:0 16px 4px;flex:1;display:flex;flex-direction:column;min-height:0;}
/* section titles */
.rc-section-title{font-size:7pt;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:#111;margin:6px 0 3px;border-bottom:1.5px solid #111;padding-bottom:2px;flex-shrink:0;}
/* marks table */
.rc-table-wrap{flex-shrink:0;border:1px solid #ccc;overflow:hidden;}
.rc-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:7pt;}
.rc-table thead tr:first-child{background:var(--navy);}
.rc-table thead tr:nth-child(2){background:#1a3270;}
.rc-table th{color:#fff;font-weight:700;padding:4px 2px;font-size:6.5pt;text-transform:uppercase;letter-spacing:0.1px;text-align:center;border:0.5px solid rgba(255,255,255,0.15);overflow:hidden;white-space:normal;word-break:break-word;}
.rc-table th:first-child{text-align:left;padding-left:8px;}
.rc-table td{padding:3px 2px;border:0.5px solid #e0e0e0;text-align:center;vertical-align:middle;overflow:hidden;white-space:normal;word-break:break-word;}
.rc-table td:first-child{text-align:left;padding-left:8px;font-weight:600;}
.rc-table tbody tr:nth-child(even) td{background:#f6f8ff;}
.rc-table col.rc-col-subject{width:19%;}
.rc-table col.rc-col-a{width:6.5%;}
.rc-table col.rc-col-act,.rc-table col.rc-col-end{width:8%;}
.rc-table col.rc-col-total{width:9%;}
.rc-table col.rc-col-grade{width:7%;}
.rc-table col.rc-col-comment{width:19%;}
.rc-table col.rc-col-teacher{width:11%;}
/* summary */
.rc-summary{display:flex;gap:9px;flex-shrink:0;align-items:stretch;}
.rc-avg-box{background:var(--navy);color:#fff;padding:7px 12px;text-align:center;flex-shrink:0;min-width:84px;}
.rc-avg-lbl{font-size:5.5pt;opacity:0.75;text-transform:uppercase;letter-spacing:0.4px;}
.rc-flame{font-size:9pt;margin-left:3px;filter:drop-shadow(0 0 2px rgba(255,140,0,0.6));}
.rc-avg-num{font-family:Georgia,'Times New Roman',serif;font-size:18pt;font-weight:800;line-height:1;margin-top:2px;}
.rc-avg-grade{font-size:13pt;font-weight:800;color:var(--gold-light);margin-top:1px;}
.rc-avg-sub{font-size:5.5pt;opacity:0.6;margin-top:1px;}
.rc-comments{flex:1;background:#f4f7ff;border-left:4px solid var(--gold);padding:6px 10px;font-size:7.5pt;}
.rc-comments p{margin-bottom:3px;line-height:1.4;}
.rc-comments strong{color:var(--navy);}
/* conduct — 4 col */
.rc-conduct{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;flex-shrink:0;}
.rc-conduct-item{border:1px solid #ddd;padding:4px 6px;}
.rc-conduct-label{color:#888;font-size:5.5pt;text-transform:uppercase;letter-spacing:0.3px;font-weight:700;}
.rc-conduct-val{font-weight:700;color:#111;margin-top:2px;font-size:7.5pt;border-bottom:1px solid #aaa;min-height:13px;}
/* grade key */
.rc-gk-wrap{display:flex;gap:8px;align-items:flex-start;flex-shrink:0;}
.rc-gk-scheme{font-size:7pt;background:#f4f7ff;border:1px solid #dde3f0;padding:5px 10px;min-width:175px;}
.rc-gk-scheme strong{color:var(--navy);}
.rc-grade-key{display:flex;gap:4px;flex-wrap:wrap;flex:1;align-content:flex-start;}
.rc-gk-item{display:flex;align-items:center;gap:4px;font-size:6.5pt;background:#f7f9ff;border:1px solid #e2e8f0;padding:2px 6px;}
.rc-gk-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
/* next term */
.rc-nextterm{border:1px solid #ddd;padding:5px 10px;font-size:7pt;display:grid;grid-template-columns:1fr 1fr;gap:4px;flex-shrink:0;}
.rc-nextterm-title{grid-column:1/-1;font-weight:800;color:#111;font-size:6.5pt;text-transform:uppercase;letter-spacing:0.7px;border-bottom:1px solid #ddd;padding-bottom:2px;margin-bottom:2px;}
.rc-nextterm-field label{font-size:5.5pt;color:#888;font-weight:700;text-transform:uppercase;display:block;}
.rc-nextterm-field span{border-bottom:1px solid #aaa;display:block;min-height:12px;margin-top:2px;font-size:7.5pt;font-weight:700;color:#111;}
/* signatures */
.rc-sigs{display:flex;justify-content:space-between;gap:10px;flex-shrink:0;}
.rc-sig{text-align:center;flex:1;}
.rc-sig-line{border-bottom:1.5px solid #111;margin:0 6px 4px;height:20px;}
.rc-sig-lbl{font-size:6pt;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:0.4px;}
/* bottom gold bar */
.rc-bottombar{height:7px;background:var(--gold);flex-shrink:0;margin-top:auto;}
/* stamp */
.rc-stamp{position:absolute;bottom:60px;right:45px;width:58px;height:58px;border-radius:50%;border:3px solid rgba(15,31,75,0.11);display:flex;align-items:center;justify-content:center;font-size:6px;color:rgba(15,31,75,0.11);text-align:center;font-weight:700;text-transform:uppercase;letter-spacing:1px;line-height:1.3;transform:rotate(-15deg);pointer-events:none;}
/* watermark */
.rc-watermark{position:absolute;top:40%;left:10%;font-family:Georgia,'Times New Roman',serif;font-size:72pt;font-weight:800;color:rgba(15,31,75,0.025);transform:rotate(-22deg);pointer-events:none;user-select:none;letter-spacing:6px;white-space:nowrap;z-index:0;}
.rc-watermark-img{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:58%;max-height:65%;object-fit:contain;opacity:0.07;pointer-events:none;user-select:none;z-index:0;filter:grayscale(1);}

/* ════════ PRIMARY (UGANDA PLE-STYLE) REPORT CARD ════════ */
.prc-page{background:#fff;position:relative;font-family:Arial,Helvetica,sans-serif;color:#111;font-size:9.5pt;}
.prc-topline{height:5px;background:linear-gradient(90deg,#0f1f4b 50%,#b22222 50%);}
.prc-header{display:flex;align-items:center;justify-content:center;gap:16px;padding:10px 8px 4px;text-align:center;position:relative;flex-wrap:wrap;}
.prc-header-name{font-weight:800;font-size:15pt;letter-spacing:0.3px;}
.prc-header-logo{width:52px;height:52px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:26px;}
.prc-header-logo img{width:100%;height:100%;object-fit:contain;}
.prc-contact{text-align:center;font-size:8pt;color:#333;padding-bottom:5px;border-bottom:2px solid #0f1f4b;}
.prc-doubleline{height:4px;background:linear-gradient(90deg,#b22222,#0f1f4b);margin-bottom:6px;}
.prc-title{text-align:center;font-weight:800;font-size:13pt;padding:10px 0 8px;}
.prc-photo{position:absolute;top:8px;right:10px;width:60px;height:72px;border-radius:6px;border:2px solid var(--gold);object-fit:cover;background:#f3f3f3;}
.prc-photo-placeholder{position:absolute;top:8px;right:10px;width:60px;height:72px;border-radius:6px;border:2px dashed var(--border);background:#f3f3f3;display:flex;align-items:center;justify-content:center;font-size:20px;color:#aaa;}
.prc-idrow{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px;padding:0 10px 10px;font-size:10pt;}
.prc-idrow div{display:flex;gap:6px;align-items:baseline;}
.prc-idrow label{font-weight:700;white-space:nowrap;}
.prc-idrow .prc-val{border-bottom:1.5px solid #111;flex:1;font-weight:700;padding-bottom:1px;}
.prc-section{text-align:center;font-weight:800;font-size:11pt;margin:6px 0 6px;text-transform:uppercase;}
.prc-table{width:100%;border-collapse:collapse;font-size:9pt;}
.prc-table th{background:#fff;border:1.5px solid #111;padding:5px 6px;text-align:center;font-weight:800;}
.prc-table td{border:1.5px solid #111;padding:5px 6px;text-align:center;}
.prc-table td.prc-subject{text-align:left;font-weight:700;}
.prc-table td.prc-remark{text-align:left;font-style:italic;}
.prc-table td.prc-teacher{text-align:left;font-style:italic;font-size:8.5pt;}
.prc-table tbody tr:nth-child(even) td{background:#f7f9ff;}
.prc-banner{background:#111;color:#fff;display:flex;justify-content:space-around;flex-wrap:wrap;padding:7px 10px;font-weight:800;font-size:9.5pt;margin-top:-1.5px;}
.prc-mid-wrap{display:grid;grid-template-columns:1fr;gap:0;border:1.5px solid #111;border-top:none;}
.prc-mid-set{border-left:1.5px solid #111;}
.prc-mid-set:first-child{border-left:none;}
.prc-mid-head{text-align:center;font-weight:800;background:#eef1f8;padding:4px;border-bottom:1.5px solid #111;font-size:9pt;text-transform:uppercase;}
.prc-mid-set table{width:100%;border-collapse:collapse;font-size:8.7pt;}
.prc-mid-set th{border:1px solid #111;padding:4px;background:#f8f8f8;}
.prc-mid-set td{border:1px solid #111;padding:4px;text-align:center;}
.prc-mid-set td.prc-subject{text-align:left;font-weight:600;}
.prc-mid-set tbody tr:nth-child(even) td{background:#f7f9ff;}
.prc-mid-foot{background:#111;color:#fff;font-size:8.3pt;font-weight:700;padding:4px 6px;display:flex;justify-content:space-between;gap:4px;flex-wrap:wrap;}
.prc-gradekey{border:1.5px solid #111;padding:8px 12px;margin-top:8px;font-size:8.3pt;}
.prc-gradekey-title{text-decoration:underline;font-weight:800;margin-bottom:5px;}
.prc-gradekey-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px 14px;color:#555;}
.prc-comments{margin-top:8px;border:1.5px solid #b22222;border-radius:2px;}
.prc-comment-row{display:grid;grid-template-columns:130px 1fr 110px;border-bottom:1.5px solid #b22222;}
.prc-comment-row:last-child{border-bottom:none;}
.prc-comment-row>div{padding:7px 10px;border-right:1.5px solid #b22222;font-size:9pt;}
.prc-comment-row>div:last-child{border-right:none;}
.prc-comment-label{font-weight:800;}
.prc-comment-text{font-style:italic;}
.prc-comment-sig{font-weight:700;display:flex;align-items:center;}
.prc-footer-row{display:flex;justify-content:space-between;align-items:center;padding:10px 4px 0;font-size:9pt;flex-wrap:wrap;gap:8px;}
.prc-stampoval{border:1.5px solid #555;border-radius:50%;width:100px;height:52px;display:flex;align-items:center;justify-content:center;font-size:8pt;color:#555;text-align:center;}
.prc-requirements{font-size:8.5pt;font-weight:700;margin-top:8px;}
.prc-bottombar{margin-top:10px;text-align:center;font-size:8pt;font-style:italic;color:#333;border-top:2px solid #0f1f4b;padding-top:5px;display:flex;justify-content:space-between;}

/* ════════ PR2 — REDESIGNED PRIMARY REPORT CARD (ribbon/badge style) ════════ */
.pr2-page{background:#fff;position:relative;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1a1a2e;padding:0 24px 5px;}
.pr2-stripe{height:6px;flex-shrink:0;background:linear-gradient(90deg,var(--navy) 0 4%,var(--gold) 4% 30%,var(--red) 30% 44%,var(--gold) 44% 96%,var(--navy) 96% 100%);}
.pr2-stars{text-align:center;font-size:9px;letter-spacing:5px;color:var(--gold);padding:5px 0 1px;}
.pr2-schoolhead{text-align:center;padding:0 0 3px;position:relative;}
.pr2-cap{font-size:17px;display:block;margin-bottom:0;}
.pr2-cap img{width:34px;height:34px;object-fit:contain;}
.pr2-schoolname{font-family:Georgia,'Times New Roman',serif;font-size:16.5pt;font-weight:800;color:var(--navy);letter-spacing:0.6px;}
.pr2-underline{width:100px;height:2px;background:var(--gold);margin:3px auto 0;border-radius:2px;}
.pr2-photo-badge{position:absolute;top:0;right:4px;width:44px;height:44px;border-radius:11px;border:2px dashed #c7cfe6;background:#f4f7ff;display:flex;align-items:center;justify-content:center;font-size:20px;overflow:hidden;}
.pr2-photo-badge img{width:100%;height:100%;object-fit:cover;}
.pr2-ribbon-wrap{display:flex;justify-content:center;margin:5px 0 7px;}
.pr2-ribbon{background:var(--navy);color:#fff;font-weight:800;font-size:9pt;letter-spacing:0.2px;padding:4px 22px;text-transform:uppercase;white-space:nowrap;}
.pr2-ribbon .dia{color:var(--gold-light);margin:0 9px;font-size:8pt;}
.pr2-idbox{background:#f4f7ff;border:1px solid var(--border);border-radius:8px;padding:6px 14px;margin-bottom:7px;}
.pr2-idrow{display:flex;gap:24px;font-size:9pt;flex-wrap:wrap;}
.pr2-idrow+.pr2-idrow{margin-top:3px;}
.pr2-idrow .pr2-idfield{display:flex;align-items:baseline;gap:6px;flex:1;min-width:150px;}
.pr2-idrow label{font-weight:800;color:var(--navy);text-transform:uppercase;font-size:7.5pt;white-space:nowrap;}
.pr2-idval{border-bottom:1.2px solid #222;font-weight:700;flex:1;padding-bottom:1px;}
.pr2-section-ribbon{display:flex;justify-content:center;margin:7px 0 4px;}
.pr2-tag{display:inline-flex;align-items:center;gap:6px;padding:4px 20px;font-weight:800;font-size:8.3pt;letter-spacing:0.3px;text-transform:uppercase;color:#fff;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 50%,calc(100% - 12px) 100%,0 100%,12px 50%);}
.pr2-tag.red{background:var(--red);}
.pr2-tag.navy{background:var(--navy);}
.pr2-tag.green{background:#2e7d32;}
.pr2-table{width:100%;border-collapse:collapse;font-size:7.8pt;border:1px solid var(--border);}
.pr2-table thead th{background:var(--navy);color:#fff;padding:4px 6px;font-size:6.9pt;text-transform:uppercase;letter-spacing:0.2px;text-align:left;}
.pr2-table thead th:not(:first-child){text-align:center;}
.pr2-table thead.light th{background:#dbe4f5;color:var(--navy);}
.pr2-table td{padding:3.2px 6px;border-bottom:1px solid var(--border);}
.pr2-table td:not(:first-child){text-align:center;}
.pr2-table td.pr2-subj,.pr2-table td.prc-subject{font-weight:700;color:var(--navy);}
.pr2-table td.pr2-remark,.pr2-table td.prc-remark{font-style:italic;color:#555;}
.pr2-table td.pr2-teacher,.pr2-table td.prc-teacher{font-style:italic;color:#777;font-size:7.6pt;}
.pr2-table tbody tr:nth-child(even) td{background:#f4f7ff;}
.pr2-summarybar{background:var(--navy);color:#fff;display:flex;flex-wrap:wrap;justify-content:space-around;align-items:center;padding:4.5px 9px;font-size:7.2pt;font-weight:700;gap:4px;}
.pr2-summarybar span{display:flex;align-items:center;gap:4px;white-space:nowrap;}
.pr2-gradebox{border:1.5px solid #2e7d32;background:#f0fdf4;border-radius:7px;padding:6px 16px;margin:6px 0;}
.pr2-gradebox-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px 18px;font-size:8pt;font-weight:700;color:var(--navy);}
.pr2-comment{display:flex;align-items:center;gap:8px;background:#f4f7ff;border-radius:6px;padding:4.5px 10px;margin-bottom:4px;}
.pr2-comment.head{background:#fef2f2;}
.pr2-comment-chip{background:var(--navy);color:#fff;font-weight:800;font-size:7.5pt;padding:6px 12px;border-radius:5px;white-space:nowrap;text-transform:uppercase;letter-spacing:0.3px;}
.pr2-comment.head .pr2-comment-chip{background:var(--red);}
.pr2-comment-text{flex:1;font-style:italic;font-size:8pt;color:#333;line-height:1.25;}
.pr2-comment-icon{font-size:13px;opacity:0.45;flex-shrink:0;}
.pr2-footerrow{display:flex;justify-content:space-between;align-items:center;margin-top:6px;font-size:7.6pt;gap:10px;}
.pr2-stampcircle{width:52px;height:52px;border:2px dashed var(--navy);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:6pt;font-weight:800;color:var(--navy);text-align:center;letter-spacing:0.2px;flex-shrink:0;}
.pr2-requirements{font-size:7.6pt;font-weight:700;margin-top:5px;}
.pr2-mottobar{background:var(--navy);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:5px 12px;border-radius:5px;margin-top:5px;font-size:7.6pt;font-weight:700;}

.hidden{display:none!important;}
/* PRINT */
@media print{
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;color-adjust:exact!important;}
  header,.no-print,.stat-cards,.admin-tabs{display:none!important;}
  body{background:white;margin:0;padding:0;}
  .container{padding:0;max-width:100%;}
  .a4-preview-wrap{margin:0;padding:0;}
  .a4-page{
    width:210mm!important;height:297mm!important;
    transform:none!important;margin-bottom:0!important;
    border:none;box-shadow:none;border-radius:0;
    page-break-after:always;
  }
  @page{size:A4 portrait;margin:0;}
  body.printing-marksheet #admin-gate,body.printing-marksheet #admin-dashboard,body.printing-marksheet #teacher-gate{display:none!important;}
  body.printing-marksheet #teacher-sheet{display:block!important;}
  body.printing-marksheet #teacher-sheet .btn{display:none!important;}
  body.printing-marksheet .card{box-shadow:none!important;border:1px solid #ccc!important;padding:12px!important;}
  body.printing-marksheet #classTable input[type=number]{border:none!important;background:transparent!important;font-weight:700;}
}
@media(max-width:800px){
  .grid-2,.grid-3,.grid-4,.stat-cards{grid-template-columns:1fr;}
  header{padding:10px 14px;flex-wrap:wrap;height:auto;gap:8px;}
  .container{padding:16px 10px;}
  .card{padding:18px 14px;}
  .a4-page{width:100%;min-height:auto;padding:5mm;}
  .rc-conduct{grid-template-columns:1fr 1fr;}
  .conduct-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<div id="dbOverlay">
  <div class="spin"></div>
  <p>Opening database…</p>
</div>

<!-- EDIT STUDENT MODAL -->
<div class="modal-overlay" id="editStudentModal">
  <div class="modal">
    <div class="modal-title">✏️ Edit Learner <button class="modal-close" onclick="closeModal('editStudentModal')">✕</button></div>
    <input type="hidden" id="editStudentOrigId">
    <div class="grid-2">
      <div class="form-group"><label>Full Name</label><input type="text" id="editStudentName" placeholder="Full name"></div>
      <div class="form-group"><label>Learner ID</label><input type="text" id="editStudentId" placeholder="e.g. S001"></div>
    </div>
    <div class="form-group"><label>House</label><input type="text" id="editStudentHouse" placeholder="e.g. Red"></div>
    <div class="form-group">
      <label>Class</label>
      <select id="editStudentClass" onchange="renderSubjectCombo('editStudentClass','editComboWrap',true)">
        <option>Loading…</option>
      </select>
    </div>
    <div id="editComboWrap" style="display:none"></div>
    <div class="form-group">
      <label>Passport Photo (leave blank to keep current)</label>
      <input type="file" id="editStudentPhoto" accept="image/*" onchange="previewImage(this,'editPhotoPreview','editPhotoPreviewImg','editPhotoPreviewSize',160,200)">
      <div id="editPhotoPreview" class="photo-preview-wrap">
        <img id="editPhotoPreviewImg" style="width:52px;height:64px;border-radius:6px;object-fit:cover;border:2px solid var(--navy)">
        <div><div id="editPhotoPreviewSize" style="font-size:12px;color:var(--muted)"></div></div>
      </div>
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('editStudentModal')">Cancel</button>
      <button class="btn btn-gold" onclick="saveEditStudent()">💾 Save Changes</button>
    </div>
    <div id="editStudentAlert" class="alert"></div>
  </div>
</div>

<!-- ADD TEACHER MODAL -->
<div class="modal-overlay" id="addTeacherModal">
  <div class="modal">
    <div class="modal-title">➕ Add Teacher Account <button class="modal-close" onclick="closeModal('addTeacherModal')">✕</button></div>
    <div class="form-group"><label>Full Name</label><input type="text" id="newTeacherName" placeholder="e.g. Mr. Okello John"></div>
    <div class="form-group"><label>Username (for login)</label><input type="text" id="newTeacherUsername" placeholder="e.g. okello.john"></div>
    <div class="form-group"><label>Password</label><input type="password" id="newTeacherPw" placeholder="Min 6 characters"></div>
    <div class="form-group">
      <label>Subjects they teach (hold Ctrl/Cmd to pick multiple)</label>
      <select id="newTeacherSubjects" multiple style="height:110px"></select>
    </div>
    <div class="form-group">
      <label>Classes they teach (hold Ctrl/Cmd to pick multiple — leave blank for all classes)</label>
      <select id="newTeacherClasses" multiple style="height:110px"></select>
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('addTeacherModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveNewTeacher()">✅ Create Account</button>
    </div>
    <div id="addTeacherAlert" class="alert"></div>
  </div>
</div>

<!-- EDIT TEACHER MODAL -->
<div class="modal-overlay" id="editTeacherModal">
  <div class="modal">
    <div class="modal-title">✏️ Edit Teacher Assignment <button class="modal-close" onclick="closeModal('editTeacherModal')">✕</button></div>
    <input type="hidden" id="editTeacherUsername">
    <div class="form-group"><label>Full Name</label><input type="text" id="editTeacherName" placeholder="e.g. Mr. Okello John"></div>
    <div class="form-group">
      <label>Subjects they teach (hold Ctrl/Cmd to pick multiple)</label>
      <select id="editTeacherSubjects" multiple style="height:110px"></select>
    </div>
    <div class="form-group">
      <label>Classes they teach (hold Ctrl/Cmd to pick multiple — leave blank for all classes)</label>
      <select id="editTeacherClasses" multiple style="height:110px"></select>
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('editTeacherModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveEditTeacher()">💾 Save Changes</button>
    </div>
    <div id="editTeacherAlert" class="alert"></div>
  </div>
</div>

<!-- ADD BURSAR MODAL -->
<div class="modal-overlay" id="addBursarModal">
  <div class="modal">
    <div class="modal-title">➕ Add Bursar Account <button class="modal-close" onclick="closeModal('addBursarModal')">✕</button></div>
    <div class="form-group"><label>Full Name</label><input type="text" id="newBursarName" placeholder="e.g. Mrs. Nakato Sarah"></div>
    <div class="form-group"><label>Username (for login)</label><input type="text" id="newBursarUsername" placeholder="e.g. nakato.sarah"></div>
    <div class="form-group"><label>Password</label><input type="password" id="newBursarPw" placeholder="Min 6 characters"></div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('addBursarModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveNewBursar()">✅ Create Account</button>
    </div>
    <div id="addBursarAlert" class="alert"></div>
  </div>
</div>

<!-- EDIT BURSAR MODAL -->
<div class="modal-overlay" id="editBursarModal">
  <div class="modal">
    <div class="modal-title">✏️ Edit Bursar Account <button class="modal-close" onclick="closeModal('editBursarModal')">✕</button></div>
    <input type="hidden" id="editBursarUsername">
    <div class="form-group"><label>Full Name</label><input type="text" id="editBursarName" placeholder="e.g. Mrs. Nakato Sarah"></div>
    <div class="form-group"><label>New Password (leave blank to keep current)</label><input type="password" id="editBursarPw" placeholder="Leave blank to keep existing"></div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('editBursarModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveEditBursar()">💾 Save Changes</button>
    </div>
    <div id="editBursarAlert" class="alert"></div>
  </div>
</div>

<!-- CLASS SUBJECTS MODAL -->
<div class="modal-overlay" id="classSubjectsModal">
  <div class="modal">
    <div class="modal-title">📚 Subjects for <span id="classSubjectsModalClassName"></span> <button class="modal-close" onclick="closeModal('classSubjectsModal')">✕</button></div>
    <input type="hidden" id="classSubjectsModalClassKey">
    <div class="info-note" style="margin-top:0">ℹ️ Tick every subject this class studies. Leave everything unticked to use the standard default subjects for this class's level instead.</div>
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap">
      <input type="text" id="classSubjectsNewName" placeholder="New subject name, e.g. Sub-ICT" style="max-width:220px;margin:0">
      <button class="btn btn-outline btn-sm" onclick="addSubjectFromClassModal()">➕ Add &amp; Tick</button>
    </div>
    <div id="classSubjectsCheckboxes" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;max-height:260px;overflow-y:auto;border:1.5px solid var(--border);border-radius:9px;padding:10px;background:var(--soft)"></div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:12px">
      <button class="btn btn-outline" onclick="closeModal('classSubjectsModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveClassSubjects()">💾 Save Subjects</button>
    </div>
    <div id="classSubjectsAlert" class="alert"></div>
  </div>
</div>

<!-- ADD PARENT MODAL -->
<div class="modal-overlay" id="addParentModal">
  <div class="modal">
    <div class="modal-title">➕ Add Parent / Guardian Account <button class="modal-close" onclick="closeModal('addParentModal')">✕</button></div>
    <div class="form-group"><label>Parent / Guardian Full Name</label><input type="text" id="newParentName" placeholder="e.g. Mrs. Apio Grace"></div>
    <div class="form-group"><label>Username (for login)</label><input type="text" id="newParentUsername" placeholder="e.g. apio.grace"></div>
    <div class="form-group"><label>Password</label><input type="password" id="newParentPw" placeholder="Min 6 characters"></div>
    <div class="form-group">
      <label>Linked Children — Learner IDs (comma-separated)</label>
      <input type="text" id="newParentChildIds" placeholder="e.g. S001, S002">
      <div style="font-size:12px;color:var(--muted);margin-top:4px">Enter one or more Learner IDs separated by commas. The parent will see each linked child's report card.</div>
    </div>
    <div id="parentChildPreview" style="margin-top:8px;display:none">
      <div style="font-size:12px;font-weight:600;color:var(--navy);margin-bottom:5px">Matched Learners:</div>
      <div id="parentChildPreviewList"></div>
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap">
      <button class="btn btn-outline btn-sm" onclick="previewParentChildren()">🔍 Preview Children</button>
      <button class="btn btn-outline" onclick="closeModal('addParentModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveNewParent()">✅ Create Account</button>
    </div>
    <div id="addParentAlert" class="alert"></div>
  </div>
</div>

<!-- EDIT PARENT MODAL -->
<div class="modal-overlay" id="editParentModal">
  <div class="modal">
    <div class="modal-title">✏️ Edit Parent Account <button class="modal-close" onclick="closeModal('editParentModal')">✕</button></div>
    <input type="hidden" id="editParentOrigUsername">
    <div class="form-group"><label>Full Name</label><input type="text" id="editParentName" placeholder="Full name"></div>
    <div class="form-group"><label>New Password (leave blank to keep current)</label><input type="password" id="editParentPw" placeholder="Leave blank to keep existing"></div>
    <div class="form-group">
      <label>Linked Children — Learner IDs (comma-separated)</label>
      <input type="text" id="editParentChildIds" placeholder="e.g. S001, S002">
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('editParentModal')">Cancel</button>
      <button class="btn btn-gold" onclick="saveEditParent()">💾 Save Changes</button>
    </div>
    <div id="editParentAlert" class="alert"></div>
  </div>
</div>

<!-- CONDUCT / REMARKS MODAL -->
<div class="modal-overlay" id="conductModal">
  <div class="modal">
    <div class="modal-title">📝 Conduct &amp; Remarks <button class="modal-close" onclick="closeModal('conductModal')">✕</button></div>
    <input type="hidden" id="conductStudentId">
    <input type="hidden" id="conductTerm">
    <div class="grid-2">
      <div class="form-group"><label>Punctuality</label>
        <select id="conductPunctuality"><option value="">— Select —</option><option>Excellent</option><option>Very Good</option><option>Good</option><option>Fair</option><option>Poor</option></select>
      </div>
      <div class="form-group"><label>Discipline</label>
        <select id="conductDiscipline"><option value="">— Select —</option><option>Excellent</option><option>Very Good</option><option>Good</option><option>Fair</option><option>Poor</option></select>
      </div>
      <div class="form-group"><label>Participation</label>
        <select id="conductParticipation"><option value="">— Select —</option><option>Excellent</option><option>Very Good</option><option>Good</option><option>Fair</option><option>Poor</option></select>
      </div>
      <div class="form-group"><label>Days Present / Total</label>
        <div style="display:flex;gap:6px">
          <input type="number" id="conductDaysPresent" placeholder="Present" min="0" max="200" style="width:50%">
          <input type="number" id="conductDaysTotal" placeholder="Total" min="0" max="200" style="width:50%">
        </div>
      </div>
    </div>
    <div class="form-group"><label>Class Teacher's Remarks (custom)</label>
      <textarea id="conductTeacherRemark" placeholder="Write your personal remarks for this learner…" style="min-height:72px"></textarea>
    </div>
    <div class="form-group"><label>Headteacher's Remarks (custom)</label>
      <textarea id="conductHtRemark" placeholder="Headteacher's remarks…" style="min-height:56px"></textarea>
    </div>
    <div style="display:flex;gap:9px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-outline" onclick="closeModal('conductModal')">Cancel</button>
      <button class="btn btn-gold" onclick="saveConductRemarks()">💾 Save</button>
    </div>
    <div id="conductAlert" class="alert"></div>
  </div>
</div>

<div class="modal-overlay" id="ocrScanModal">
  <div class="modal" style="max-width:660px">
    <div class="modal-title">📷 Scan Paper Mark Sheet <button class="modal-close" onclick="closeModal('ocrScanModal')">✕</button></div>
    <div id="ocrStatus" style="font-size:13px;color:var(--muted);margin-bottom:12px">Choose a clear, well-lit, straight-on photo of a printed or neatly handwritten mark sheet. Handwriting may be misread — always check the review table below.</div>
    <div id="ocrProgressWrap" style="display:none;margin-bottom:14px">
      <div style="background:#e5e9f5;border-radius:8px;overflow:hidden;height:10px">
        <div id="ocrProgressBar" style="background:var(--navy);height:100%;width:0%;transition:width .2s"></div>
      </div>
      <div id="ocrProgressText" style="font-size:12px;color:var(--muted);margin-top:5px">Reading image…</div>
    </div>
    <div id="ocrReviewWrap" style="display:none">
      <div class="table-wrap" style="max-height:360px;overflow:auto">
        <table id="ocrReviewTable" style="width:100%">
          <thead id="ocrReviewHead"></thead>
          <tbody id="ocrReviewBody"></tbody>
        </table>
      </div>
      <div style="font-size:12px;color:var(--muted);margin-top:8px">⚠️ Yellow rows had a weak match to a name on the sheet — check them carefully. Edit any wrong number directly in the box before applying.</div>
      <div style="display:flex;gap:9px;margin-top:14px">
        <button class="btn btn-gold" onclick="applyOcrToSheet()">✅ Apply to Marksheet</button>
        <button class="btn btn-outline" onclick="closeModal('ocrScanModal')">Cancel</button>
      </div>
    </div>
  </div>
</div>

<header>
  <div class="header-brand">
    <div class="header-icon">📘</div>
    <div class="header-title">LUMA<span>@</span> Pro School Manager <span style="font-size:10px;opacity:0.55;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">v4.0</span></div>
  </div>
  <div class="header-right">
    <div class="header-tabs">
      <button class="tab-btn active" onclick="switchPage('admin-gate')">🔐 Admin</button>
      <button class="tab-btn" onclick="switchPage('teacher-gate')">✏️ Teacher</button>
      <button class="tab-btn" onclick="switchPage('parent-gate')">👨‍👩‍👧 Parent</button>
      <button class="tab-btn" onclick="switchPage('bursar-gate')">💰 Bursar</button>
    </div>
    <button id="installBtn" style="display:none;padding:6px 13px;border:1.5px solid var(--gold);border-radius:7px;background:var(--gold);color:var(--navy);font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;cursor:pointer;" onclick="installPWA()">📲 Install</button>
    <button id="logoutBtn" onclick="logoutAdmin()">↩ Logout</button>
  </div>
</header>

<div class="container">

<!-- ══ ADMIN GATE ══ -->
<div id="admin-gate" class="page active">
  <div class="card login-card">
    <div class="login-icon">🔐</div>
    <h2>Admin Portal</h2>
    <p>Enter your password to access the school dashboard</p>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="adminPassword" placeholder="Enter admin password" onkeydown="if(event.key==='Enter')loginAdmin()">
    </div>
    <button class="btn btn-primary" style="width:100%" onclick="loginAdmin()">Login to Dashboard →</button>
    <div id="adminAlert" class="alert"></div>
    <div id="defaultPwHint" style="background:var(--soft);border:1px solid var(--border);border-radius:7px;padding:9px 13px;font-size:12px;color:var(--muted);margin-top:11px;text-align:center;">
      First time? Default password: <strong style="color:var(--navy)">admin123</strong> — change it after login.
    </div>
  </div>
</div>

<!-- ══ ADMIN DASHBOARD ══ -->
<div id="admin-dashboard" class="page hidden">
  <div id="backupReminderBanner" class="warn-note no-print" style="display:none;cursor:pointer" onclick="document.querySelector('.admin-tab[onclick*=tab-transfer]').click();"></div>
  <div class="stat-cards no-print" id="statCards"></div>

  <!-- Admin section tabs -->
  <div class="admin-tabs no-print">
    <button class="admin-tab active" onclick="switchAdminTab('tab-school')">🏫 School</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-teachers')">👩‍🏫 Teachers</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-students')">👤 Learners</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-attendance')">🗓️ Attendance</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-bursars')">💰 Bursars</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-marks')">📊 All Marks</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-reports')">📄 Report Cards</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-analytics')">📈 Analytics</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-transfer')">🔄 Data Transfer</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-parents')">👨‍👩‍👧 Parents</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-circulars')">📢 Circulars</button>
    <button class="admin-tab" id="adminMsgTabBtn" onclick="switchAdminTab('tab-messages')">💬 Messages</button>
    <button class="admin-tab" onclick="switchAdminTab('tab-settings')">⚙️ Settings</button>
  </div>

  <!-- TAB: SCHOOL INFO -->
  <div id="tab-school" class="admin-section active">
    <div class="card">
      <div class="card-title">🏫 School Information</div>
      <div class="grid-2">
        <div>
          <div class="form-group"><label>School Name</label><input type="text" id="schoolName" placeholder="e.g. St. Mary's Secondary School"></div>
          <div class="form-group"><label>School Motto</label><input type="text" id="schoolMotto" placeholder="e.g. Excellence Through Effort"></div>
          <div class="form-group"><label>Contact / Address</label><input type="text" id="schoolContact" placeholder="Phone / Email / Address"></div>
        </div>
        <div>
          <div class="form-group">
            <label>School Logo / Badge</label>
            <div class="info-note" style="margin:4px 0 8px">💡 This badge appears in the report card header and is also used as a faded watermark across the report card. No badge uploaded? Report cards will show a plain "OFFICIAL" watermark instead.</div>
            <input type="file" id="schoolLogo" accept="image/*" onchange="previewImage(this,'logoPreview','logoPreviewImg','logoPreviewSize',200,200)">
            <div id="logoPreview" class="photo-preview-wrap">
              <img id="logoPreviewImg" style="width:68px;height:68px;border-radius:50%;object-fit:cover;border:3px solid var(--navy)">
              <div>
                <div id="logoPreviewSize" style="font-size:12px;color:var(--muted)"></div>
                <button type="button" class="btn btn-danger btn-xs" style="margin-top:5px" onclick="removeLogo()">✕ Remove</button>
              </div>
            </div>
          </div>
          <div class="form-group"><label>Next Term — School Opens Date</label><input type="text" id="nextTermOpens" placeholder="e.g. 6th January 2026"></div>
          <div class="form-group"><label>Next Term — Fees Due Date</label><input type="text" id="nextTermFees" placeholder="e.g. 10th January 2026"></div>
          <div class="form-group"><label>Current Academic Year</label><input type="text" id="currentAcademicYear" placeholder="e.g. 2026" style="max-width:160px"></div>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveSchoolInfo()">💾 Save School Info</button>
      <div id="schoolAlert" class="alert"></div>
    </div>

    <div class="card">
      <div class="card-title">🏛 Class Management</div>
      <div class="info-note">ℹ️ Add or remove classes. All teacher and learner dropdowns update automatically.</div>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap">
        <input type="text" id="newClassName" placeholder="e.g. S.3 North or P.5 Blue" style="max-width:200px;margin:0">
        <select id="newClassLevel" style="max-width:190px;margin:0">
          <option value="secondary">Secondary (A–E)</option>
          <option value="primary_upper">Primary Upper — P.4–P.7 (D1–F9)</option>
          <option value="primary_lower">Primary Lower — P.1–P.3 (D1–F9)</option>
          <option value="nursery">Nursery / Baby Class (D1–F9)</option>
        </select>
        <button class="btn btn-gold" onclick="addClass()">➕ Add Class</button>
      </div>
      <div class="info-note" style="margin-top:0">📘 <strong>Primary Upper</strong> (P.4–P.7) is fixed to the 4 PLE subjects: Mathematics, English, Science, Social Studies. <strong>Primary Lower</strong> (P.1–P.3) and <strong>Nursery</strong> use their own standard subject sets — teachers only see the right subjects for their class when entering marks. <strong>Secondary</strong> keeps the competency-based report (Integration Activities, A–E grading).</div>
      <div id="classAlert" class="alert"></div>
      <div id="classManagerList"></div>
    </div>

    <div class="card">
      <div class="card-title">🎓 Promote / Move Learners</div>
      <div class="info-note">ℹ️ At the end of a term or year, move a whole class up to the next class in one go — or graduate learners out of active classes. Past marks and report cards are never touched.</div>
      <div class="grid-2">
        <div class="form-group">
          <label>From Class</label>
          <select id="promoteFromClass" onchange="loadPromoteStudentList()">
            <option value="">Select class…</option>
          </select>
        </div>
        <div class="form-group">
          <label>Move To</label>
          <select id="promoteToClass">
            <option value="">Select destination…</option>
          </select>
        </div>
      </div>
      <div id="promoteStudentListWrap" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);text-transform:none;letter-spacing:0">
            <input type="checkbox" id="promoteSelectAll" onchange="togglePromoteSelectAll(this)" style="width:auto"> Select All
          </label>
          <span id="promoteCountLabel" style="font-size:12px;color:var(--muted)"></span>
        </div>
        <div id="promoteStudentList" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:9px;padding:6px 10px"></div>
        <button class="btn btn-primary" style="margin-top:14px" onclick="promoteSelectedStudents()">🎓 Move Selected Learners</button>
      </div>
      <div id="promoteAlert" class="alert"></div>
    </div>

    <div class="card">
      <div class="card-title">📚 Subject Management</div>
      <div class="info-note">ℹ️ Add or remove secondary school subjects (O-Level &amp; A-Level). These appear when assigning subjects to teachers.</div>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap">
        <input type="text" id="newSubjectName" placeholder="e.g. Sub-ICT" style="max-width:200px;margin:0">
        <button class="btn btn-gold" onclick="addSubject()">➕ Add Subject</button>
      </div>
      <div id="subjectAlert" class="alert"></div>
      <div id="subjectManagerList"></div>
    </div>
  </div>

  <!-- TAB: TEACHERS -->
  <div id="tab-teachers" class="admin-section">
    <div class="card">
      <div class="card-title">👩‍🏫 Teacher Accounts</div>
      <div class="info-note">ℹ️ Teachers log in with their username &amp; password. They can only see subjects assigned to them.</div>
      <button class="btn btn-gold" onclick="openModal('addTeacherModal');document.getElementById('newTeacherName').value='';document.getElementById('newTeacherUsername').value='';document.getElementById('newTeacherPw').value='';[...document.getElementById('newTeacherSubjects').options].forEach(o=>o.selected=false);[...document.getElementById('newTeacherClasses').options].forEach(o=>o.selected=false);" style="margin-bottom:14px">➕ Add Teacher Account</button>
      <div id="teacherList"></div>
    </div>
  </div>

  <!-- TAB: LEARNERS -->
  <div id="tab-students" class="admin-section">
    <div class="card">
      <div class="card-title">👤 Register Learner</div>
      <div class="grid-3">
        <div class="form-group"><label>Learner Name</label><input type="text" id="studentName" placeholder="Full name"></div>
        <div class="form-group">
          <label>Learner ID <span style="font-weight:400;color:var(--muted);text-transform:none;font-size:11px">(auto-generated)</span></label>
          <div style="display:flex;gap:6px;align-items:center">
            <input type="text" id="studentId" placeholder="Auto" style="flex:1">
            <button class="btn btn-outline btn-sm" onclick="autoGenerateStudentId()" title="Re-generate ID">🔄</button>
          </div>
        </div>
        <div class="form-group">
          <label>Class</label>
          <select id="studentClass" onchange="renderSubjectCombo('studentClass','studentComboWrap');autoGenerateStudentId()">
            <option>Loading…</option>
          </select>
        </div>
      </div>
      <div class="form-group"><label>House <span style="font-weight:400;color:var(--muted);text-transform:none;font-size:11px">(optional)</span></label><input type="text" id="studentHouse" placeholder="e.g. Red"></div>
      <div id="studentComboWrap" style="display:none"></div>
      <div class="form-group">
        <label>Passport Photo (optional)</label>
        <input type="file" id="studentPhoto" accept="image/*" onchange="previewImage(this,'photoPreview','photoPreviewImg','photoPreviewSize',160,200)">
        <div id="photoPreview" class="photo-preview-wrap">
          <img id="photoPreviewImg" style="width:52px;height:64px;border-radius:6px;object-fit:cover;border:2px solid var(--navy)">
          <div><div id="photoPreviewSize" style="font-size:12px;color:var(--muted)"></div></div>
        </div>
      </div>
      <div style="display:flex;gap:9px;flex-wrap:wrap">
        <button class="btn btn-gold" onclick="saveStudent()">➕ Register Learner</button>
        <label class="btn btn-outline" style="cursor:pointer">📥 Bulk Import Excel<input type="file" id="bulkImportFile" accept=".xlsx,.xls" style="display:none" onchange="bulkImportStudents(this)"></label>
        <button class="btn btn-danger btn-sm" onclick="clearAll()">🗑 Delete All Data</button>
      </div>
      <div class="info-note" style="margin-top:12px">💡 <strong>Bulk Import:</strong> Use an Excel file with columns: <em>Learner ID, Full Name, Class</em>. The <em>Class</em> must already exist under 🏛 Class Management (School tab) — rows with an unrecognized class are rejected. For S.3/S.4 learners, you can optionally add a <em>Subjects</em> column with exactly 2 electives (comma-separated), e.g. <em>Economics, Computer Studies</em>. If left blank (or invalid), the learner is still imported — just flagged as ⚠️ <strong>Options Pending</strong> in the list below, where you can add their electives afterwards. For S.1/S.2 learners, add an optional <em>Religion</em> column with <em>CRE</em> or <em>IRE</em>.</div>
      <div id="studentAlert" class="alert"></div>
    </div>

    <div class="card" id="promoteCard">
      <div class="card-title">⬆️ Promote Learners</div>
      <div class="info-note">ℹ️ Move a whole class up at the end of the year. All marks and history stay with each learner. <strong>Untick</strong> anyone who is repeating — they stay in their current class. Print this year's reports <strong>before</strong> promoting.</div>
      <div class="grid-2" style="margin-top:12px">
        <div class="form-group"><label>Promote from</label><select id="promoteFrom" onchange="promoteFromChanged()"></select></div>
        <div class="form-group"><label>Promote to</label><select id="promoteTo"></select></div>
      </div>
      <div style="display:flex;gap:9px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:6px;text-transform:none;font-size:13px;margin:0;cursor:pointer"><input type="checkbox" id="promoteAll" checked style="width:auto;margin:0" onchange="document.querySelectorAll('#promoteList .pchk').forEach(c=>c.checked=this.checked);updatePromoteCount()"> Select all</label>
        <span id="promoteCount" style="font-size:12px;color:var(--muted)"></span>
      </div>
      <div id="promoteList" style="max-height:320px;overflow-y:auto;border:1px solid var(--border);border-radius:11px;padding:6px 12px;background:var(--soft)"></div>
      <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:12px">
        <button class="btn btn-gold" onclick="runPromotion()">⬆️ Promote Selected Learners</button>
        <button class="btn btn-outline" onclick="downloadFullBackup()">⬇️ Backup first</button>
      </div>
      <div id="promoteAlert" class="alert"></div>
    </div>

    <div class="card">
      <div class="card-title">📋 Registered Learners</div>
      <div class="search-bar">
        <input type="text" id="learnerSearch" placeholder="🔍  Search by name or ID…" oninput="learnerPage=1;renderLearnerTable()">
        <select id="learnerClassFilter" onchange="learnerPage=1;renderLearnerTable()"><option value="">All Classes</option></select>
        <label style="display:flex;align-items:center;gap:5px;font-size:13px;white-space:nowrap;cursor:pointer">
          <input type="checkbox" id="learnerPendingOnly" onchange="learnerPage=1;renderLearnerTable()" style="width:auto;margin:0">
          ⚠️ Options Pending only
        </label>
      </div>
      <div class="table-wrap">
        <table id="learnersTable">
          <thead><tr><th>#</th><th>Name</th><th>ID</th><th>Class</th><th>Photo</th><th>Actions</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="pagination" id="learnerPagination"></div>
    </div>
  </div>

  <!-- TAB: ATTENDANCE -->
  <div id="tab-attendance" class="admin-section">
    <div class="card">
      <div class="card-title">🗓️ Take / Edit Attendance</div>
      <div class="info-note">ℹ️ Pick a class and date, then mark each learner Present, Absent or Late. Re-opening the same class + date loads what was already saved so you can edit it.</div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px">
        <select id="attClassSelect" onchange="loadAttendanceSheet()" style="max-width:180px;margin:0"><option value="">Select class…</option></select>
        <input type="date" id="attDate" onchange="loadAttendanceSheet()" style="max-width:170px;margin:0">
        <button class="btn btn-outline btn-sm" onclick="markAllAttendance('P')">✅ Mark all Present</button>
        <button class="btn btn-outline btn-sm" onclick="markAllAttendance('A')">🚫 Mark all Absent</button>
      </div>
      <div id="attSummaryBar" style="margin:10px 0;font-size:13px;color:var(--muted)"></div>
      <div class="table-wrap">
        <table id="attSheetTable">
          <thead><tr><th>#</th><th>Learner</th><th>ID</th><th>Status</th></tr></thead>
          <tbody><tr><td colspan="4" style="text-align:center;color:var(--muted)">Select a class and date to begin.</td></tr></tbody>
        </table>
      </div>
      <div style="margin-top:12px;text-align:right">
        <button class="btn" onclick="saveAttendanceSheet()">💾 Save Attendance</button>
      </div>
      <div id="attSaveAlert" class="alert"></div>
    </div>
    <div class="card">
      <div class="card-title">📋 Attendance Summary (selected class, all recorded dates)</div>
      <div class="table-wrap">
        <table id="attSummaryTable">
          <thead><tr><th>Learner</th><th>Present</th><th>Absent</th><th>Late</th><th>Days Recorded</th><th>Attendance %</th></tr></thead>
          <tbody><tr><td colspan="6" style="text-align:center;color:var(--muted)">Select a class above to see the summary.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- TAB: BURSARS -->
  <div id="tab-bursars" class="admin-section">
    <div class="card">
      <div class="card-title">💰 Bursar Accounts</div>
      <div class="info-note">ℹ️ Bursar accounts can log in to their own portal to set term fees, record payments, and view balances — the same numbers admin sees, kept up to date by the bursar.</div>
      <button class="btn btn-gold" onclick="openModal('addBursarModal');document.getElementById('newBursarName').value='';document.getElementById('newBursarUsername').value='';document.getElementById('newBursarPw').value='';" style="margin-bottom:14px">➕ Add Bursar Account</button>
      <div id="bursarList"></div>
    </div>
  </div>

  <!-- TAB: ALL MARKS -->
  <div id="tab-marks" class="admin-section">
    <div class="card">
      <div class="card-title">📊 All Submitted Marks</div>
      <div class="info-note">ℹ️ Marks are saved per term. Use filters to narrow. Admin can delete individual mark entries.</div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px">
        <input type="text" id="marksSearch" placeholder="🔍  Search learner or subject…" oninput="marksPage=1;renderAdminMarks()" style="max-width:210px;margin:0">
        <select id="marksClassFilter" onchange="marksPage=1;renderAdminMarks()" style="max-width:155px;margin:0"><option value="">All Classes</option></select>
        <select id="marksSubjectFilter" onchange="marksPage=1;renderAdminMarks()" style="max-width:170px;margin:0"><option value="">All Subjects</option></select>
        <select id="marksTermFilter" onchange="marksPage=1;renderAdminMarks()" style="max-width:130px;margin:0">
          <option value="">All Terms</option><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option>
        </select>
        <button class="btn btn-outline btn-sm" onclick="downloadAdminMarksheet()">⬇️ Download Marksheet</button>
      </div>
      <div class="info-note" style="margin-top:0">💡 Pick a <strong>Subject</strong> (and optionally a Class/Term) above, then <strong>⬇️ Download Marksheet</strong> to export that subject's marks to Excel.</div>
      <div id="adminMarksDownloadAlert" class="alert"></div>
      <div class="table-wrap">
        <table id="adminMarksTable">
          <thead><tr>
            <th>Learner</th><th>Class</th><th>Term</th><th>Subject</th>
            <th>A1/3</th><th>Act/20</th><th>End/80</th>
            <th>Total</th><th>Grade</th><th>Comment</th><th>Teacher</th><th>Action</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="pagination" id="marksPagination"></div>
    </div>
  </div>

  <!-- TAB: REPORT CARDS -->
  <div id="tab-reports" class="admin-section">
    <div class="card">
      <div class="card-title">📄 Generate Report Cards</div>
      <div class="grid-3" style="align-items:flex-end;margin-bottom:14px">
        <div class="form-group" style="margin:0">
          <label>Select Learner</label>
          <select id="reportStudent"><option>— Register learners first —</option></select>
        </div>
        <div class="form-group" style="margin:0">
          <label>Term</label>
          <select id="reportTerm"><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select>
        </div>
        <div class="form-group" style="margin:0">
          <label>Academic Year</label>
          <input type="text" id="reportYear" style="margin:0" value="">
        </div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
        <button class="btn btn-primary" onclick="generateReport()">📋 Generate Single</button>
        <button class="btn btn-gold" onclick="printAllReportCards()">🖨 Print All (Selected Class)</button>
        <button class="btn btn-outline" onclick="window.print()">🖨 Print Current</button>
        <button class="btn btn-outline" id="downloadBtn" onclick="downloadPDF()" style="display:none">⬇️ Download PDF</button>
        <button class="btn btn-outline" id="downloadJpgBtn" onclick="downloadReportJPG()" style="display:none">🖼️ Download JPG</button>
        <button class="btn btn-green" id="conductBtn" onclick="openConductModal()" style="display:none">📝 Edit Conduct &amp; Remarks</button>
      </div>
      <div class="info-note">💡 To print <strong>all report cards</strong> for a class: select any learner from that class, choose the term, then click <strong>"Print All"</strong>.</div>
      <div id="reportOutput"></div>
    </div>
  </div>

  <!-- TAB: ANALYTICS -->
  <div id="tab-analytics" class="admin-section">
    <div class="card">
      <div class="card-title">📈 Analytics &amp; Insights</div>
      <div class="grid-2" style="margin-bottom:16px;align-items:flex-end">
        <div class="form-group" style="margin:0">
          <label>Filter by Class</label>
          <select id="analyticsClass" onchange="renderAnalytics()"><option value="">All Classes</option></select>
        </div>
        <div class="form-group" style="margin:0">
          <label>Filter by Term</label>
          <select id="analyticsTerm" onchange="renderAnalytics()">
            <option value="">All Terms</option><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option>
          </select>
        </div>
      </div>
      <div id="analyticsOutput"></div>
    </div>
  </div>

  <!-- TAB: DATA TRANSFER -->
  <div id="tab-transfer" class="admin-section">
    <div class="card">
      <div class="card-title">🗄️ Full System Backup (Recommended)</div>
      <div class="info-note">ℹ️ This app stores everything only on this device's browser — there's no cloud sync. The Excel export below only covers learners &amp; marks. A <strong>Full Backup</strong> saves everything: teachers, parents, bursars, fees, attendance, circulars, messages, school settings, photos and logo — as one file you can restore on a new phone, computer, or browser.</div>
      <div id="backupStatusLine" style="font-size:12px;color:var(--muted);margin-bottom:13px"></div>
      <div class="grid-2">
        <div style="background:var(--soft);border:1px solid var(--border);border-radius:13px;padding:18px">
          <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:5px">⬇️ Download Full Backup</div>
          <p style="font-size:12px;color:var(--muted);margin-bottom:13px">Saves one .json file with the entire database. Keep a copy somewhere safe (email it to yourself, save to cloud storage, etc.).</p>
          <button class="btn btn-primary" onclick="downloadFullBackup()">⬇️ Download Full Backup</button>
        </div>
        <div style="background:var(--soft);border:1px solid var(--border);border-radius:13px;padding:18px">
          <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:5px">📥 Restore Full Backup</div>
          <p style="font-size:12px;color:var(--muted);margin-bottom:13px">Use this on a new device to bring back everything from a backup file.</p>
          <input type="file" id="restoreFile" accept=".json" style="margin-bottom:9px">
          <div class="form-group" style="margin-bottom:9px">
            <label>Restore Mode</label>
            <select id="restoreMode" style="max-width:260px">
              <option value="merge">Merge — keep existing data, add/update from backup</option>
              <option value="replace">Replace Everything — erase current data first</option>
            </select>
          </div>
          <button class="btn btn-gold" onclick="restoreFullBackup()">📥 Restore Backup</button>
        </div>
      </div>
      <div id="fullBackupAlert" class="alert" style="margin-top:13px"></div>
    </div>

    <div class="card">
      <div class="card-title">🔄 Data Transfer — Export &amp; Import</div>
      <p style="font-size:13px;color:var(--muted);margin-bottom:18px">Export to Excel for backup or to share. Import merges data without overwriting existing records.</p>
      <div class="grid-2">
        <div style="background:var(--soft);border:1px solid var(--border);border-radius:13px;padding:18px">
          <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:5px">📤 Export Data</div>
          <p style="font-size:12px;color:var(--muted);margin-bottom:13px">Downloads an Excel file with all learners and all marks.</p>
          <div style="display:flex;gap:7px;flex-wrap:wrap">
            <button class="btn btn-primary" onclick="exportExcel('all')">⬇️ Export All</button>
            <button class="btn btn-outline btn-sm" onclick="exportExcel('students')">👤 Learners Only</button>
            <button class="btn btn-outline btn-sm" onclick="exportExcel('marks')">📝 Marks Only</button>
          </div>
        </div>
        <div style="background:var(--soft);border:1px solid var(--border);border-radius:13px;padding:18px">
          <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:5px">📥 Import Data</div>
          <p style="font-size:12px;color:var(--muted);margin-bottom:13px">Import an Excel file exported from this system. New records are added; existing ones are kept.</p>
          <input type="file" id="importFile" accept=".xlsx,.xls" style="margin-bottom:9px">
          <button class="btn btn-gold" onclick="importExcel()">📥 Import &amp; Merge</button>
          <div id="importProgress" style="display:none;margin-top:9px">
            <div style="background:var(--border);border-radius:20px;height:7px;overflow:hidden">
              <div id="importBar" style="height:100%;background:var(--navy);border-radius:20px;width:0%;transition:width 0.3s"></div>
            </div>
            <div id="importStatus" style="font-size:12px;color:var(--muted);margin-top:5px"></div>
          </div>
        </div>
      </div>
      <div id="transferAlert" class="alert" style="margin-top:13px"></div>
    </div>
  </div>

  <!-- TAB: PARENTS -->
  <div id="tab-parents" class="admin-section">
    <div class="card">
      <div class="card-title">👨‍👩‍👧 Parent / Guardian Accounts</div>
      <div class="info-note">ℹ️ Create login accounts for parents. Each parent is linked to one or more learners by Learner ID. Parents can only see their own child's report cards.</div>
      <button class="btn btn-gold" onclick="openAddParentModal()" style="margin-bottom:14px">➕ Add Parent Account</button>
      <div id="parentList"></div>
    </div>
  </div>

  <!-- TAB: CIRCULARS -->
  <div id="tab-circulars" class="admin-section">
    <div class="card">
      <div class="card-title">📢 School Circulars</div>
      <div class="info-note">ℹ️ Upload a circular after each term. Teachers and parents can view and download all published circulars when they log in.</div>

      <!-- Upload form -->
      <div style="background:var(--soft);border:1px solid var(--border);border-radius:13px;padding:20px;margin-bottom:20px">
        <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:14px">➕ Publish New Circular</div>
        <div class="grid-2">
          <div class="form-group"><label>Circular Title</label><input type="text" id="circularTitle" placeholder="e.g. End of Term 1 Circular — 2025"></div>
          <div class="form-group"><label>Academic Year</label><input type="text" id="circularYear" placeholder="e.g. 2025" style="max-width:160px"></div>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label>Term</label>
            <select id="circularTerm">
              <option value="1">Term 1</option>
              <option value="2">Term 2</option>
              <option value="3">Term 3</option>
            </select>
          </div>
          <div class="form-group">
            <label>Circular File (PDF or Image)</label>
            <input type="file" id="circularFile" accept=".pdf,image/*">
          </div>
        </div>
        <div class="form-group"><label>Additional Notes / Message (optional)</label>
          <textarea id="circularNotes" placeholder="Any important notes for parents and teachers…"></textarea>
        </div>
        <button class="btn btn-gold" onclick="publishCircular()">📤 Publish Circular</button>
        <div id="circularAlert" class="alert" style="margin-top:10px"></div>
      </div>

      <!-- Published circulars list -->
      <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:12px">📋 Published Circulars</div>
      <div id="circularAdminList"><div class="warn-note">No circulars published yet.</div></div>
    </div>
  </div>

  <!-- TAB: MESSAGES -->
  <div id="tab-messages" class="admin-section">
    <div class="card">
      <div class="card-title">💬 Messages with Teachers</div>
      <div class="info-note">ℹ️ Pick a teacher on the left to view or start a conversation. Teachers can message you back from their portal.</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:14px">
        <div style="flex:0 0 230px;min-width:200px">
          <input type="text" id="msgTeacherSearch" placeholder="🔍 Search teacher…" oninput="renderAdminMessageTeacherList()" style="margin-bottom:10px">
          <div id="adminMsgTeacherList" style="max-height:480px;overflow-y:auto;display:flex;flex-direction:column;gap:6px"></div>
        </div>
        <div style="flex:1;min-width:260px;display:flex;flex-direction:column">
          <div class="card-title" id="adminMsgThreadTitle" style="margin:0 0 10px;font-size:14px">Select a teacher to start messaging</div>
          <div id="adminMsgThread" style="flex:1;min-height:320px;max-height:420px;overflow-y:auto;background:var(--soft);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:10px;display:flex;flex-direction:column;gap:10px"></div>
          <div style="display:none;gap:8px" id="adminMsgComposeWrap">
            <textarea id="adminMsgInput" placeholder="Type a message…" style="flex:1;min-height:44px;max-height:120px;resize:vertical;margin:0" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendAdminMessage();}"></textarea>
            <button class="btn btn-primary" onclick="sendAdminMessage()" style="align-self:flex-end">➤ Send</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB: SETTINGS -->
  <div id="tab-settings" class="admin-section">
    <div class="card">
      <div class="card-title">🔑 Change Admin Password</div>
      <div class="grid-3">
        <div class="form-group"><label>Current Password</label><input type="password" id="currentPw" placeholder="Enter current"></div>
        <div class="form-group"><label>New Password</label><input type="password" id="newPw" placeholder="Min 6 characters"></div>
        <div class="form-group"><label>Confirm New Password</label><input type="password" id="confirmPw" placeholder="Repeat new"></div>
      </div>
      <button class="btn btn-primary" onclick="changePassword()">🔒 Update Password</button>
      <div id="pwAlert" class="alert"></div>
    </div>
  </div>

</div><!-- end admin-dashboard -->

<!-- ══ TEACHER GATE ══ -->
<div id="teacher-gate" class="page hidden">
  <div class="card login-card">
    <div class="login-icon">✏️</div>
    <h2>Teacher Portal</h2>
    <p>Login with your username and password</p>
    <div class="form-group"><label>Username</label><input type="text" id="teacherUsername" placeholder="e.g. okello.john" onkeydown="if(event.key==='Enter')teacherLogin()"></div>
    <div class="form-group"><label>Password</label><input type="password" id="teacherLoginPw" placeholder="Your password" onkeydown="if(event.key==='Enter')teacherLogin()"></div>
    <button class="btn btn-primary" style="width:100%;margin-bottom:10px" onclick="teacherLogin()">Open My Marksheets →</button>
    <div id="teacherLoginAlert" class="alert"></div>
  </div>
</div>

<!-- ══ TEACHER DASHBOARD ══ -->
<div id="teacher-dashboard" class="page hidden">
  <div class="card no-print">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px">
      <div>
        <div class="card-title" style="margin:0" id="teacherWelcome">Welcome</div>
        <div id="teacherSubjectsList" style="color:var(--muted);font-size:13px;margin-top:3px"></div>
      </div>
      <button class="btn btn-outline btn-sm" onclick="clearSession();switchPage('teacher-gate');currentTeacherObj=null;">↩ Logout</button>
    </div>
    <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Select a class and term to open your marksheet.</p>
    <div class="grid-3" style="margin-bottom:14px">
      <div class="form-group" style="margin:0">
        <label>Subject</label>
        <select id="teacherSubjectSelect"></select>
      </div>
      <div class="form-group" style="margin:0">
        <label>Class</label>
        <select id="classSelect" onchange="onTeacherClassChange()">
        <option>Loading…</option>
      </select>
      </div>
      <div class="form-group" style="margin:0">
        <label>Term</label>
        <div class="term-pill-wrap" id="teacherTermPills">
          <button class="term-pill active" onclick="selectTermPill(1,this)">Term 1</button>
          <button class="term-pill" onclick="selectTermPill(2,this)">Term 2</button>
          <button class="term-pill" onclick="selectTermPill(3,this)">Term 3</button>
        </div>
      </div>
    </div>
    <button class="btn btn-primary" onclick="openMarksheet()">Open Marksheet →</button>
  </div>

  <!-- Circulars for teachers -->
  <div class="card no-print" style="margin-top:20px">
    <div class="card-title">📢 School Circulars</div>
    <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Latest communications from the school administration.</p>
    <div id="teacherCircularList"><div class="warn-note">No circulars have been published yet.</div></div>
  </div>

  <!-- Messages with admin -->
  <div class="card no-print" style="margin-top:20px">
    <div class="card-title">💬 Messages with Admin</div>
    <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Contact the school administrator directly, or reply to a message from them.</p>
    <div id="teacherMsgThread" style="max-height:360px;overflow-y:auto;background:var(--soft);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:10px;display:flex;flex-direction:column;gap:10px"></div>
    <div style="display:flex;gap:8px">
      <textarea id="teacherMsgInput" placeholder="Type a message to the admin…" style="flex:1;min-height:44px;max-height:120px;resize:vertical;margin:0" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendTeacherMessage();}"></textarea>
      <button class="btn btn-primary" onclick="sendTeacherMessage()" style="align-self:flex-end">➤ Send</button>
    </div>
  </div>
</div>

<!-- ══ TEACHER MARKSHEET ══ -->
<div id="teacher-sheet" class="page hidden">
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px">
      <div>
        <div class="card-title" style="margin:0" id="sheetTitle">Marksheet</div>
        <div id="teacherInfo" style="color:var(--muted);font-size:12px;margin-top:3px"></div>
        <div id="lastSavedLabel" class="last-saved"></div>
      </div>
      <div style="display:flex;gap:7px;flex-wrap:wrap">
        <button class="btn btn-gold" onclick="saveMarks()">💾 Save Marks</button>
        <button class="btn btn-primary" onclick="printMarksheet()">🖨 Print</button>
        <button class="btn btn-outline" onclick="downloadMarksheet()">⬇️ PDF</button>
        <button class="btn btn-outline" onclick="exportMarksheetExcel()">📊 Excel</button>
        <label class="btn btn-outline" style="cursor:pointer;margin:0">📥 Import<input type="file" id="marksheetImportFile" accept=".xlsx,.xls" style="display:none" onchange="importMarksheetExcel(this)"></label>
        <button class="btn btn-outline" onclick="openOcrScan()">📷 Scan Sheet</button>
        <input type="file" id="ocrScanFile" accept="image/*" capture="environment" style="display:none" onchange="handleOcrFile(this)">
        <button class="btn btn-green btn-sm" onclick="openTeacherConductModal()">📝 Conduct</button>
        <button class="btn btn-outline btn-sm" onclick="backFromMarksheet()">← Back</button>
      </div>
    </div>
    <div id="marksheetTransferAlert" class="alert" style="margin-top:0;margin-bottom:9px"></div>
    <div id="secondaryMarksheetInfo">
      <div class="info-note" style="margin-bottom:13px">📐 <strong>Marking scheme:</strong> 1 Integration Activity (/3) scaled to <strong>/20</strong>. End of Term exam <strong>/80</strong>. Total = <strong>/100</strong>.</div>
      <div class="grade-key" style="margin-bottom:13px">
        <span style="font-size:12px;color:var(--muted);font-weight:600;align-self:center">Grade Key:</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#16a34a"></span>A — 80–100</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#1d4ed8"></span>B — 70–79</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#d97706"></span>C — 55–69</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#ea580c"></span>D — 45–54</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#dc2626"></span>E — 0–44</span>
      </div>
    </div>
    <div id="primaryMarksheetInfo" style="display:none">
      <div class="info-note" style="margin-bottom:13px">📐 <strong>Uganda Primary (PLE-style):</strong> enter the End of Term score, plus Mid-Term Set 1 and Set 2 scores — each out of <strong>100</strong>. Grade shown is based on the End of Term score.</div>
      <div class="grade-key" style="margin-bottom:13px">
        <span style="font-size:12px;color:var(--muted);font-weight:600;align-self:center">Grade Key:</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#166534"></span>D1/D2 — 75–100</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#1d4ed8"></span>C3–C6 — 50–74</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#b45309"></span>P7/P8 — 30–49</span>
        <span class="grade-key-item"><span class="grade-key-dot" style="background:#b91c1c"></span>F9 — 0–29</span>
      </div>
    </div>
    <div class="table-wrap">
      <table id="classTable">
        <thead id="classTableHead">
          <tr>
            <th rowspan="2">Learner Name</th>
            <th style="text-align:center;background:#1a3270">Integration Activity (/3)</th>
            <th rowspan="2">Act /20</th>
            <th rowspan="2">End Term /80</th>
            <th rowspan="2">Total /100</th>
            <th rowspan="2">Grade</th>
            <th rowspan="2">Comment</th>
          </tr>
          <tr style="background:#1a3270">
            <th style="font-size:11px">A1 /3</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
