<div id="bursar-dashboard" class="page hidden">
  <div class="card no-print">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div class="card-title" style="margin:0" id="bursarWelcome">Welcome</div>
      <button class="btn btn-outline btn-sm" onclick="clearSession();switchPage('bursar-gate');currentBursarObj=null;">↩ Logout</button>
    </div>
    <p style="font-size:13px;color:var(--muted);margin-top:8px">Set term fees per class, record payments as they come in, and check who still has a balance.</p>
  </div>
  <div id="bursarFeesPanel" class="admin-section active">
    <div class="card">
      <div class="card-title">💰 Set Term Fees (per Class)</div>
      <div class="info-note">ℹ️ Set the expected fee amount for a class, term and academic year. Balances below are calculated against whatever you set here.</div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px">
        <select id="brsStructClass" style="max-width:170px;margin:0"><option value="">Select class…</option></select>
        <select id="brsStructTerm" style="max-width:120px;margin:0">
          <option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option>
        </select>
        <input type="text" id="brsStructYear" placeholder="Year e.g. 2026" style="max-width:110px;margin:0">
        <input type="number" id="brsStructAmount" placeholder="Amount (UGX)" min="0" style="max-width:150px;margin:0">
        <button class="btn btn-sm" onclick="saveFeeStructure()">💾 Save</button>
      </div>
      <div id="brsStructAlert" class="alert"></div>
      <div class="table-wrap">
        <table id="brsStructTable">
          <thead><tr><th>Class</th><th>Term</th><th>Year</th><th>Amount (UGX)</th><th>Action</th></tr></thead>
          <tbody><tr><td colspan="5" style="text-align:center;color:var(--muted)">No fee structure set yet.</td></tr></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-title">🧾 Record a Payment</div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px">
        <select id="brsPayClass" onchange="populateFeePayStudents()" style="max-width:170px;margin:0"><option value="">Select class…</option></select>
        <select id="brsPayStudent" style="max-width:200px;margin:0"><option value="">Select learner…</option></select>
      </div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px;margin-top:8px">
        <select id="brsPayTerm" style="max-width:120px;margin:0">
          <option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option>
        </select>
        <input type="text" id="brsPayYear" placeholder="Year e.g. 2026" style="max-width:110px;margin:0">
        <input type="number" id="brsPayAmount" placeholder="Amount paid (UGX)" min="0" style="max-width:160px;margin:0">
        <input type="date" id="brsPayDate" style="max-width:170px;margin:0">
        <select id="brsPayMethod" style="max-width:150px;margin:0">
          <option value="Cash">Cash</option><option value="Mobile Money">Mobile Money</option><option value="Bank Transfer">Bank Transfer</option><option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group" style="margin-top:8px"><input type="text" id="brsPayNote" placeholder="Note (optional, e.g. receipt number)"></div>
      <button class="btn" onclick="savePayment()">💾 Save Payment</button>
      <div id="brsPayAlert" class="alert"></div>
    </div>

    <div class="card">
      <div class="card-title">📊 Fee Balances</div>
      <div class="search-bar" style="flex-wrap:wrap;gap:7px">
        <input type="text" id="brsBalSearch" placeholder="🔍  Search learner…" oninput="renderFeeBalances()" style="max-width:180px;margin:0">
        <select id="brsBalClass" onchange="renderFeeBalances()" style="max-width:170px;margin:0"><option value="">All Classes</option></select>
        <select id="brsBalTerm" onchange="renderFeeBalances()" style="max-width:120px;margin:0">
          <option value="">All Terms</option><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option>
        </select>
        <input type="text" id="brsBalYear" placeholder="Year" oninput="renderFeeBalances()" style="max-width:100px;margin:0">
        <button class="btn btn-outline btn-sm" onclick="downloadFeeBalances()">⬇️ Download Balances</button>
      </div>
      <div class="table-wrap">
        <table id="brsBalTable">
          <thead><tr><th>Learner</th><th>Class</th><th>Term</th><th>Year</th><th>Expected (UGX)</th><th>Paid (UGX)</th><th>Balance (UGX)</th><th>Status</th></tr></thead>
          <tbody><tr><td colspan="8" style="text-align:center;color:var(--muted)">Set a fee structure and record payments to see balances here.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

