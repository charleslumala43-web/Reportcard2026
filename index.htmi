let currentBursarObj = null;
async function bursarLogin(){
  const username=document.getElementById('bursarUsername').value.trim().toLowerCase();
  const pw=document.getElementById('bursarLoginPw').value;
  if(!username||!pw){showAlert('bursarLoginAlert','Please enter username and password.','error');return;}
  const bursar=await idbGet('bursars',username);
  if(!bursar){showAlert('bursarLoginAlert','Incorrect username or password. Ask admin for your login details.','error');return;}
  const ok=(await hashPw(pw))===bursar.pwHash;
  if(!ok){showAlert('bursarLoginAlert','Incorrect username or password.','error');return;}
  saveSession({role:'bursar',username:bursar.username});
  await openBursarDashboard(bursar);
}

