/* ════════ AUTO STUDENT ID ════════ */
async function autoGenerateStudentId(){
  const cls=document.getElementById('studentClass').value||'';
  // Build prefix from class name: e.g. "S.1 East" → "S1E", "S.6 Arts" → "S6A"
  const clsClean=cls.replace(/\./g,'').replace(/\s+/g,'');
  const prefix=clsClean.substring(0,3).toUpperCase()||'STU';
  // Count existing students in this class to get next number
  const existing=await idbGetByIndex('students','className',cls);
  // Find highest existing number for this prefix
  let maxNum=0;
  const all=await idbGetAll('students');
  all.forEach(s=>{
    if(s.id.startsWith(prefix)){
      const num=parseInt(s.id.replace(prefix,''),10);
      if(!isNaN(num)&&num>maxNum)maxNum=num;
    }
  });
  const nextNum=maxNum+1;
  const newId=prefix+(String(nextNum).padStart(3,'0'));
  document.getElementById('studentId').value=newId;
}

/* ════════ REGISTER STUDENT ════════ */
async function saveStudent(){
  const name=document.getElementById('studentName').value.trim();
  const id=document.getElementById('studentId').value.trim().toUpperCase();
  const cls=document.getElementById('studentClass').value;
  if(!name||!id){showAlert('studentAlert','Please fill in both name and ID.','error');return;}
  // Reject if the selected class is no longer registered in Class Management
  // (e.g. it was deleted while this form was open).
  const registeredClasses=await getClasses();
  if(!cls||!registeredClasses.includes(cls)){showAlert('studentAlert','That class is not registered. Please pick a valid class.','error');return;}
  // S.3/S.4: validate exactly 2 electives chosen
  let registeredSubjects=[];
  if(isS3orS4(cls)){
    const electives=readElectives('studentComboWrap');
    if(!electives||electives.length!==S3S4_ELECTIVE_COUNT){
      showAlert('studentAlert',`Please choose exactly ${S3S4_ELECTIVE_COUNT} elective subjects for ${cls}.`,'error');return;
    }
    registeredSubjects=[...S3S4_COMPULSORY_SUBJECTS,...electives];
  }
  let religion='';
  if(isS1orS2(cls)){
    religion=readReligion('studentComboWrap');
    if(!religion){showAlert('studentAlert',`Please choose CRE or IRE for ${cls}.`,'error');return;}
  }
  const existing=await idbGet('students',id);
  if(existing){showAlert('studentAlert','A learner with that ID already exists.','error');return;}
  const compressed=document.getElementById('studentPhoto')._compressed||'';
  const house=document.getElementById('studentHouse')?document.getElementById('studentHouse').value.trim():'';
  await idbPut('students',{id,name,className:cls,photo:compressed,registeredSubjects,house,religion});
  document.getElementById('studentName').value='';
  document.getElementById('studentId').value='';
  document.getElementById('studentHouse').value='';
  const photoInp=document.getElementById('studentPhoto');
  photoInp.value='';photoInp._compressed=null;
  document.getElementById('photoPreview').style.display='none';
  document.getElementById('studentComboWrap').style.display='none';
  document.getElementById('studentComboWrap').innerHTML='';
  showAlert('studentAlert',`✅ ${name} (${id}) registered${religion?' ('+religion+')':' with '+(registeredSubjects.length||'all')+' subjects'}.`);
  await renderStats();await renderLearnerTable();await loadReportStudents();await populateClassFilters();
  autoGenerateStudentId();
}

/* ════════ BULK IMPORT STUDENTS ════════ */
async function bulkImportStudents(input){
  if(xlsxMissing('studentAlert')){input.value='';return;}
  const file=input.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=async e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws);
      const classes=await getClasses();
      const classLookup=new Map(classes.map(c=>[c.trim().toLowerCase(),c])); // case/whitespace-insensitive match → canonical name
      // Fetch existing learners ONCE instead of one network round-trip per row —
      // this is what used to make imports trickle in "bit by bit".
      const existingStudents=await idbGetAll('students');
      const existingIds=new Set(existingStudents.map(s=>s.id));
      let added=0,skipped=0,pending=0,invalidClass=0;
      const toAdd=[];
      for(const row of rows){
        const id=(row['Learner ID']||row['ID']||'').toString().trim().toUpperCase();
        const name=(row['Full Name']||row['Name']||'').toString().trim();
        const clsRaw=(row['Class']||'').toString().trim();
        if(!id||!name){skipped++;continue;}
        if(existingIds.has(id)){skipped++;continue;}
        // Reject learners whose class isn't one of the classes defined in Class Management.
        const cls=classLookup.get(clsRaw.toLowerCase());
        if(!cls){invalidClass++;continue;}
        // Handle S.3/S.4 subject combinations from "Subjects" column (comma-separated electives).
        // Electives are optional at import time: if missing or invalid, the learner is still
        // imported (compulsories only) and flagged as "Options Pending" so admin can add them later.
        let registeredSubjects=[];
        if(isS3orS4(cls)){
          const subjectCol=(row['Subjects']||row['Electives']||'').toString().trim();
          const electives=subjectCol?subjectCol.split(',').map(s=>s.trim()).filter(Boolean):[];
          const validElectives=electives.filter(s=>!S3S4_COMPULSORY_SUBJECTS.includes(s));
          if(validElectives.length===S3S4_ELECTIVE_COUNT){
            registeredSubjects=[...S3S4_COMPULSORY_SUBJECTS,...validElectives];
          }else{
            registeredSubjects=[...S3S4_COMPULSORY_SUBJECTS]; // no electives yet — pending
            pending++;
          }
        }
        // S.1/S.2: optional "Religion" / "RE" column with CRE or IRE; if missing the learner is flagged "Options Pending".
        let religion='';
        if(isS1orS2(cls)){
          const reRaw=(row['Religion']||row['RE']||row['CRE/IRE']||'').toString().trim().toUpperCase();
          if(reRaw==='CRE'||reRaw==='IRE')religion=reRaw;else pending++;
        }
        existingIds.add(id); // guard against duplicate IDs within the same file
        toAdd.push({id,name,className:cls,photo:'',registeredSubjects,religion});
        added++;
      }
      // Write everyone in one bulk IndexedDB transaction instead of one write
      // call per learner, so the whole import lands essentially at once.
      const CHUNK=450;
      for(let i=0;i<toAdd.length;i+=CHUNK){
        await idbPutMany('students', toAdd.slice(i,i+CHUNK));
      }
      input.value='';
      const pendingMsg=pending?`, ⚠️ ${pending} need${pending===1?'s':''} electives / CRE-IRE choice added`:'';
      const invalidMsg=invalidClass?`, 🚫 ${invalidClass} rejected (class not in system)`:'';
      showAlert('studentAlert',`✅ Bulk import done — Added ${added} learner(s), skipped ${skipped} (duplicates/blanks)${invalidMsg}${pendingMsg}.`);
      await renderStats();await renderLearnerTable();await loadReportStudents();await populateClassFilters();
    }catch(err){input.value='';showAlert('studentAlert','Bulk import failed: '+err.message,'error');}
  };
  reader.readAsArrayBuffer(file);
}

/* ════════ EDIT STUDENT ════════ */
async function openEditStudent(id){
  const student=await idbGet('students',id);if(!student)return;
  document.getElementById('editStudentOrigId').value=id;
  document.getElementById('editStudentName').value=student.name;
  document.getElementById('editStudentId').value=student.id;
  document.getElementById('editStudentClass').value=student.className;
  document.getElementById('editStudentHouse').value=student.house||'';
  document.getElementById('editPhotoPreview').style.display='none';
  const inp=document.getElementById('editStudentPhoto');inp.value='';inp._compressed=null;
  if(student.photo){
    document.getElementById('editPhotoPreviewImg').src=student.photo;
    document.getElementById('editPhotoPreviewSize').textContent=`Saved photo — ~${kb(student.photo)} KB`;
    document.getElementById('editPhotoPreview').style.display='flex';
  }
  // Pre-load existing electives for S.3/S.4
  window._editingElectives=(student.registeredSubjects||[]).filter(s=>!S3S4_COMPULSORY_SUBJECTS.includes(s));
  window._editingReligion=student.religion||'';
  await renderSubjectCombo('editStudentClass','editComboWrap',true);
  openModal('editStudentModal');
}

async function saveEditStudent(){
  const origId=document.getElementById('editStudentOrigId').value;
  const newName=document.getElementById('editStudentName').value.trim();
  const newId=document.getElementById('editStudentId').value.trim().toUpperCase();
  const newClass=document.getElementById('editStudentClass').value;
  if(!newName||!newId){showAlert('editStudentAlert','Name and ID are required.','error');return;}
  // Reject if the selected class is no longer registered in Class Management.
  const registeredClasses=await getClasses();
  if(!newClass||!registeredClasses.includes(newClass)){showAlert('editStudentAlert','That class is not registered. Please pick a valid class.','error');return;}
  // S.3/S.4: validate electives
  let registeredSubjects=[];
  if(isS3orS4(newClass)){
    const electives=readElectives('editComboWrap');
    if(!electives||electives.length!==S3S4_ELECTIVE_COUNT){
      showAlert('editStudentAlert',`Please choose exactly ${S3S4_ELECTIVE_COUNT} elective subjects for ${newClass}.`,'error');return;
    }
    registeredSubjects=[...S3S4_COMPULSORY_SUBJECTS,...electives];
  }
  let religion='';
  if(isS1orS2(newClass)){
    religion=readReligion('editComboWrap');
    if(!religion){showAlert('editStudentAlert',`Please choose CRE or IRE for ${newClass}.`,'error');return;}
  }
  const oldStudent=await idbGet('students',origId);
  if(!oldStudent){showAlert('editStudentAlert','Student not found.','error');return;}
  if(newId!==origId){
    const conflict=await idbGet('students',newId);
    if(conflict){showAlert('editStudentAlert','That Learner ID is already taken.','error');return;}
  }
  const newPhoto=document.getElementById('editStudentPhoto')._compressed||oldStudent.photo||'';
  const house=document.getElementById('editStudentHouse')?document.getElementById('editStudentHouse').value.trim():'';
  const updatedStudent={id:newId,name:newName,className:newClass,photo:newPhoto,registeredSubjects,house,religion};
  if(newId!==origId){
    await idbDelete('students',origId);
    const oldMarks=await idbGetByIndex('marks','studentId',origId);
    for(const m of oldMarks){
      await idbDelete('marks',m._key);
      m.studentId=newId;
      m._key=`${newId}:${m.subject}:${m.term}`;
      m.className=newClass;
      await idbPut('marks',m);
    }
    const oldConducts=await idbGetAll('conduct');
    for(const c of oldConducts){
      if(c.studentId===origId){
        await idbDelete('conduct',c._key);
        c.studentId=newId;
        c._key=`${newId}:${c.term}`;
        await idbPut('conduct',c);
      }
    }
  }
  await idbPut('students',updatedStudent);
  closeModal('editStudentModal');
  showAlert('studentAlert',`✅ Learner "${newName}" updated successfully.`);
  await renderStats();await renderLearnerTable();await loadReportStudents();await populateClassFilters();
}

async function deleteStudent(id){
  if(!confirm(`Delete learner ${id} and all their marks? This cannot be undone.`))return;
  await idbDelete('students',id);
  const marks=await idbGetByIndex('marks','studentId',id);
  for(const m of marks)await idbDelete('marks',m._key);
  const conducts=await idbGetAll('conduct');
  for(const c of conducts){if(c.studentId===id)await idbDelete('conduct',c._key);}
  await renderStats();await renderLearnerTable();await renderAdminMarks();await loadReportStudents();
  showAlert('studentAlert','Learner deleted.','error');
}

async function clearAll(){
  if(!confirm('Delete ALL learners, marks, and conduct records? This cannot be undone.'))return;
  await idbClear('students');await idbClear('marks');await idbClear('conduct');
  await renderStats();await renderLearnerTable();await renderAdminMarks();await loadReportStudents();
  showAlert('studentAlert','All data cleared.','error');
}

/* ════════ LEARNER TABLE ════════ */
async function renderLearnerTable(){
  const search=(document.getElementById('learnerSearch')?.value||'').toLowerCase();
  const classF=document.getElementById('learnerClassFilter')?.value||'';
  const pendingOnly=document.getElementById('learnerPendingOnly')?.checked||false;
  let students=await idbGetAll('students');
  students=students.filter(s=>{
    const t=s.name.toLowerCase().includes(search)||s.id.toLowerCase().includes(search);
    const c=!classF||s.className===classF;
    const p=!pendingOnly||studentNeedsElectives(s);
    return t&&c&&p;
  }).sort((a,b)=>a.name.localeCompare(b.name));
  const total=students.length;
  const totalPages=Math.max(1,Math.ceil(total/PER_PAGE));
  if(learnerPage>totalPages)learnerPage=totalPages;
  const slice=students.slice((learnerPage-1)*PER_PAGE,learnerPage*PER_PAGE);
  const body=document.querySelector('#learnersTable tbody');if(!body)return;
  body.innerHTML='';
  if(!slice.length){
    body.innerHTML='<tr class="empty-row"><td colspan="6">No learners found.</td></tr>';
  } else {
    slice.forEach((s,i)=>{
      const n=(learnerPage-1)*PER_PAGE+i+1;
      const ph=s.photo?`<img src="${s.photo}" style="width:30px;height:36px;object-fit:cover;border-radius:4px;border:1px solid var(--border)">`:'<span style="color:var(--muted);font-size:17px">👤</span>';
      const needsOptions=studentNeedsElectives(s);
      const classBadge=s.graduatedAt
        ?`<span class="badge badge-gold" title="Graduated ${new Date(s.graduatedAt).toLocaleDateString()} · was ${s.priorClassName||'—'}">🎓 Graduated</span>`
        :`<span class="badge badge-navy">${s.className}</span>`;
      body.innerHTML+=`<tr>
        <td style="color:var(--muted);font-size:12px">${n}</td>
        <td><strong>${s.name}</strong>${s.religion&&isS1orS2(s.className)?` <span class="badge badge-navy" style="font-size:10px">${s.religion}</span>`:''}</td>
        <td style="font-family:monospace;font-size:12px">${s.id}</td>
        <td>${classBadge}${needsOptions?' <span class="badge badge-danger" style="font-size:10px" title="Electives / CRE-IRE choice not set yet">⚠️ Options Pending</span>':''}</td>
        <td>${ph}</td>
        <td style="display:flex;gap:5px;flex-wrap:wrap;align-items:center">
          ${needsOptions?`<button class="btn btn-gold btn-xs" onclick="openEditStudent('${s.id}')">➕ Add Options</button>`:''}
          ${s.graduatedAt?`<button class="btn btn-green btn-xs" onclick="reinstateStudent('${s.id}')">↩️ Reinstate</button>`:''}
          <button class="btn btn-outline btn-xs" onclick="openEditStudent('${s.id}')">✏️ Edit</button>
          <button class="btn btn-danger btn-xs" onclick="deleteStudent('${s.id}')">🗑</button>
        </td>
      </tr>`;
    });
  }
  renderPagination('learnerPagination',learnerPage,totalPages,total,'learnerPage','renderLearnerTable');
}

/* ════════ PROMOTE LEARNERS ════════ */
const ALUMNI_OPT='__ALUMNI__';
function suggestNextClass(name,classes){
  const nursery=['Baby Class','Middle Class','Top Class','P.1'];
  const ni=nursery.indexOf(name);
  if(ni>=0&&ni<3&&classes.includes(nursery[ni+1]))return nursery[ni+1];
  const m=name.match(/^(S|P)\.?\s*(\d)(.*)$/i);
  if(m){
    const pre=m[1].toUpperCase()+'.',n=Number(m[2]);
    const exact=`${pre}${n+1}${m[3]}`;
    if(classes.includes(exact))return exact;
    const any=classes.find(c=>c.startsWith(`${pre}${n+1}`));
    if(any)return any;
    if((m[1].toUpperCase()==='S'&&n>=6)||(m[1].toUpperCase()==='P'&&n>=7))return ALUMNI_OPT;
  }
  return '';
}
async function renderPromotePanel(){
  const from=document.getElementById('promoteFrom');if(!from)return;
  const classes=await getClasses();
  const prevFrom=from.value;
  from.innerHTML=classes.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
  if(prevFrom&&classes.includes(prevFrom))from.value=prevFrom;
  await promoteFromChanged();
}
async function promoteFromChanged(){
  const classes=await getClasses();
  const from=document.getElementById('promoteFrom').value;
  const to=document.getElementById('promoteTo');
  const sug=suggestNextClass(from,classes);
  to.innerHTML='<option value="">— Choose class —</option>'
    +classes.filter(c=>c!==from).map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('')
    +`<option value="${ALUMNI_OPT}">🎓 Alumni (finished school)</option>`;
  if(sug)to.value=sug;
  const students=(await idbGetByIndex('students','className',from)).sort((a,b)=>a.name.localeCompare(b.name));
  const list=document.getElementById('promoteList');
  list.innerHTML=students.length?students.map(st=>`<label style="display:flex;align-items:center;gap:9px;padding:7px 2px;border-bottom:1px solid var(--border);text-transform:none;font-size:13px;margin:0;cursor:pointer;color:var(--text)"><input type="checkbox" class="pchk" value="${escapeHtml(String(st.id))}" checked style="width:auto;margin:0" onchange="updatePromoteCount()"><span style="flex:1"><strong>${escapeHtml(st.name)}</strong></span><span style="color:var(--muted);font-size:11px">${escapeHtml(String(st.id))}</span></label>`).join(''):'<div style="padding:14px;text-align:center;color:var(--muted);font-size:13px">No learners in this class.</div>';
  document.getElementById('promoteAll').checked=true;
  updatePromoteCount();
}
function updatePromoteCount(){
  const all=document.querySelectorAll('#promoteList .pchk');
  const on=[...all].filter(c=>c.checked).length;
  const el=document.getElementById('promoteCount');if(el)el.textContent=all.length?`${on} of ${all.length} will be promoted${all.length-on?' · '+(all.length-on)+' repeating':''}`:'';
}
async function runPromotion(){
  const from=document.getElementById('promoteFrom').value;
  let to=document.getElementById('promoteTo').value;
  const ids=[...document.querySelectorAll('#promoteList .pchk')].filter(c=>c.checked).map(c=>c.value);
  if(!to){showAlert('promoteAlert','Please choose the class to promote to.','error');return;}
  if(to===from){showAlert('promoteAlert','The new class must be different from the current one.','error');return;}
  if(!ids.length){showAlert('promoteAlert','No learners are selected.','error');return;}
  const toLabel=to===ALUMNI_OPT?'Alumni':to;
  if(!confirm(`Promote ${ids.length} learner(s) from ${from} to ${toLabel}?\n\nTheir marks and history are kept. Make sure this year's report cards are already printed. A backup is recommended first.`))return;
  try{
    if(to===ALUMNI_OPT){
      const lvl=await getClassLevel(from);
      to=isPrimaryTier(lvl)?'Alumni (Primary)':'Alumni';
      const existing=await idbGet('classes',to);
      if(!existing)await idbPut('classes',{name:to,level:isPrimaryTier(lvl)?'primary_upper':'secondary'});
    }
    const info=(await idbGet('school','info'))||{};
    const year=info.academicYear||new Date().getFullYear();
    const recs=[];
    for(const id of ids){
      const st=await idbGet('students',id);if(!st)continue;
      const keepSubjects=isS3orS4(st.className)===isS3orS4(to);   // S.3→S.4 keeps electives; entering/leaving S.3/S.4 needs a fresh choice
      recs.push({...st,className:to,registeredSubjects:keepSubjects?(st.registeredSubjects||[]):[],religion:(isS1orS2(to)&&isS1orS2(st.className))?(st.religion||''):'',
        promotionHistory:[...(st.promotionHistory||[]),{from,to,year:String(year),date:new Date().toISOString()}]});
    }
    await idbPutMany('students',recs);   // all-or-nothing
    const needOptions=(isS3orS4(to)&&!isS3orS4(from))||(isS1orS2(to)&&!isS1orS2(from));
    showAlert('promoteAlert',`✅ ${recs.length} learner(s) promoted from ${from} to ${to}.${needOptions?' Their subject options now need to be set (see "Options Pending" filter below).':''} Remember to update teachers' class assignments.`);
    await populateClassSelects();await populateClassFilters();
    await promoteFromChanged();
    if(typeof renderLearnerTable==='function'){learnerPage=1;await renderLearnerTable();}
  }catch(err){
    console.error('Promotion failed',err);
    showAlert('promoteAlert','Promotion failed — nobody was moved: '+err.message,'error');
  }
}

/* ════════ CLASS FILTERS ════════ */
async function populateClassFilters(){
  // Only show classes registered in Class Management — never stray/orphaned
  // class names left behind on student records (e.g. from a deleted class).
  const classes=await getClasses();
  ['learnerClassFilter','marksClassFilter','analyticsClass'].forEach(id=>{
    const sel=document.getElementById(id);if(!sel)return;
    const cur=sel.value;
    sel.innerHTML='<option value="">All Classes</option>'+classes.map(c=>`<option value="${c}"${c===cur?' selected':''}>${c}</option>`).join('');
  });
  const subjSel=document.getElementById('marksSubjectFilter');
  if(subjSel){
    const subjects=await getSubjects();
    const cur=subjSel.value;
    subjSel.innerHTML='<option value="">All Subjects</option>'+subjects.map(s=>`<option value="${s}"${s===cur?' selected':''}>${s}</option>`).join('');
  }
}

/* ════════ PROMOTE / MOVE / GRADUATE LEARNERS ════════
   Bulk-moves selected learners from one class to another (e.g. end-of-year
   promotion), or "graduates" them out of active classes entirely. Marks and
   conduct records are keyed by studentId+term+year (not by class), so past
   report cards stay correct no matter what class the learner is in now. */
async function populatePromoteClasses(){
  const classes=await getClasses();
  const fromSel=document.getElementById('promoteFromClass');
  const toSel=document.getElementById('promoteToClass');
  if(!fromSel||!toSel)return;
  const prevFrom=fromSel.value,prevTo=toSel.value;
  fromSel.innerHTML='<option value="">Select class…</option>'+classes.map(c=>`<option value="${c}">${c}</option>`).join('');
  if(classes.includes(prevFrom))fromSel.value=prevFrom;
  toSel.innerHTML='<option value="">Select destination…</option>'+classes.map(c=>`<option value="${c}">${c}</option>`).join('')+'<option value="__graduate__">🎓 Graduate (remove from active classes)</option>';
  if(prevTo&&(classes.includes(prevTo)||prevTo==='__graduate__'))toSel.value=prevTo;
}

async function loadPromoteStudentList(){
  const fromClass=document.getElementById('promoteFromClass').value;
  const wrap=document.getElementById('promoteStudentListWrap');
  const list=document.getElementById('promoteStudentList');
  const selectAll=document.getElementById('promoteSelectAll');
  if(!fromClass){wrap.style.display='none';list.innerHTML='';return;}
  const students=(await idbGetByIndex('students','className',fromClass)).sort((a,b)=>a.name.localeCompare(b.name));
  wrap.style.display='block';
  if(selectAll)selectAll.checked=false;
  if(!students.length){
    list.innerHTML='<div style="text-align:center;color:var(--muted);padding:20px;font-size:13px">No learners currently in this class.</div>';
    document.getElementById('promoteCountLabel').textContent='';
    return;
  }
  list.innerHTML=students.map(s=>`
    <label style="display:flex;align-items:center;gap:9px;padding:7px 4px;border-bottom:1px solid var(--border);cursor:pointer;font-size:13px">
      <input type="checkbox" class="promote-student-cb" value="${s.id}" onchange="updatePromoteCountLabel()" style="width:auto">
      <span style="font-weight:600">${s.name}</span>
      <span style="color:var(--muted);font-family:monospace;font-size:11px">${s.id}</span>
    </label>`).join('');
  updatePromoteCountLabel();
}

function togglePromoteSelectAll(cb){
  document.querySelectorAll('.promote-student-cb').forEach(el=>el.checked=cb.checked);
  updatePromoteCountLabel();
}

function updatePromoteCountLabel(){
  const total=document.querySelectorAll('.promote-student-cb').length;
  const checked=document.querySelectorAll('.promote-student-cb:checked').length;
  const label=document.getElementById('promoteCountLabel');
  if(label)label.textContent=total?`${checked} of ${total} selected`:'';
}

async function promoteSelectedStudents(){
  const fromClass=document.getElementById('promoteFromClass').value;
  const toClass=document.getElementById('promoteToClass').value;
  const ids=[...document.querySelectorAll('.promote-student-cb:checked')].map(el=>el.value);
  if(!fromClass){showAlert('promoteAlert','Select a class to move learners from.','error');return;}
  if(!toClass){showAlert('promoteAlert','Select a destination.','error');return;}
  if(!ids.length){showAlert('promoteAlert','Select at least one learner to move.','error');return;}
  const graduating=toClass==='__graduate__';
  const confirmMsg=graduating
    ?`Graduate ${ids.length} learner(s) out of "${fromClass}"? They'll be marked as alumni and removed from active class lists, marksheets and attendance — but all their past marks and report cards stay safe.`
    :`Move ${ids.length} learner(s) from "${fromClass}" to "${toClass}"? Past marks and report cards for previous terms stay unchanged.`;
  if(!confirm(confirmMsg))return;
  for(const id of ids){
    const s=await idbGet('students',id);
    if(!s)continue;
    if(graduating){
      s.priorClassName=s.className;
      s.className='🎓 Graduated';
      s.graduatedAt=new Date().toISOString();
    } else {
      delete s.priorClassName;
      delete s.graduatedAt;
      s.className=toClass;
    }
    await idbPut('students',s);
  }
  await renderStats();
  await renderLearnerTable();
  await loadReportStudents();
  await populateClassFilters();
  await loadPromoteStudentList();
  showAlert('promoteAlert',graduating?`🎓 ${ids.length} learner(s) graduated.`:`✅ ${ids.length} learner(s) moved to "${toClass}".`);
}

async function reinstateStudent(id){
  const s=await idbGet('students',id);
  if(!s||!s.graduatedAt)return;
  const target=s.priorClassName||'';
  if(!confirm(`Move ${s.name} back to "${target||'their previous class'}"?`))return;
  s.className=target;
  delete s.priorClassName;
  delete s.graduatedAt;
  await idbPut('students',s);
  await renderStats();await renderLearnerTable();await loadReportStudents();await populateClassFilters();
  showAlert('studentAlert',`↩️ ${s.name} reinstated to "${target}".`);
}

/* ════════ ATTENDANCE ════════ */
let _attCurrentStatuses = {}; // studentId -> 'P'|'A'|'L', for the currently loaded class+date sheet

async function populateAttendanceClassSelect(){
  const sel=document.getElementById('attClassSelect');if(!sel)return;
  const cur=sel.value;
  const classes=await getClasses();
  sel.innerHTML='<option value="">Select class…</option>'+classes.map(c=>`<option value="${c}"${c===cur?' selected':''}>${c}</option>`).join('');
  const dateEl=document.getElementById('attDate');
  if(dateEl && !dateEl.value){
    const d=new Date();
    dateEl.value=d.toISOString().slice(0,10);
  }
}

async function renderAttendanceTab(){
  await populateAttendanceClassSelect();
  await loadAttendanceSheet();
}

function _attKey(className,date,studentId){ return `${className}::${date}::${studentId}`; }

async function loadAttendanceSheet(){
  const className=document.getElementById('attClassSelect').value;
  const date=document.getElementById('attDate').value;
  const tbody=document.querySelector('#attSheetTable tbody');
  const summaryBar=document.getElementById('attSummaryBar');
  if(!className||!date){
    tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--muted)">Select a class and date to begin.</td></tr>';
    summaryBar.textContent='';
    document.querySelector('#attSummaryTable tbody').innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--muted)">Select a class above to see the summary.</td></tr>';
    return;
  }
  const students=(await idbGetByIndex('students','className',className)).sort((a,b)=>a.name.localeCompare(b.name));
  const existing=await idbGetByIndex('attendance','className',className);
  const forDate=existing.filter(r=>r.date===date);
  _attCurrentStatuses={};
  forDate.forEach(r=>{_attCurrentStatuses[r.studentId]=r.status;});
  if(!students.length){
    tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--muted)">No learners registered in this class yet.</td></tr>';
  } else {
    tbody.innerHTML=students.map((s,i)=>{
      const st=_attCurrentStatuses[s.id]||'P';
      return `<tr>
        <td>${i+1}</td><td>${s.name}</td><td>${s.id}</td>
        <td>
          <div style="display:flex;gap:5px" data-student="${s.id}">
            <button type="button" class="btn btn-sm ${st==='P'?'':'btn-outline'}" style="${st==='P'?'background:#166534;color:#fff':''}" onclick="setAttendanceStatus('${s.id}','P')">Present</button>
            <button type="button" class="btn btn-sm ${st==='A'?'':'btn-outline'}" style="${st==='A'?'background:#c0392b;color:#fff':''}" onclick="setAttendanceStatus('${s.id}','A')">Absent</button>
            <button type="button" class="btn btn-sm ${st==='L'?'':'btn-outline'}" style="${st==='L'?'background:#9a3412;color:#fff':''}" onclick="setAttendanceStatus('${s.id}','L')">Late</button>
          </div>
        </td>
      </tr>`;
    }).join('');
    students.forEach(s=>{ if(!_attCurrentStatuses[s.id]) _attCurrentStatuses[s.id]='P'; });
  }
  summaryBar.textContent=`${students.length} learner(s) in ${className} for ${date}.`;
  await renderAttendanceSummary(className);
}

function setAttendanceStatus(studentId,status){
  _attCurrentStatuses[studentId]=status;
  const row=document.querySelector(`[data-student="${studentId}"]`);
  if(!row)return;
  const map={P:{bg:'#166534'},A:{bg:'#c0392b'},L:{bg:'#9a3412'}};
  [...row.children].forEach(btn=>{
    const s=btn.textContent.trim()[0]; // 'P','A','L'
    if(s===status){btn.classList.remove('btn-outline');btn.style.background=map[status].bg;btn.style.color='#fff';}
    else{btn.classList.add('btn-outline');btn.style.background='';btn.style.color='';}
  });
}

function markAllAttendance(status){
  document.querySelectorAll('#attSheetTable [data-student]').forEach(row=>{
    setAttendanceStatus(row.getAttribute('data-student'),status);
  });
}

async function saveAttendanceSheet(){
  const className=document.getElementById('attClassSelect').value;
  const date=document.getElementById('attDate').value;
  if(!className||!date){showAlert('attSaveAlert','Please select a class and date first.','error');return;}
  const records=Object.entries(_attCurrentStatuses).map(([studentId,status])=>({
    _key:_attKey(className,date,studentId),className,date,studentId,status,markedAt:Date.now()
  }));
  if(!records.length){showAlert('attSaveAlert','No learners to save for this class.','error');return;}
  await idbPutMany('attendance',records);
  showAlert('attSaveAlert',`✅ Attendance saved for ${className} — ${date} (${records.length} learner(s)).`);
  await renderAttendanceSummary(className);
}

async function renderAttendanceSummary(className){
  const tbody=document.querySelector('#attSummaryTable tbody');
  if(!className){tbody.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--muted)">Select a class above to see the summary.</td></tr>';return;}
  const [students,records]=await Promise.all([
    idbGetByIndex('students','className',className),
    idbGetByIndex('attendance','className',className)
  ]);
  if(!students.length){tbody.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--muted)">No learners registered in this class yet.</td></tr>';return;}
  students.sort((a,b)=>a.name.localeCompare(b.name));
  tbody.innerHTML=students.map(s=>{
    const mine=records.filter(r=>r.studentId===s.id);
    const p=mine.filter(r=>r.status==='P').length;
    const a=mine.filter(r=>r.status==='A').length;
    const l=mine.filter(r=>r.status==='L').length;
    const total=mine.length;
    const pct=total?Math.round(((p+l)/total)*100):0; // Late still counts as attended for the %
    return `<tr><td>${s.name}</td><td>${p}</td><td>${a}</td><td>${l}</td><td>${total}</td><td>${total?pct+'%':'—'}</td></tr>`;
  }).join('');
}

/* ════════ FEES ════════ */
let _lastFeeBalanceRows = [];

function formatUGX(n){ return 'UGX ' + Number(n||0).toLocaleString(); }

async function populateFeesClassSelects(){
  const classes=await getClasses();
  ['brsStructClass','brsPayClass','brsBalClass'].forEach(id=>{
    const sel=document.getElementById(id);if(!sel)return;
    const cur=sel.value;
    const allOpt=id==='brsBalClass'?'<option value="">All Classes</option>':'<option value="">Select class…</option>';
    sel.innerHTML=allOpt+classes.map(c=>`<option value="${c}"${c===cur?' selected':''}>${c}</option>`).join('');
  });
}

async function renderBursarFeesPanel(){
  await populateFeesClassSelects();
  const info=await idbGet('school','info')||{};
  const year=info.academicYear||new Date().getFullYear();
  ['brsStructYear','brsPayYear','brsBalYear'].forEach(id=>{
    const el=document.getElementById(id);
    if(el&&!el.value)el.value=year;
  });
  const dateEl=document.getElementById('brsPayDate');
  if(dateEl&&!dateEl.value)dateEl.value=new Date().toISOString().slice(0,10);
  await renderFeeStructureTable();
  await populateFeePayStudents();
  await renderFeeBalances();
}

async function saveFeeStructure(){
  const className=document.getElementById('brsStructClass').value;
  const term=document.getElementById('brsStructTerm').value;
  const year=document.getElementById('brsStructYear').value.trim();
  const amount=Number(document.getElementById('brsStructAmount').value);
  if(!className||!year||!amount||amount<=0){showAlert('brsStructAlert','Please select a class and enter a valid year and amount.','error');return;}
  await idbPut('feeStructure',{_key:`${className}::${term}::${year}`,className,term,year,amount});
  document.getElementById('brsStructAmount').value='';
  showAlert('brsStructAlert',`✅ Fee set: ${className} — Term ${term} (${year}) — ${formatUGX(amount)}.`);
  await renderFeeStructureTable();
  await renderFeeBalances();
}

async function renderFeeStructureTable(){
  const tbody=document.querySelector('#brsStructTable tbody');
  const rows=(await idbGetAll('feeStructure')).sort((a,b)=>a.className.localeCompare(b.className)||a.term-b.term||a.year.localeCompare(b.year));
  if(!rows.length){tbody.innerHTML='<tr><td colspan="5" style="text-align:center;color:var(--muted)">No fee structure set yet.</td></tr>';return;}
  tbody.innerHTML=rows.map(r=>`<tr>
    <td>${r.className}</td><td>Term ${r.term}</td><td>${r.year}</td><td>${formatUGX(r.amount)}</td>
    <td><button class="btn btn-danger btn-xs" onclick="deleteFeeStructure('${r._key}')">🗑</button></td>
  </tr>`).join('');
}

async function deleteFeeStructure(key){
  if(!confirm('Delete this fee structure entry? Existing payment records are kept.'))return;
  await idbDelete('feeStructure',key);
  await renderFeeStructureTable();
  await renderFeeBalances();
}

async function populateFeePayStudents(){
  const className=document.getElementById('brsPayClass').value;
  const sel=document.getElementById('brsPayStudent');if(!sel)return;
  if(!className){sel.innerHTML='<option value="">Select learner…</option>';return;}
  const students=(await idbGetByIndex('students','className',className)).sort((a,b)=>a.name.localeCompare(b.name));
  sel.innerHTML='<option value="">Select learner…</option>'+students.map(s=>`<option value="${s.id}">${s.name} (${s.id})</option>`).join('');
}

async function savePayment(){
  const studentId=document.getElementById('brsPayStudent').value;
  const className=document.getElementById('brsPayClass').value;
  const term=document.getElementById('brsPayTerm').value;
  const year=document.getElementById('brsPayYear').value.trim();
  const amount=Number(document.getElementById('brsPayAmount').value);
  const date=document.getElementById('brsPayDate').value;
  const method=document.getElementById('brsPayMethod').value;
  const note=document.getElementById('brsPayNote').value.trim();
  if(!studentId){showAlert('brsPayAlert','Please select a class and learner first.','error');return;}
  if(!year||!amount||amount<=0||!date){showAlert('brsPayAlert','Please enter a valid year, amount and date.','error');return;}
  await idbPut('feePayments',{id:`${Date.now()}_${Math.random().toString(36).slice(2,7)}`,studentId,className,term,year,amount,date,method,note,recordedAt:Date.now()});
  document.getElementById('brsPayAmount').value='';
  document.getElementById('brsPayNote').value='';
  showAlert('brsPayAlert',`✅ Payment of ${formatUGX(amount)} recorded.`);
  await renderFeeBalances();
}

async function renderFeeBalances(){
  const tbody=document.querySelector('#brsBalTable tbody');
  const search=(document.getElementById('brsBalSearch')?.value||'').toLowerCase().trim();
  const classF=document.getElementById('brsBalClass')?.value||'';
  const termF=document.getElementById('brsBalTerm')?.value||'';
  const yearF=(document.getElementById('brsBalYear')?.value||'').trim();
  let structure=await idbGetAll('feeStructure');
  if(classF)structure=structure.filter(s=>s.className===classF);
  if(termF)structure=structure.filter(s=>String(s.term)===String(termF));
  if(yearF)structure=structure.filter(s=>s.year===yearF);
  if(!structure.length){
    tbody.innerHTML='<tr><td colspan="8" style="text-align:center;color:var(--muted)">No matching fee structure found. Set one above first.</td></tr>';
    _lastFeeBalanceRows=[];
    return;
  }
  const [allStudents,allPayments]=await Promise.all([idbGetAll('students'),idbGetAll('feePayments')]);
  let rows=[];
  structure.sort((a,b)=>a.className.localeCompare(b.className)||a.term-b.term).forEach(entry=>{
    let classStudents=allStudents.filter(s=>s.className===entry.className);
    if(search)classStudents=classStudents.filter(s=>s.name.toLowerCase().includes(search)||String(s.id).toLowerCase().includes(search));
    classStudents.sort((a,b)=>a.name.localeCompare(b.name)).forEach(s=>{
      const paid=allPayments.filter(p=>p.studentId===s.id&&String(p.term)===String(entry.term)&&p.year===entry.year)
        .reduce((sum,p)=>sum+Number(p.amount||0),0);
      const balance=Number(entry.amount)-paid;
      rows.push({name:s.name,id:s.id,className:entry.className,term:entry.term,year:entry.year,expected:Number(entry.amount),paid,balance});
    });
  });
  _lastFeeBalanceRows=rows;
  if(!rows.length){tbody.innerHTML='<tr><td colspan="8" style="text-align:center;color:var(--muted)">No learners match this filter.</td></tr>';return;}
  tbody.innerHTML=rows.map(r=>{
    const status=r.balance<=0?'<span class="badge badge-green">Cleared</span>':'<span class="badge badge-danger">Balance</span>';
    return `<tr>
      <td>${r.name}</td><td>${r.className}</td><td>Term ${r.term}</td><td>${r.year}</td>
      <td>${formatUGX(r.expected)}</td><td>${formatUGX(r.paid)}</td><td>${formatUGX(Math.max(r.balance,0))}</td><td>${status}</td>
    </tr>`;
  }).join('');
}

function downloadFeeBalances(){
  if(!_lastFeeBalanceRows.length){showAlert('brsStructAlert','No balances to download — adjust the filters above first.','error');return;}
  const sheetRows=_lastFeeBalanceRows.map(r=>({'Learner ID':r.id,'Full Name':r.name,'Class':r.className,'Term':r.term,'Year':r.year,'Expected (UGX)':r.expected,'Paid (UGX)':r.paid,'Balance (UGX)':Math.max(r.balance,0),'Status':r.balance<=0?'Cleared':'Balance'}));
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.json_to_sheet(sheetRows);
  ws['!cols']=[{wch:12},{wch:26},{wch:14},{wch:7},{wch:8},{wch:15},{wch:15},{wch:15},{wch:10}];
  XLSX.utils.book_append_sheet(wb,ws,'Fee Balances');
  const meta=[{'System':'LUMA@ Pro School Manager','Type':'Fee Balances','Exported':new Date().toLocaleString(),'Version':'4.0'}];
  const wsMeta=XLSX.utils.json_to_sheet(meta);
  XLSX.utils.book_append_sheet(wb,wsMeta,'Info');
  XLSX.writeFile(wb,`Fee_Balances_${new Date().toISOString().slice(0,10)}.xlsx`);
}

/* ════════ PAGINATION ════════ */
function renderPagination(containerId,current,total,itemCount,pageVar,renderFn){
  const el=document.getElementById(containerId);if(!el)return;
  if(total<=1){el.innerHTML='';return;}
  let html=`<span class="page-info">Showing ${Math.min((current-1)*PER_PAGE+1,itemCount)}–${Math.min(current*PER_PAGE,itemCount)} of ${itemCount}</span>`;
  html+=`<button onclick="${pageVar}=Math.max(1,${pageVar}-1);${renderFn}()" ${current===1?'disabled':''}>‹ Prev</button>`;
  let start=Math.max(1,current-3),end=Math.min(total,start+6);
  start=Math.max(1,end-6);
  for(let p=start;p<=end;p++){
    html+=`<button class="${p===current?'active':''}" onclick="${pageVar}=${p};${renderFn}()">${p}</button>`;
  }
  html+=`<button onclick="${pageVar}=Math.min(${total},${pageVar}+1);${renderFn}()" ${current===total?'disabled':''}>Next ›</button>`;
  el.innerHTML=html;
}

/* ════════ CLASS SHEET ════════ */
async function renderClassSheet(){
  let students=await idbGetByIndex('students','className',currentClass);
  students.sort((a,b)=>a.name.localeCompare(b.name));
  // For S.3/S.4, only show students registered for this subject
  if(isS3orS4(currentClass)){
    students=students.filter(s=>{
      const subs=effectiveSubjects(s);
      return subs?subs.includes(currentSubject):true;
    });
  }
  // S.1/S.2: CRE and IRE are alternatives — only list learners who take this one
  const reFiltered=(currentSubject===RE_CRE||currentSubject===RE_IRE)&&isS1orS2(currentClass);
  students=filterByReligion(students,currentClass,currentSubject);
  const allMarks=await idbGetAll('marks');
  const body=document.querySelector('#classTable tbody');
  body.innerHTML='';
  if(!students.length){
    const msg=reFiltered
      ?`No learners in ${currentClass} take ${currentSubject.includes('(IRE)')?'IRE':'CRE'}. Admin sets each learner's CRE/IRE choice under Learners.`
      :isS3orS4(currentClass)
      ?`No learners in ${currentClass} registered for ${currentSubject}.`
      :`No learners in ${currentClass} yet. Ask admin to register them.`;
    body.innerHTML=`<tr class="empty-row"><td colspan="7">${msg}</td></tr>`;return;
  }
  let _h='';
  students.forEach(student=>{
    const mk=`${student.id}:${currentSubject}:${currentTerm}:${currentYear}`;
    // Fallback: also look for legacy key without year
    const ex=allMarks.find(m=>m._key===mk)||allMarks.find(m=>m._key===`${student.id}:${currentSubject}:${currentTerm}`&&!m.year);
    const a1=ex?ex.a1:'',exam=ex?ex.exam:'';
    const actScaled=ex?Number(markActScaled(ex).toFixed(1)):'—';
    const total=ex?ex.total:'—';
    const grade=ex?getGrade(ex.total):'—';
    const gc=ex?gradeColor(grade):'var(--muted)';
    const comment=ex?getComment(grade):'—';
    _h+=`<tr>
      <td><strong>${escapeHtml(student.name)}</strong><input type="hidden" class="studentId" value="${student.id}"></td>
      <td><input class="a1"   type="number" min="0" max="3"  value="${a1}"   placeholder="0" step="0.5"></td>
      <td class="live-act"     style="font-weight:600;color:var(--navy);font-size:12px">${actScaled}</td>
      <td><input class="exam" type="number" min="0" max="80" value="${exam}" placeholder="0"></td>
      <td class="live-total"   style="font-weight:700;color:var(--navy)">${total}</td>
      <td class="live-grade"   style="font-weight:800;color:${gc}">${grade}</td>
      <td class="live-comment" style="font-size:12px;color:${gc};font-style:italic">${comment}</td>
    </tr>`;
  });
  body.innerHTML=_h;   // one DOM write instead of one per learner (much faster on big classes)
  document.querySelectorAll('#classTable tbody tr').forEach(row=>{
    ['a1','exam'].forEach(c=>{
      const inp=row.querySelector('.'+c);if(!inp)return;
      inp.addEventListener('input',()=>{marksUnsaved=true;liveRow(row);});
      inp.addEventListener('change',()=>{
        const mx=Number(inp.max);
        if(Number(inp.value)>mx)inp.value=mx;
        if(Number(inp.value)<0)inp.value=0;
        marksUnsaved=true;liveRow(row);
      });
    });
  });
}

function liveRow(row){
  const a1=Number(row.querySelector('.a1').value||0);
  const exam=Number(row.querySelector('.exam').value||0);
  if(!a1&&!exam){
    row.querySelector('.live-act').textContent='—';row.querySelector('.live-total').textContent='—';
    const g=row.querySelector('.live-grade');g.textContent='—';g.style.color='var(--muted)';
    const c=row.querySelector('.live-comment');c.textContent='—';c.style.color='var(--muted)';
    return;
  }
  const actScaled=((a1/3)*20).toFixed(1);
  const total=calcTotal(a1,exam);
  const grade=getGrade(total);
  const color=gradeColor(grade);
  row.querySelector('.live-act').textContent=actScaled;
  row.querySelector('.live-total').textContent=total;
  row.querySelector('.live-grade').textContent=grade;
  row.querySelector('.live-grade').style.color=color;
  row.querySelector('.live-comment').textContent=getComment(grade);
  row.querySelector('.live-comment').style.color=color;
}

let _savingMarks=false;
function _setSaveBtn(busy){
  const b=document.querySelector('button[onclick="saveMarks()"]');
  if(!b)return;
  if(busy){b.dataset.label=b.textContent;b.disabled=true;b.textContent='⏳ Saving…';}
  else{b.disabled=false;if(b.dataset.label)b.textContent=b.dataset.label;}
}
function _saveFailed(err){
  console.error('Save marks failed',err);
  const msg='Marks were NOT saved: '+(err&&err.message?err.message:err)+'\n\nYour entries are still on the screen — do not close or refresh this page. Tap Save again; if it keeps failing, free up storage on this phone or close other tabs of this app.';
  showAlert('marksAlert','Marks were NOT saved: '+(err&&err.message?err.message:err)+'. Your entries are still on screen — tap Save again.','error');
  alert('⚠️ '+msg);
}

async function savePrimaryMarks(){
  if(!currentTeacherObj){showAlert('marksAlert','Teacher login required.','error');return;}
  if(_savingMarks)return;
  _savingMarks=true;_setSaveBtn(true);
  try{
    const rows=document.querySelectorAll('#classTable tbody tr');
    const byId={};(await idbGetAll('students')).forEach(st=>{byId[String(st.id)]=st;});
    const entries=[];
    for(const row of rows){
      const idEl=row.querySelector('.studentId');if(!idEl)continue;
      const studentId=idEl.value;
      const student=byId[String(studentId)];
      const endTerm=Math.min(100,Math.max(0,Number(row.querySelector('.pEnd').value||0)));
      const mid1=Math.min(100,Math.max(0,Number(row.querySelector('.pMid1').value||0)));
      const mid2=Math.min(100,Math.max(0,Number(row.querySelector('.pMid2').value||0)));
      entries.push({
        _key:`${studentId}:${currentSubject}:${currentTerm}:${currentYear}`,
        studentId,subject:currentSubject,
        className:student?student.className:currentClass,
        teacher:currentTeacherObj.name,term:currentTerm,year:currentYear,
        endTerm,mid1,mid2,
        savedAt:new Date().toISOString()
      });
    }
    await idbPutMany('primaryMarks',entries);   // one all-or-nothing transaction
    marksUnsaved=false;
    document.getElementById('lastSavedLabel').textContent=`Last saved: ${new Date().toLocaleString()}`;
    showAlert('marksAlert',`✅ Saved marks for ${entries.length} learner(s).`);
  }catch(err){_saveFailed(err);}
  finally{_savingMarks=false;_setSaveBtn(false);}
}

async function renderPrimaryClassSheet(){
  let students=await idbGetByIndex('students','className',currentClass);
  students.sort((a,b)=>a.name.localeCompare(b.name));
  const allMarks=await idbGetAll('primaryMarks');
  const body=document.querySelector('#classTable tbody');
  body.innerHTML='';
  if(!students.length){
    body.innerHTML=`<tr class="empty-row"><td colspan="6">No learners in ${currentClass} yet. Ask admin to register them.</td></tr>`;return;
  }
  let _h='';
  students.forEach(student=>{
    const mk=`${student.id}:${currentSubject}:${currentTerm}:${currentYear}`;
    const ex=allMarks.find(m=>m._key===mk);
    const endTerm=ex?ex.endTerm:'',mid1=ex?ex.mid1:'',mid2=ex?ex.mid2:'';
    const grade=ex&&ex.endTerm!==''?getPrimaryGrade(ex.endTerm):'—';
    const gc=ex&&ex.endTerm!==''?primaryGradeColor(grade):'var(--muted)';
    const remark=ex&&ex.endTerm!==''?getPrimaryComment(grade):'—';
    _h+=`<tr>
      <td><strong>${escapeHtml(student.name)}</strong><input type="hidden" class="studentId" value="${student.id}"></td>
      <td><input class="pEnd" type="number" min="0" max="100" value="${endTerm}" placeholder="0"></td>
      <td><input class="pMid1" type="number" min="0" max="100" value="${mid1}" placeholder="0"></td>
      <td><input class="pMid2" type="number" min="0" max="100" value="${mid2}" placeholder="0"></td>
      <td class="live-grade" style="font-weight:800;color:${gc}">${grade}</td>
      <td class="live-comment" style="font-size:12px;color:${gc};font-style:italic">${remark}</td>
    </tr>`;
  });
  body.innerHTML=_h;   // one DOM write instead of one per learner (much faster on big classes)
  document.querySelectorAll('#classTable tbody tr').forEach(row=>{
    ['pEnd','pMid1','pMid2'].forEach(c=>{
      const inp=row.querySelector('.'+c);if(!inp)return;
      inp.addEventListener('input',()=>{marksUnsaved=true;livePrimaryRow(row);});
      inp.addEventListener('change',()=>{
        if(Number(inp.value)>100)inp.value=100;
        if(Number(inp.value)<0)inp.value=0;
        marksUnsaved=true;livePrimaryRow(row);
      });
    });
  });
}

function livePrimaryRow(row){
  const endEl=row.querySelector('.pEnd');
  if(!endEl.value){row.querySelector('.live-grade').textContent='—';row.querySelector('.live-comment').textContent='—';return;}
  const grade=getPrimaryGrade(endEl.value);
  const color=primaryGradeColor(grade);
  row.querySelector('.live-grade').textContent=grade;
  row.querySelector('.live-grade').style.color=color;
  row.querySelector('.live-comment').textContent=getPrimaryComment(grade);
  row.querySelector('.live-comment').style.color=color;
}


async function saveMarks(){
  if(isPrimaryTier(currentClassLevel)){await savePrimaryMarks();return;}
  if(!currentTeacherObj){showAlert('marksAlert','Teacher login required.','error');return;}
  if(_savingMarks)return;
  const rows=document.querySelectorAll('#classTable tbody tr');
  let emptyCount=0;
  rows.forEach(row=>{
    const a1=row.querySelector('.a1');
    const exam=row.querySelector('.exam');
    if(a1&&!a1.value&&exam&&!exam.value)emptyCount++;
  });
  if(emptyCount>0&&rows.length>1){
    if(!confirm(`⚠️ ${emptyCount} learner(s) have no marks entered. They will be saved as zeros. Continue?`))return;
  }
  _savingMarks=true;_setSaveBtn(true);
  let ok=false;
  try{
    const byId={};(await idbGetAll('students')).forEach(st=>{byId[String(st.id)]=st;});
    const entries=[];
    for(const row of rows){
      const idEl=row.querySelector('.studentId');if(!idEl)continue;
      const studentId=idEl.value;
      const student=byId[String(studentId)];
      const a1=Math.min(3,Math.max(0,Number(row.querySelector('.a1').value||0)));
      const exam=Math.min(80,Math.max(0,Number(row.querySelector('.exam').value||0)));
      const actScaled=Number((a1/3*20).toFixed(1));
      const total=calcTotal(a1,exam);
      entries.push({
        _key:`${studentId}:${currentSubject}:${currentTerm}:${currentYear}`,
        studentId,subject:currentSubject,
        className:student?student.className:currentClass,
        teacher:currentTeacherObj.name,term:currentTerm,year:currentYear,
        a1,exam,actScaled,total,
        savedAt:new Date().toISOString()
      });
    }
    await idbPutMany('marks',entries);   // one all-or-nothing transaction, confirmed committed
    document.getElementById('lastSavedLabel').textContent=`Last saved: ${new Date().toLocaleTimeString()} — ${entries.length} record(s)`;
    marksUnsaved=false;
    showAlert('marksAlert',`✅ ${entries.length} record(s) saved for Term ${currentTerm} (${currentYear}).`);
    ok=true;
  }catch(err){_saveFailed(err);}
  finally{_savingMarks=false;_setSaveBtn(false);}
  if(ok){try{await renderClassSheet();}catch(e){console.error(e);}}
}

/* ════════ OCR SCAN PAPER MARK SHEET ════════ */
let ocrParsedRows=[];

function openOcrScan(){
  if(typeof Tesseract==='undefined'){
    alert('⚠️ The photo-reading engine did not load.\n\nConnect to the internet once, reload this page, and try again. (For fully offline use, ask your admin to put tesseract.min.js, tesseract-worker.min.js, tesseract-core.wasm.js and eng.traineddata.gz in the "libs" folder.)');
    return;
  }
  document.getElementById('ocrProgressWrap').style.display='none';
  document.getElementById('ocrReviewWrap').style.display='none';
  document.getElementById('ocrStatus').textContent='Tips: lay the sheet flat, use good daylight, hold the phone straight above it, and fill the frame with the table. Dark pen on white paper works best. Always check the review table below.';
  document.getElementById('ocrScanModal').classList.add('open');
  const input=document.getElementById('ocrScanFile');
  input.value='';
  input.click();
}

/* Cleans a phone photo before reading: corrects rotation, shrinks huge images (faster, and
   Tesseract reads ~1800-2400px best), converts to grey and stretches contrast so faint pencil/pen is readable. */
async function ocrPreprocess(file){
  let src,w,h;
  try{ src=await createImageBitmap(file,{imageOrientation:'from-image'}); w=src.width;h=src.height; }
  catch(e){
    src=await new Promise((res,rej)=>{const im=new Image();im.onload=()=>res(im);im.onerror=()=>rej(new Error('Could not open that image file'));im.src=URL.createObjectURL(file);});
    w=src.naturalWidth;h=src.naturalHeight;
  }
  const longSide=Math.max(w,h);
  const scale=longSide>2400?2400/longSide:(longSide<1400?Math.min(2,1400/longSide):1);
  const cw=Math.round(w*scale),ch=Math.round(h*scale);
  const cv=document.createElement('canvas');cv.width=cw;cv.height=ch;
  const ctx=cv.getContext('2d',{willReadFrequently:true});
  ctx.fillStyle='#fff';ctx.fillRect(0,0,cw,ch);
  ctx.drawImage(src,0,0,cw,ch);
  const img=ctx.getImageData(0,0,cw,ch),d=img.data,hist=new Uint32Array(256);
  for(let i=0;i<d.length;i+=4){const g=(d[i]*0.299+d[i+1]*0.587+d[i+2]*0.114)|0;d[i]=d[i+1]=d[i+2]=g;hist[g]++;}
  const total=cw*ch;let acc=0,lo=0,hi=255;
  for(let v=0;v<256;v++){acc+=hist[v];if(acc>=total*0.02){lo=v;break;}}
  acc=0;for(let v=255;v>=0;v--){acc+=hist[v];if(acc>=total*0.30){hi=v;break;}}   // paper background sits in the top 30%
  const span=Math.max(40,hi-lo);
  for(let i=0;i<d.length;i+=4){let v=((d[i]-lo)/span)*255;v=v<0?0:v>255?255:v;d[i]=d[i+1]=d[i+2]=v;}
  ctx.putImageData(img,0,0);
  return cv;
}

async function _ocrRun(image,useLocal){
  const opts={
    logger:m=>{
      if(m.status&&typeof m.progress==='number'){
        const pct=Math.round(m.progress*100);
        document.getElementById('ocrProgressBar').style.width=pct+'%';
        document.getElementById('ocrProgressText').textContent=m.status+'… '+pct+'%';
      }
    }
  };
  // Local copies first (works offline); if absent, Tesseract's own online defaults are used
  if(useLocal){opts.workerPath='libs/tesseract-worker.min.js';opts.corePath='libs/tesseract-core.wasm.js';opts.langPath='libs/';opts.gzip=true;}
  const worker=await Tesseract.createWorker(opts);
  try{
    if(worker.load)await worker.load();
    if(worker.loadLanguage)await worker.loadLanguage('eng');
    await worker.initialize('eng');
    try{await worker.setParameters({tessedit_pageseg_mode:'6',preserve_interword_spaces:'1'});}catch(e){}
    const res=await worker.recognize(image);
    return res.data.text||'';
  }finally{try{await worker.terminate();}catch(e){}}
}

async function handleOcrFile(input){
  const file=input.files&&input.files[0];
  if(!file)return;
  document.getElementById('ocrProgressWrap').style.display='block';
  document.getElementById('ocrReviewWrap').style.display='none';
  document.getElementById('ocrProgressBar').style.width='0%';
  document.getElementById('ocrProgressText').textContent='Preparing photo…';
  let text='',lastErr=null;
  try{
    const canvas=await ocrPreprocess(file);
    for(const useLocal of [true,false]){
      try{ text=await _ocrRun(canvas,useLocal); lastErr=null; break; }
      catch(e){ lastErr=e; console.warn('OCR attempt failed (local='+useLocal+')',e); }
    }
  }catch(e){ lastErr=e; }
  if(lastErr){
    document.getElementById('ocrProgressWrap').style.display='none';
    const m=String((lastErr&&lastErr.message)||lastErr);
    const engine=/worker|importScripts|NetworkError|Failed to fetch|wasm|traineddata|load|network/i.test(m);
    alert(engine
      ?'⚠️ The photo-reading engine could not start.\n\nThis is NOT a problem with your photo. The reader needs its files: connect to the internet once and try again (they are then reused), or ask your admin to add the OCR files to the "libs" folder.\n\nDetails: '+m
      :'⚠️ Could not read that image.\n\nDetails: '+m+'\n\nTry again with the sheet flat, in good light, photographed straight from above.');
    return;
  }
  if(!text.trim()){
    document.getElementById('ocrProgressWrap').style.display='none';
    alert('⚠️ No writing was found in that photo.\n\nTry again: lay the sheet flat, use daylight, hold the phone straight above it so the whole table fills the picture.');
    return;
  }
  buildOcrReview(text);
}

/* ---- parsing (pure functions, easy to test) ---- */
function _lev(a,b){
  if(a===b)return 0;if(!a.length)return b.length;if(!b.length)return a.length;
  let prev=Array.from({length:b.length+1},(_,i)=>i);
  for(let i=1;i<=a.length;i++){
    const cur=[i];
    for(let j=1;j<=b.length;j++)cur[j]=Math.min(prev[j]+1,cur[j-1]+1,prev[j-1]+(a[i-1]===b[j-1]?0:1));
    prev=cur;
  }
  return prev[b.length];
}
function _ocrTokens(line){return line.split(/[\s|;:]+/).filter(Boolean);}
// Turns an OCR token into a number when it looks like one (fixes common misreads: O→0, l/I/|→1, S→5, 2,5→2.5)
function _ocrNumber(tok){
  let t=tok.replace(/[^0-9A-Za-z.,|]/g,'').replace(/[.,]+$/,'');
  if(!t||t.length>5)return null;
  if(!/[0-9]/.test(t)&&!/^[OolI|S]$/.test(t))return null;
  t=t.replace(/[Oo]/g,'0').replace(/[lI|]/g,'1').replace(/S/g,'5').replace(',','.');
  if(!/^\d+(\.\d+)?$/.test(t))return null;
  return Number(t);
}
function ocrMatchRows(lines,names,nCols){
  const toks=lines.map(l=>_ocrTokens(l.toLowerCase()));
  const cands=[];
  names.forEach((name,ni)=>{
    const words=name.toLowerCase().split(/\s+/).filter(w=>w.length>1);
    if(!words.length)return;
    toks.forEach((tk,li)=>{
      let hits=0,lastPos=-1;
      words.forEach(w=>{
        const maxErr=w.length>=7?2:w.length>=4?1:0;
        const pos=tk.findIndex(t=>t.length>1&&(t===w||_lev(t.replace(/[^a-z]/g,''),w)<=maxErr));
        if(pos>=0){hits++;if(pos>lastPos)lastPos=pos;}
      });
      if(hits>0)cands.push({ni,li,hits,frac:hits/words.length,lastPos,words:words.length});
    });
  });
  // Best matches claim their line first, so two learners never fight over the same line
  cands.sort((a,b)=>b.frac-a.frac||b.hits-a.hits);
  const usedN=new Set(),usedL=new Set(),out=names.map(()=>({values:Array(nCols).fill(''),confident:false,matched:false}));
  cands.forEach(c=>{
    if(usedN.has(c.ni)||usedL.has(c.li))return;
    usedN.add(c.ni);usedL.add(c.li);
    const after=lines[c.li].split(/\s+/).filter(Boolean);
    // numbers that come AFTER the name (ignores serial numbers like "12." at the start of the line)
    const rest=_ocrTokens(lines[c.li]).slice(c.lastPos+1);
    const nums=rest.map(_ocrNumber).filter(n=>n!==null);
    out[c.ni]={values:Array.from({length:nCols},(_,i)=>nums[i]!==undefined?nums[i]:''),confident:c.frac>=0.67&&nums.length>=nCols,matched:true};
  });
  return out;
}

function buildOcrReview(rawText){
  document.getElementById('ocrProgressWrap').style.display='none';
  const lines=rawText.split('\n').map(l=>l.trim()).filter(l=>l.length>0);
  const tableRows=Array.from(document.querySelectorAll('#classTable tbody tr'));
  const primary=isPrimaryTier(currentClassLevel);
  const cols=primary?['pEnd','pMid1','pMid2']:['a1','exam'];
  const labels=primary?['End Term','Mid-Term 1','Mid-Term 2']:['A1','Exam'];
  const maxes=cols.map(c=>{const el=tableRows[0]&&tableRows[0].querySelector('.'+c);return el&&el.max!==''?Number(el.max):Infinity;});
  const names=tableRows.map(r=>{const el=r.querySelector('td strong');return el?el.textContent.trim():'';});
  const m=ocrMatchRows(lines,names,cols.length);
  ocrParsedRows=names.map((name,i)=>({name,cols,maxes,values:m[i].values,confident:m[i].confident,matched:m[i].matched}));
  const matched=ocrParsedRows.filter(r=>r.matched).length;

  document.getElementById('ocrReviewHead').innerHTML=`<tr><th>Learner</th>${labels.map((l,i)=>`<th>${l}${maxes[i]!==Infinity?' <span style="opacity:.6;font-weight:400">/'+maxes[i]+'</span>':''}</th>`).join('')}</tr>`;
  document.getElementById('ocrReviewBody').innerHTML=ocrParsedRows.map((r,ri)=>`
    <tr style="${r.confident?'':'background:#fff7e0'}">
      <td><strong>${escapeHtml(r.name)}</strong>${r.matched?'':'<div style="font-size:11px;color:#b45309">not found in photo</div>'}</td>
      ${r.values.map((v,ci)=>`<td><input type="number" step="0.5" min="0" ${maxes[ci]!==Infinity?'max="'+maxes[ci]+'"':''} style="width:64px;${v!==''&&Number(v)>maxes[ci]?'border-color:#dc2626;background:#fef2f2':''}" value="${v}" onchange="ocrParsedRows[${ri}].values[${ci}]=this.value;this.style.borderColor=(this.value!==''&&Number(this.value)>ocrParsedRows[${ri}].maxes[${ci}])?'#dc2626':''"></td>`).join('')}
    </tr>`).join('');

  document.getElementById('ocrStatus').textContent=matched
    ?`Found ${matched} of ${ocrParsedRows.length} learners. Yellow rows are uncertain and red values are too high — fix them below, then apply.`
    :'No learner names were recognised in this photo. You can type the values below, or retake the photo (flat, good light, straight from above).';
  document.getElementById('ocrReviewWrap').style.display='block';
}

function applyOcrToSheet(){
  const tableRows=Array.from(document.querySelectorAll('#classTable tbody tr'));
  let filled=0,skipped=0;
  ocrParsedRows.forEach((r,ri)=>{
    const row=tableRows[ri];
    if(!row)return;
    r.cols.forEach((c,ci)=>{
      const val=r.values[ci];
      if(val===''||val===undefined)return;
      if(Number(val)>r.maxes[ci]||Number(val)<0){skipped++;return;}   // never write an impossible mark
      const inp=row.querySelector('.'+c);
      if(inp){inp.value=val;inp.dispatchEvent(new Event('input',{bubbles:true}));filled++;}
    });
  });
  marksUnsaved=true;
  closeModal('ocrScanModal');
  showAlert('marksAlert',`✅ ${filled} value(s) filled in${skipped?' ('+skipped+' impossible value(s) skipped)':''} — double-check each row, then click Save Marks.`,'success');
}

/* ════════ REPORT STUDENT LIST ════════ */
async function loadReportStudents(){
  const sel=document.getElementById('reportStudent');if(!sel)return;
  const students=await idbGetAll('students');
  students.sort((a,b)=>a.name.localeCompare(b.name));
  sel.innerHTML=students.length
    ?students.map(s=>`<option value="${s.id}">${s.name} (${s.className})</option>`).join('')
    :'<option>— No learners registered yet —</option>';
}

/* ════════ CONDUCT / REMARKS ════════ */
let conductStudentIdCache='', conductTermCache=1;

async function openConductModal(){
  const id=document.getElementById('reportStudent').value;
  const termNum=Number(document.getElementById('reportTerm').value);
  if(!id){alert('Please generate a report first.');return;}
  conductStudentIdCache=id;conductTermCache=termNum;
  document.getElementById('conductStudentId').value=id;
  document.getElementById('conductTerm').value=termNum;
  const key=`${id}:${termNum}:${document.getElementById('reportYear').value||new Date().getFullYear()}`;
  const c=await idbGet('conduct',key)||await idbGet('conduct',`${id}:${termNum}`)||{};
  document.getElementById('conductPunctuality').value=c.punctuality||'';
  document.getElementById('conductDiscipline').value=c.discipline||'';
  document.getElementById('conductParticipation').value=c.participation||'';
  document.getElementById('conductDaysPresent').value=c.daysPresent||'';
  document.getElementById('conductDaysTotal').value=c.daysTotal||'';
  document.getElementById('conductTeacherRemark').value=c.teacherRemark||'';
  document.getElementById('conductHtRemark').value=c.htRemark||'';
  openModal('conductModal');
}

async function saveConductRemarks(){
  const id=document.getElementById('conductStudentId').value;
  const term=Number(document.getElementById('conductTerm').value);
  const year=document.getElementById('reportYear').value||new Date().getFullYear();
  const record={
    _key:`${id}:${term}:${year}`,studentId:id,term,year,
    punctuality:document.getElementById('conductPunctuality').value,
    discipline:document.getElementById('conductDiscipline').value,
    participation:document.getElementById('conductParticipation').value,
    daysPresent:document.getElementById('conductDaysPresent').value,
    daysTotal:document.getElementById('conductDaysTotal').value,
    teacherRemark:document.getElementById('conductTeacherRemark').value.trim(),
    htRemark:document.getElementById('conductHtRemark').value.trim()
  };
  await idbPut('conduct',record);
  showAlert('conductAlert','Conduct & remarks saved!');
  setTimeout(()=>{closeModal('conductModal');generateReport();},1200);
}

/* ════════ GENERATE REPORT CARD ════════ */
let currentReportStudentId='', currentReportTerm=1;

async function generateReport(){
  const id=document.getElementById('reportStudent').value;
  const termNum=Number(document.getElementById('reportTerm').value);
  const year=document.getElementById('reportYear').value||new Date().getFullYear();
  currentReportStudentId=id;currentReportTerm=termNum;
  try{
    const studentForLevelCheck=await idbGet('students',id);
    if(!studentForLevelCheck){alert('Please select a learner.');return;}
    if(isPrimaryTier(await getClassLevel(studentForLevelCheck.className))){
      await generatePrimaryReport(id,termNum,year);
      return;
    }
  }catch(err){
    console.error('generateReport (primary check) failed:',err);
    alert('⚠️ Could not generate the report.\n\nError: '+err.message);
    return;
  }
  const [student,info,allStudents,allMarks,conduct]=await Promise.all([
    idbGet('students',id),idbGet('school','info'),
    idbGetAll('students'),idbGetAll('marks'),
    idbGet('conduct',`${id}:${termNum}:${year}`).catch(()=>null).then(r=>r||idbGet('conduct',`${id}:${termNum}`))
  ]);
  const school=info||{};
  if(!student){alert('Please select a learner.');return;}

  const sMarks=allMarks.filter(m=>m.studentId===id&&Number(m.term)===termNum&&inYear(m,year));
  let totalSum=0,rows='';
  sMarks.sort((a,b)=>a.subject.localeCompare(b.subject));
  sMarks.forEach(mark=>{
    totalSum+=Number(mark.total);
    const grade=getGrade(mark.total);
    const actS=markActScaled(mark).toFixed(1);
    rows+=`<tr>
      <td>${mark.subject}</td>
      <td>${mark.a1}</td>
      <td style="font-weight:700;color:#1a3270">${actS}</td>
      <td>${mark.exam}</td>
      <td style="font-weight:800">${mark.total}</td>
      <td style="font-weight:800;color:${gradeColor(getGrade(mark.total))}">${getGrade(mark.total)}</td>
      <td style="font-style:italic;color:${gradeColor(getGrade(mark.total))}">${getComment(getGrade(mark.total))}</td>
      <td style="font-size:7pt;color:#666">${mark.teacher}</td>
    </tr>`;
  });

  const finalAvg=sMarks.length?(totalSum/sMarks.length).toFixed(1):'0.0';
  const finalGrade=getGrade(finalAvg);
  const finalTotal=totalSum;
  const finalOutOf=sMarks.length*100;

  const classStudents=allStudents.filter(s=>s.className===student.className);
  const ranked=classStudents.map(s=>{
    const sm=allMarks.filter(m=>m.studentId===s.id&&Number(m.term)===termNum&&inYear(m,year));
    return{id:s.id,has:sm.length>0,avg:sm.length?(sm.reduce((a,m)=>a+Number(m.total),0)/sm.length):0};
  }).sort((a,b)=>b.avg-a.avg);
  const _rk=competitionRank(ranked,id);const rank=_rk.rank;
  const rankStr=rank?`${rank} / ${_rk.total}`:'—';

  // Remarks: custom if set, else auto
  const autoTeacher=Number(finalAvg)>=80
    ?'Excellent academic performance this term. Keep up the outstanding work!'
    :Number(finalAvg)>=70?'Good academic progress. Continue working hard to achieve even better results.'
    :Number(finalAvg)>=55?'Satisfactory performance. More effort and dedication is needed next term.'
    :'Needs significant improvement. Please seek extra help and study harder next term.';
  const autoHt=Number(finalAvg)>=70
    ?'Well done! Continue striving for excellence in all subjects.'
    :'More commitment to academics is required. Please work closely with your teachers.';
  const teacherRemark=conduct?.teacherRemark||autoTeacher;
  const htRemark=conduct?.htRemark||autoHt;

  const logoHtml=school.logo?`<img class="rc-logo" src="${school.logo}" alt="Badge">`:`<div class="rc-logo-placeholder">🏫</div>`;
  const photoHtml=student.photo?`<img class="rc-passport" src="${student.photo}" alt="Photo">`:`<div class="rc-passport-placeholder"><span>🧑</span><span style="font-size:7px;color:#aaa">No Photo</span></div>`;
  if(!rows)rows=`<tr><td colspan="10" style="text-align:center;padding:12px;color:#888;font-style:italic">No marks submitted for Term ${termNum} yet.</td></tr>`;

  const termOrdinal=['','1st','2nd','3rd'][termNum]||`${termNum}th`;
  const c=conduct||{};

  document.getElementById('reportOutput').innerHTML=buildReportHTML(
    school,student,sMarks,rows,finalAvg,finalGrade,rankStr,classStudents.length,
    termNum,termOrdinal,year,logoHtml,photoHtml,teacherRemark,htRemark,c,finalTotal,finalOutOf
  );
  document.getElementById('downloadBtn').style.display='inline-flex';
  document.getElementById('downloadJpgBtn').style.display='inline-flex';
  document.getElementById('conductBtn').style.display='inline-flex';
}

function buildReportHTML(school,student,sMarks,rows,finalAvg,finalGrade,rankStr,classSize,termNum,termOrdinal,year,logoHtml,photoHtml,teacherRemark,htRemark,c,finalTotal,finalOutOf){
  const flameHtml=Number(finalAvg)>=80?'<span class="rc-flame" title="Excellent performance">🔥</span>':'';
  const watermarkHtml=school.logo?`<img class="rc-watermark-img" src="${school.logo}" alt="Watermark">`:'<div class="rc-watermark">OFFICIAL</div>';
  return `<div class="a4-preview-wrap"><div class="a4-page" id="singleReportPage">
    ${watermarkHtml}
    <div class="rc-topbar"></div>

    <div class="rc-header">
      ${logoHtml}
      <div class="rc-school-block">
        <div class="rc-school-name">${school.name||'SCHOOL NAME'}</div>
        <div class="rc-school-motto">${school.motto||'Academic Excellence...'}</div>
        <div class="rc-school-contact">${school.contact||''}</div>
        <div><span class="rc-report-badge">${termOrdinal} Term Academic Report Card — ${year}</span></div>
      </div>
      ${photoHtml}
    </div>

    <div class="rc-student-strip">
      <div class="rc-sfield"><div class="rc-sfield-label">Full Name</div><div class="rc-sfield-value">${student.name}</div></div>
      <div class="rc-sfield"><div class="rc-sfield-label">Learner ID</div><div class="rc-sfield-value">${student.id}</div></div>
      <div class="rc-sfield"><div class="rc-sfield-label">Class</div><div class="rc-sfield-value">${student.className}</div></div>
      <div class="rc-sfield"><div class="rc-sfield-label">Subjects Done</div><div class="rc-sfield-value">${sMarks.length}</div></div>
      <div class="rc-sfield"><div class="rc-sfield-label">Class Position</div><div class="rc-sfield-value">${rankStr}</div></div>
      <div class="rc-sfield"><div class="rc-sfield-label">Academic Year</div><div class="rc-sfield-value">${year}</div></div>
    </div>

    <div class="rc-body">
      <div class="rc-section-title">Academic Performance — Term ${termNum}</div>
      <div class="rc-table-wrap">
        <table class="rc-table">
          <colgroup>
            <col class="rc-col-subject"><col class="rc-col-a">
            <col class="rc-col-act"><col class="rc-col-end"><col class="rc-col-total"><col class="rc-col-grade">
            <col class="rc-col-comment"><col class="rc-col-teacher">
          </colgroup>
          <thead>
            <tr>
              <th rowspan="2" style="text-align:left;padding-left:6px;min-width:80px">Subject</th>
              <th>Integration Activity (/3)</th>
              <th rowspan="2">Act<br>/20</th>
              <th rowspan="2">End<br>/80</th>
              <th rowspan="2">Total<br>/100</th>
              <th rowspan="2">Grade</th>
              <th rowspan="2">Comment</th>
              <th rowspan="2">Teacher</th>
            </tr>
            <tr><th>A1/3</th></tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>

      <div class="rc-section-title" style="margin-top:4px">Summary</div>
      <div class="rc-summary">
        <div class="rc-avg-box">
          <div class="rc-avg-lbl">Total Marks</div>
          <div class="rc-avg-num">${finalTotal}</div>
          <div class="rc-avg-sub">out of ${finalOutOf}</div>
        </div>
        <div class="rc-avg-box">
          <div class="rc-avg-lbl">Overall Avg ${flameHtml}</div>
          <div class="rc-avg-num">${finalAvg}</div>
          <div class="rc-avg-grade">${finalGrade}</div>
          <div class="rc-avg-sub">out of 100</div>
        </div>
        <div class="rc-comments">
          <p><strong>Class Teacher's Remarks:</strong> ${teacherRemark}</p>
          <p><strong>Headteacher's Remarks:</strong> ${htRemark}</p>
        </div>
      </div>

      <div class="rc-section-title" style="margin-top:4px">Conduct &amp; Behaviour</div>
      <div class="rc-conduct">
        <div class="rc-conduct-item"><div class="rc-conduct-label">Punctuality</div><div class="rc-conduct-val">${c.punctuality||''}</div></div>
        <div class="rc-conduct-item"><div class="rc-conduct-label">Discipline</div><div class="rc-conduct-val">${c.discipline||''}</div></div>
        <div class="rc-conduct-item"><div class="rc-conduct-label">Participation</div><div class="rc-conduct-val">${c.participation||''}</div></div>
        <div class="rc-conduct-item"><div class="rc-conduct-label">Days Present / Total</div><div class="rc-conduct-val">${c.daysPresent?c.daysPresent+' / '+(c.daysTotal||'?'):''}</div></div>
      </div>

      <div class="rc-section-title" style="margin-top:4px">Marking Scheme &amp; Grade Key</div>
      <div class="rc-gk-wrap">
        <div class="rc-gk-scheme">
          <div style="font-weight:800;margin-bottom:1px">Marking Scheme</div>
          <div>1 Integration Activity (A1) out of /3</div>
          <div>→ Activity scaled to <strong>/20</strong></div>
          <div>+ End of Term Exam = <strong>/80</strong></div>
          <div style="font-weight:800;margin-top:1px">Grand Total = /100</div>
        </div>
        <div class="rc-grade-key">
          <div class="rc-gk-item"><div class="rc-gk-dot" style="background:#16a34a"></div>A: 80–100 · Accomplished</div>
          <div class="rc-gk-item"><div class="rc-gk-dot" style="background:#1d4ed8"></div>B: 70–79 · Outstanding</div>
          <div class="rc-gk-item"><div class="rc-gk-dot" style="background:#d97706"></div>C: 55–69 · Modulate</div>
          <div class="rc-gk-item"><div class="rc-gk-dot" style="background:#ea580c"></div>D: 45–54 · Basic</div>
          <div class="rc-gk-item"><div class="rc-gk-dot" style="background:#dc2626"></div>E: 0–44 · Elementary</div>
        </div>
      </div>

      <div class="rc-nextterm" style="margin-top:4px">
        <div class="rc-nextterm-title">Next Term Information</div>
        <div class="rc-nextterm-field"><label>School Opens:</label><span>${school.nextTermOpens||''}</span></div>
        <div class="rc-nextterm-field"><label>Fees Due:</label><span>${school.nextTermFees||''}</span></div>
      </div>

      <div class="rc-sigs" style="margin-top:6px">
        <div class="rc-sig"><div class="rc-sig-line"></div><div class="rc-sig-lbl">Class Teacher</div></div>
        <div class="rc-sig"><div class="rc-sig-line"></div><div class="rc-sig-lbl">Headteacher</div></div>
        <div class="rc-sig"><div class="rc-sig-line"></div><div class="rc-sig-lbl">Parent / Guardian</div></div>
        <div class="rc-sig"><div class="rc-sig-line"></div><div class="rc-sig-lbl">Date</div></div>
      </div>
    </div>

    <div class="rc-stamp">${school.name?school.name.substring(0,12):'SCHOOL'}<br>STAMP</div>
    <div class="rc-bottombar"></div>
  </div></div>`;
}

/* ════════ PRIMARY (UGANDA PLE-STYLE) REPORT CARD ════════
   Shared builder used by the single-report view, "Print All", and the
   parent portal, so all three stay visually and numerically consistent. */
function buildPrimaryReportForStudent(student,termNum,year,school,classStudents,allPrimaryMarks,conduct){
  const c=conduct||{};
  const termWord=['','One','Two','Three'][termNum]||`${termNum}`;

  const sMarks=allPrimaryMarks.filter(m=>m.studentId===student.id&&Number(m.term)===termNum&&String(m.year)===String(year));
  sMarks.sort((a,b)=>a.subject.localeCompare(b.subject));

  let endRows='',endSum=0,endCount=0;
  const subjectGrades=[];
  sMarks.forEach(m=>{
    const grade=getPrimaryGrade(m.endTerm);
    subjectGrades.push({subject:m.subject,grade});
    endSum+=Number(m.endTerm);endCount++;
    endRows+=`<tr>
      <td class="prc-subject">${(m.subject||'').toUpperCase()}</td>
      <td>${m.endTerm}</td>
      <td>${grade}</td>
      <td class="prc-remark">${getPrimaryComment(grade)}</td>
      <td class="prc-teacher">${m.teacher||''}</td>
    </tr>`;
  });
  for(let i=0;i<2;i++)endRows+=`<tr><td class="prc-subject">EXTRA SUBJECT ${i+1}</td><td></td><td></td><td></td><td></td></tr>`;
  if(!sMarks.length)endRows=`<tr><td colspan="5" style="font-style:italic;color:#888">No marks submitted for Term ${termNum} yet.</td></tr>`+endRows;

  const avgMark=endCount?(endSum/endCount).toFixed(1):'0.0';
  const{aggregate,division}=subjectGrades.length?computePrimaryAggregate(subjectGrades):{aggregate:0,division:'—'};

  const ranked=classStudents.map(s=>{
    const sm=allPrimaryMarks.filter(m=>m.studentId===s.id&&Number(m.term)===termNum&&String(m.year)===String(year));
    return{id:s.id,has:sm.length>0,avg:sm.length?(sm.reduce((a,m)=>a+Number(m.endTerm),0)/sm.length):0};
  }).sort((a,b)=>b.avg-a.avg);
  const _rk=competitionRank(ranked,student.id);const rank=_rk.rank;
  const rankStr=rank||'—';

  function midTable(field){
    let rows='',sum=0,count=0;const grades=[];
    sMarks.forEach(m=>{
      const score=m[field];
      if(score===undefined||score===''){rows+=`<tr><td class="prc-subject">${(m.subject||'').toUpperCase()}</td><td>—</td><td>—</td></tr>`;return;}
      const grade=getPrimaryGrade(score);
      grades.push({subject:m.subject,grade});
      sum+=Number(score);count++;
      rows+=`<tr><td class="prc-subject">${(m.subject||'').toUpperCase()}</td><td>${score}</td><td>${grade}</td></tr>`;
    });
    for(let i=0;i<2;i++)rows+=`<tr><td class="prc-subject">EXTRA SUBJECT ${i+1}</td><td></td><td></td></tr>`;
    const avg=count?(sum/count).toFixed(1):'0.0';
    const{aggregate:agg,division:div}=grades.length?computePrimaryAggregate(grades):{aggregate:0,division:'—'};
    return{rows,avg,agg,div};
  }
  const set1=midTable('mid1');

  const autoTeacher=Number(avgMark)>=80?'Excellent work. Target at distinctions in all subjects.'
    :Number(avgMark)>=65?'Good performance. Keep up the effort.'
    :Number(avgMark)>=50?'Fair performance. More effort is needed next term.'
    :'Needs significant improvement. Please seek extra help.';
  const autoHt=Number(avgMark)>=65?'Well done, keep it up.':'More commitment to academics is required.';
  const teacherRemark=c.teacherRemark||autoTeacher;
  const htRemark=c.htRemark||autoHt;
  const classTeacherName=c.classTeacherName||'';
  const htName=school.headteacherName||'';

  const logoHtml=school.logo?`<img src="${school.logo}" alt="Badge">`:'🎓';
  const photoHtml=student.photo?`<img src="${student.photo}" alt="Photo">`:'🧑';
  const watermarkHtml=school.logo?`<img class="rc-watermark-img" src="${school.logo}" alt="Watermark">`:'<div class="rc-watermark">OFFICIAL</div>';

  return `<div class="a4-preview-wrap"><div class="a4-page pr2-page">
    ${watermarkHtml}
    <div class="pr2-stripe"></div>
    <div class="pr2-stars">★ ★ ★ ★ ★</div>
    <div class="pr2-schoolhead">
      <div class="pr2-photo-badge">${photoHtml}</div>
      <span class="pr2-cap">${logoHtml}</span>
      <div class="pr2-schoolname">${(school.name||'SCHOOL NAME').toUpperCase()}</div>
      <div class="pr2-underline"></div>
    </div>
    <div class="pr2-ribbon-wrap">
      <div class="pr2-ribbon">LEARNER'S END OF TERM ${termWord.toUpperCase()} REPORT, ${year}</div>
    </div>
    <div class="pr2-idbox">
      <div class="pr2-idrow">
        <div class="pr2-idfield"><label>Name:</label><span class="pr2-idval">${(student.name||'').toUpperCase()}</span></div>
        <div class="pr2-idfield"><label>Class &amp; Stream:</label><span class="pr2-idval">${student.className||''}</span></div>
      </div>
      <div class="pr2-idrow">
        <div class="pr2-idfield"><label>House:</label><span class="pr2-idval">${student.house||''}</span></div>
      </div>
    </div>

    <div class="pr2-section-ribbon"><span class="pr2-tag red">📖 End of Term Exam Results</span></div>
    <table class="pr2-table">
      <thead><tr><th>Subject</th><th>Marks</th><th>Grade</th><th>Remarks</th><th>Teacher</th></tr></thead>
      <tbody>${endRows}</tbody>
    </table>
    <div class="pr2-summarybar">
      <span>⭐ TOTAL MARKS: ${endSum} / ${endCount*100}</span>
      <span>📊 AVERAGE MARK: ${avgMark}${Number(avgMark)>=80?' <span class="rc-flame" title="Excellent performance">🔥</span>':''}</span>
      <span>🏆 POSITION: ${rankStr} OUT OF ${classStudents.length}</span>
      <span>🥉 AGGREGATES: ${aggregate}</span>
      <span>🛡️ DIVISION: ${division}</span>
    </div>

    <div class="pr2-section-ribbon" style="margin-top:14px"><span class="pr2-tag navy">📘 Mid Term Exam Results</span></div>
    <table class="pr2-table">
      <thead class="light"><tr><th>Subject</th><th>Total Mark</th><th>Grade</th></tr></thead>
      <tbody>${set1.rows}</tbody>
    </table>
    <div class="pr2-summarybar">
      <span>🎯 AVG: ${set1.avg}</span>
      <span>⭐ AGGs: ${set1.agg}</span>
      <span>🥉 DIV: ${set1.div}</span>
    </div>

    <div class="pr2-section-ribbon"><span class="pr2-tag green">📗 Grading Scheme</span></div>
    <div class="pr2-gradebox">
      <div class="pr2-gradebox-grid">
        <span>80+&nbsp;&nbsp;D1</span><span>60–64&nbsp;&nbsp;C4</span><span>40–49&nbsp;&nbsp;P7</span>
        <span>75–79&nbsp;D2</span><span>55–59&nbsp;&nbsp;C5</span><span>30–39&nbsp;&nbsp;P8</span>
        <span>65–74&nbsp;C3</span><span>50–54&nbsp;&nbsp;C6</span><span>0–29&nbsp;&nbsp;&nbsp;F9</span>
      </div>
    </div>

    <div class="pr2-comment">
      <div class="pr2-comment-chip">Class Teacher's Comment</div>
      <div class="pr2-comment-text">${teacherRemark}${classTeacherName?' — '+classTeacherName:''}</div>
      <div class="pr2-comment-icon">💬</div>
    </div>
    <div class="pr2-comment head">
      <div class="pr2-comment-chip">Head Teacher's Comment</div>
      <div class="pr2-comment-text">${htRemark}${htName?' — '+htName:''}</div>
      <div class="pr2-comment-icon">💬</div>
    </div>

    <div class="pr2-footerrow">
      <div>📅 <strong>Date of Issue:</strong> ${school.dateOfIssue||new Date().toLocaleDateString()}. <strong>Next Term Begins:</strong> ${school.nextTermOpens||'____________'}</div>
      <div class="pr2-stampcircle">SCHOOL<br>STAMP</div>
    </div>
    <div class="pr2-requirements">📋 School Requirements: ${school.requirements||'Broom, Ream, Uniform, Box file...'}</div>
    <div class="pr2-mottobar"><span>🏆 School Motto: '${school.motto||'Have to Give'}'</span><span>Page 1</span></div>
    <div class="pr2-stripe"></div>
  </div></div>`;
}

async function generatePrimaryReport(id,termNum,year){
  try{
    const[student,info,allStudents,allPrimaryMarks,conduct]=await Promise.all([
      idbGet('students',id),idbGet('school','info'),
      idbGetAll('students'),idbGetAll('primaryMarks'),
      idbGet('conduct',`${id}:${termNum}:${year}`).catch(()=>null).then(r=>r||idbGet('conduct',`${id}:${termNum}`).catch(()=>null))
    ]);
    const school=info||{};
    if(!student){alert('Please select a learner.');return;}
    const classStudents=allStudents.filter(s=>s.className===student.className);
    document.getElementById('reportOutput').innerHTML=buildPrimaryReportForStudent(student,termNum,year,school,classStudents,allPrimaryMarks,conduct);
    document.getElementById('downloadBtn').style.display='inline-flex';
    document.getElementById('downloadJpgBtn').style.display='inline-flex';
    document.getElementById('conductBtn').style.display='inline-flex';
  }catch(err){
    console.error('generatePrimaryReport failed:',err);
    alert('⚠️ Could not build the primary report card.\n\nError: '+err.message+'\n\nPlease screenshot this and report it.');
  }
}

/* ════════ PRINT ALL REPORT CARDS ════════ */
async function printAllReportCards(){
  const id=document.getElementById('reportStudent').value;
  const termNum=Number(document.getElementById('reportTerm').value);
  const year=document.getElementById('reportYear').value||new Date().getFullYear();
  const student=await idbGet('students',id);
  if(!student){alert('Please select a learner to determine the class.');return;}
  const className=student.className;
  if(!confirm(`Print ALL report cards for ${className} — Term ${termNum}?\n\nThis will generate one page per learner.`))return;

  const isPrimary=isPrimaryTier(await getClassLevel(className));
  const [allStudents,allMarks,allPrimaryMarks,info,allConducts]=await Promise.all([
    idbGetAll('students'),idbGetAll('marks'),idbGetAll('primaryMarks'),
    idbGet('school','info'),idbGetAll('conduct')
  ]);
  const school=info||{};
  const classStudents=allStudents.filter(s=>s.className===className).sort((a,b)=>a.name.localeCompare(b.name));
  if(!classStudents.length){alert('No learners found in this class.');return;}

  const termOrdinal=['','1st','2nd','3rd'][termNum]||`${termNum}th`;
  let allHTML='';

  if(isPrimary){
    for(const st of classStudents){
      const c=allConducts.find(cd=>cd.studentId===st.id&&Number(cd.term)===termNum)||{};
      allHTML+=buildPrimaryReportForStudent(st,termNum,year,school,classStudents,allPrimaryMarks,c);
    }
    openPrintAllWindow(allHTML);
    return;
  }

  for(const st of classStudents){
    const sMarks=allMarks.filter(m=>m.studentId===st.id&&Number(m.term)===termNum&&inYear(m,year));
    let totalSum=0,rows='';
    sMarks.sort((a,b)=>a.subject.localeCompare(b.subject));
    sMarks.forEach(mark=>{
      totalSum+=Number(mark.total);
      const grade=getGrade(mark.total);
      const actS=markActScaled(mark).toFixed(1);
      rows+=`<tr>
        <td>${mark.subject}</td><td>${mark.a1}</td>
        <td style="font-weight:700;color:#1a3270">${actS}</td>
        <td>${mark.exam}</td>
        <td style="font-weight:800">${mark.total}</td>
        <td style="font-weight:800;color:${gradeColor(grade)}">${grade}</td>
        <td style="font-style:italic;color:${gradeColor(grade)}">${getComment(grade)}</td>
        <td style="font-size:7pt;color:#666">${mark.teacher}</td>
      </tr>`;
    });
    if(!rows)rows=`<tr><td colspan="10" style="text-align:center;padding:10px;color:#888;font-style:italic">No marks for Term ${termNum}.</td></tr>`;

    const finalAvg=sMarks.length?(totalSum/sMarks.length).toFixed(1):'0.0';
    const finalGrade=getGrade(finalAvg);
    const ranked=classStudents.map(s=>{
      const sm=allMarks.filter(m=>m.studentId===s.id&&Number(m.term)===termNum&&inYear(m,year));
      return{id:s.id,has:sm.length>0,avg:sm.length?(sm.reduce((a,m)=>a+Number(m.total),0)/sm.length):0};
    }).sort((a,b)=>b.avg-a.avg);
    const _rk=competitionRank(ranked,st.id);const rank=_rk.rank;
    const rankStr=rank?`${rank} / ${_rk.total}`:'—';
    const c=allConducts.find(cd=>cd.studentId===st.id&&Number(cd.term)===termNum)||{};

    const autoTeacher=Number(finalAvg)>=80?'Excellent academic performance this term. Keep up the outstanding work!'
      :Number(finalAvg)>=70?'Good academic progress. Continue working hard to achieve even better results.'
      :Number(finalAvg)>=55?'Satisfactory performance. More effort and dedication is needed next term.'
      :'Needs significant improvement. Please seek extra help and study harder next term.';
    const autoHt=Number(finalAvg)>=70?'Well done! Continue striving for excellence in all subjects.'
      :'More commitment to academics is required. Please work closely with your teachers.';
    const teacherRemark=c.teacherRemark||autoTeacher;
    const htRemark=c.htRemark||autoHt;
    const logoHtml=school.logo?`<img class="rc-logo" src="${school.logo}" alt="Badge">`:`<div class="rc-logo-placeholder">🏫</div>`;
    const photoHtml=st.photo?`<img class="rc-passport" src="${st.photo}" alt="Photo">`:`<div class="rc-passport-placeholder"><span>🧑</span><span style="font-size:7px;color:#aaa">No Photo</span></div>`;
    allHTML+=buildReportHTML(school,st,sMarks,rows,finalAvg,finalGrade,rankStr,classStudents.length,termNum,termOrdinal,year,logoHtml,photoHtml,teacherRemark,htRemark,c,totalSum,sMarks.length*100);
  }
  openPrintAllWindow(allHTML);
}

function openPrintAllWindow(allHTML){
  const win=window.open('','_blank');
  win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8">
    <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:white;}
    :root{--navy:#0f1f4b;--navy-mid:#1a3270;--gold:#c9952a;--gold-light:#f0c96a;--border:#dde3f0;--muted:#6b7497;}
    .a4-preview-wrap{display:block;}
    .a4-page{width:210mm;min-height:297mm;background:#fff;padding:9mm 13mm 7mm;position:relative;overflow:hidden;font-size:10pt;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111;display:flex;flex-direction:column;page-break-after:always;}
    .rc-watermark{position:absolute;top:36%;left:14%;font-family:Georgia,'Times New Roman',serif;font-size:68pt;font-weight:800;color:rgba(15,31,75,0.03);transform:rotate(-22deg);pointer-events:none;user-select:none;letter-spacing:6px;white-space:nowrap;}
    .rc-watermark-img{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:58%;max-height:65%;object-fit:contain;opacity:0.07;pointer-events:none;user-select:none;z-index:0;filter:grayscale(1);}
    .rc-topbar{height:7px;background:linear-gradient(90deg,#0f1f4b 0%,#c9952a 50%,#0f1f4b 100%);border-radius:4px;margin-bottom:7px;}
    .rc-header{display:flex;align-items:center;gap:13px;margin-bottom:6px;}
    .rc-logo{width:72px;height:72px;border-radius:50%;border:3px solid #0f1f4b;object-fit:cover;flex-shrink:0;background:#f0f4ff;}
    .rc-logo-placeholder{width:72px;height:72px;border-radius:50%;border:3px dashed #aab;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;background:#f0f4ff;}
    .rc-school-block{flex:1;text-align:center;}
    .rc-school-name{font-family:Georgia,'Times New Roman',serif;font-size:15pt;font-weight:800;color:#8b0000;letter-spacing:0.5px;line-height:1.1;}
    .rc-school-motto{font-size:8.5pt;color:#555;font-style:italic;margin:2px 0;}
    .rc-school-contact{font-size:7.5pt;color:#666;}
    .rc-report-badge{display:inline-block;background:#0f1f4b;color:#fff;padding:3px 16px;border-radius:20px;font-size:7.5pt;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-top:4px;white-space:normal;max-width:100%;box-sizing:border-box;}
    .rc-passport{width:68px;height:82px;border:2.5px solid #0f1f4b;border-radius:6px;object-fit:cover;flex-shrink:0;}
    .rc-passport-placeholder{width:68px;height:82px;border:2px dashed #aab;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#f0f4ff;flex-direction:column;gap:3px;font-size:19px;color:#999;}
    .rc-divider{border:none;border-top:2px solid #0f1f4b;margin:4px 0;}
    .rc-student-strip{display:flex;border:1.5px solid #0f1f4b;border-radius:7px;overflow:hidden;margin-bottom:6px;}
    .rc-sfield{flex:1;padding:5px 7px;border-right:1px solid #dde3f0;font-size:8pt;}
    .rc-sfield:last-child{border-right:none;}
    .rc-sfield-label{font-size:6pt;color:#6b7497;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;}
    .rc-sfield-value{font-weight:700;color:#0f1f4b;margin-top:1px;}
    .rc-section-title{font-size:7pt;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#0f1f4b;margin:5px 0 3px;border-bottom:1px solid #dde3f0;padding-bottom:2px;}
    .rc-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:8pt;}
    .rc-table thead tr{background:#0f1f4b;}
    .rc-table th{color:#fff;font-weight:700;padding:5px 3px;font-size:7pt;text-transform:uppercase;text-align:center;border:0.5px solid rgba(255,255,255,0.2);overflow:hidden;white-space:normal;word-break:break-word;}
    .rc-table th:first-child{text-align:left;padding-left:7px;}
    .rc-table td{padding:3px 3px;border:0.5px solid #e2e8f0;text-align:center;overflow:hidden;white-space:normal;word-break:break-word;}
