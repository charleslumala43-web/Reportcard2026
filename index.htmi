    .pr2-table td.pr2-subj,.pr2-table td.prc-subject{font-weight:700;color:#0f1f4b;}
    .pr2-table td.pr2-remark,.pr2-table td.prc-remark{font-style:italic;color:#555;}
    .pr2-table td.pr2-teacher,.pr2-table td.prc-teacher{font-style:italic;color:#777;font-size:7.6pt;}
