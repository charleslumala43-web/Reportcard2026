/* ════════ TEACHER LOGIN ════════ */
async function teacherLogin(){
  const username=document.getElementById('teacherUsername').value.trim().toLowerCase();
  const pw=document.getElementById('teacherLoginPw').value;
  if(!username||!pw){showAlert('teacherLoginAlert','Please enter username and password.','error');return;}
  const teacher=await idbGet('teachers',username);
  if(!teacher){showAlert('teacherLoginAlert','Incorrect username or password. Ask admin for your login details.','error');return;}
  // Support both hashed (new) and plain (legacy migration)
  let ok=false;
  if(teacher.pwHash) ok=(await hashPw(pw))===teacher.pwHash;
  else if(teacher.password) ok=pw===teacher.password;
  if(!ok){showAlert('teacherLoginAlert','Incorrect username or password.','error');return;}
  // Migrate plain password to hash
  if(teacher.password&&!teacher.pwHash){
    teacher.pwHash=await hashPw(teacher.password);
    delete teacher.password;
    await idbPut('teachers',teacher);
  }
  saveSession({role:'teacher',username:teacher.username});
  await openTeacherDashboard(teacher);
}

/* Renders the teacher dashboard. Called after password login, or automatically
   on page load when a valid teacher session was saved (see restoreSession). */
async function openTeacherDashboard(teacher){
  currentTeacherObj=teacher;
  // Load academic year from school info
  const info=await idbGet('school','info')||{};
  currentYear=info.academicYear||String(new Date().getFullYear());
  document.getElementById('teacherWelcome').textContent=`Welcome, ${teacher.name}`;
  document.getElementById('teacherSubjectsList').textContent=`Your subjects: ${teacher.subjects&&teacher.subjects.length?teacher.subjects.join(', '):'All subjects'} · Your classes: ${teacher.classes&&teacher.classes.length?teacher.classes.join(', '):'All classes'}`;
  // Load classes dynamically — restricted to this teacher's assigned classes, if any were set
  const allClasses=await getClasses();
  const classes=teacher.classes&&teacher.classes.length?teacher.classes.filter(c=>allClasses.includes(c)):allClasses;
  const classEl=document.getElementById('classSelect');
  classEl.innerHTML=classes.length?classes.map(c=>`<option value="${c}">${c}</option>`).join(''):'<option value="">No classes assigned — contact admin</option>';
  await onTeacherClassChange();
  switchPage('teacher-dashboard');
  renderCircularReadList('teacherCircularList');
  renderTeacherMessages();
}

// Re-populates the Subject dropdown to match whatever class is selected: the fixed
// tier subject list for primary/lower-primary/nursery classes, or the teacher's full
// subject list for secondary classes — since primary subjects aren't a free choice.
async function onTeacherClassChange(){
  const teacher=currentTeacherObj;
  if(!teacher)return;
  const cls=document.getElementById('classSelect').value;
  const sel=document.getElementById('teacherSubjectSelect');
  if(!cls){sel.innerHTML='<option value="">—</option>';return;}
  const classSubjects=await getClassSubjects(cls);
  let subjects=(teacher.subjects&&teacher.subjects.length)?classSubjects.filter(s=>teacher.subjects.includes(s)):classSubjects;
  if(!subjects.length)subjects=classSubjects; // teacher's assigned subjects don't overlap this class — show the class's subjects anyway rather than an empty dropdown
  sel.innerHTML=subjects.map(s=>`<option value="${s}">${s}</option>`).join('');
}

async function openMarksheet(){
  if(!currentTeacherObj){switchPage('teacher-gate');return;}
  try{
    currentSubject=document.getElementById('teacherSubjectSelect').value;
    currentClass=document.getElementById('classSelect').value;
    if(!currentClass){alert('You have no classes assigned yet. Please contact the admin.');return;}
    currentClassLevel=await getClassLevel(currentClass);
    // currentTerm set by pill
    document.getElementById('sheetTitle').textContent=`${currentSubject} — ${currentClass} — Term ${currentTerm} (${currentYear})`;
    document.getElementById('teacherInfo').textContent=`Teacher: ${currentTeacherObj.name} · Logged in as: ${currentTeacherObj.username}`;
    document.getElementById('lastSavedLabel').textContent='';
    marksUnsaved=false;
    document.getElementById('secondaryMarksheetInfo').style.display=isPrimaryTier(currentClassLevel)?'none':'block';
    document.getElementById('primaryMarksheetInfo').style.display=isPrimaryTier(currentClassLevel)?'block':'none';
    if(isPrimaryTier(currentClassLevel)){
      renderPrimaryTableHead();
      await renderPrimaryClassSheet();
    }else{
      renderSecondaryTableHead();
      await renderClassSheet();
    }
    switchPage('teacher-sheet');
  }catch(err){
    console.error('openMarksheet failed:',err);
    alert('⚠️ Could not open the marksheet.\n\nError: '+err.message+'\n\nPlease screenshot this and report it — the marksheet table could not be built.');
  }
}

